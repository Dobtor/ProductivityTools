# =========================
# 1. 前端開發與編譯暫存 (Node.js / TS)
# =========================
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ☠️ 例外：engine=ts 的 node CLI 產物**必須進版控**。
#    2026-10-09 之前它被上面的 `dist/` 排除，所以 engine=ts 在任何部署上都
#    找不到 CLI、只會記 warning 回 None——那條通道從頭到尾沒真的運作過。
#    部署端沒有 npm（容器只有 node），不可能在機器上 build，所以產物進 git
#    是唯一可行的做法。見 ADR-032。
# 放行目錄本身 → 再忽略裡面所有東西 → 只放行那一支。
# 少了中間那行 `tools/dist/*`，整個目錄都會被放行，VR 的 1.2MB 產物就會變成
# untracked 跑出來（2026-10-09 第一版就是這樣）。
!tools/dist/
tools/dist/*
!tools/dist/parse_docx_cli.cjs

# CI 輸出（Sprint 20 補入）
tests/vitest-junit.xml
tests/fixtures/sprint18_ratio_grid_report.json
test-results/

# VR run 暫存（Sprint 158 補入）
tests/fixtures/.visual_regression_tmp/
tests/fixtures/**/golden/*_diff.png

# Autopilot Y 本機設定（Sprint 158 補入；per-machine、不進 git）
.antigravity/

# =========================
# 2. Python 暫存
# =========================
__pycache__/
*.py[cod]

# =========================
# 3. 資安（絕對不可進版控）
# =========================
*.pem
*.key
.env
