{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "static/src/core"
  },
  "include": [
    "static/src/core/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "static/src/lib"
  ]
}
