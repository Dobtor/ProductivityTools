<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- note.signature Record Rules                                   -->
        <!-- ============================================================ -->

        <!-- User: own notes only -->
        <record id="note_signature_rule_user" model="ir.rule">
            <field name="name">note.signature: user own notes</field>
            <field name="model_id" ref="model_note_signature"/>
            <field name="domain_force">[('note_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Portal: own signature only (read) -->
        <record id="note_signature_rule_portal" model="ir.rule">
            <field name="name">note.signature: portal own signature</field>
            <field name="model_id" ref="model_note_signature"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager: all -->
        <record id="note_signature_rule_manager" model="ir.rule">
            <field name="name">note.signature: manager all</field>
            <field name="model_id" ref="model_note_signature"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dobtor_mail_activity.group_activity_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- note.recording Record Rules                                   -->
        <!-- ============================================================ -->

