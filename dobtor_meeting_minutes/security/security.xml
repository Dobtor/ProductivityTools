            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- note.transcript.segment Record Rules                          -->
        <!-- ============================================================ -->

        <!-- User: own notes only -->
        <record id="note_transcript_segment_rule_user" model="ir.rule">
