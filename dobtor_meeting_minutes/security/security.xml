            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager: all -->
        <record id="note_transcribe_log_rule_manager" model="ir.rule">
            <field name="name">note.transcribe.log: manager all</field>
            <field name="model_id" ref="model_note_transcribe_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dobtor_mail_activity.group_activity_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- note.summary.log Record Rules                                 -->
        <!-- ============================================================ -->
        <record id="note_summary_log_rule_user" model="ir.rule">
            <field name="name">note.summary.log: user own notes</field>
