<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="chatbot_meeting_summary" model="ai.chatbot">
            <field name="name">Meeting Summary Assistant</field>
            <field name="technical_name">meeting_summary</field>
            <field name="agent_prompt">你是專業的會議記錄助理。根據使用者提供的會議逐字稿，產生結構化的會議摘要。使用繁體中文回覆，輸出為 HTML 格式。</field>
            <field name="temperature">0.3</field>
            <field name="max_tokens">4096</field>
            <field name="is_public" eval="False"/>
            <field name="strict_mode" eval="False"/>
        </record>

    </data>
</odoo>
