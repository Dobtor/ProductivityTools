<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- note.signature List View                                      -->
    <!-- 簽名記錄清單視圖                                               -->
    <!-- ============================================================ -->
    <record id="view_note_signature_list" model="ir.ui.view">
        <field name="name">note.signature.list</field>
        <field name="model">note.signature</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="note_id" string="Meeting Minutes"/>
                <field name="partner_id" string="Signer"/>
                <field name="is_signed" string="Signed" widget="boolean_toggle" readonly="1"/>
                <field name="signed_by" string="Signed By"/>
                <field name="signed_on" string="Signed On"/>
                <field name="signature" string="Signature" widget="image" options="{'size': [100, 50]}"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- note.signature Form View                                      -->
    <!-- 簽名記錄表單視圖                                               -->
    <!-- ============================================================ -->
    <record id="view_note_signature_form" model="ir.ui.view">
        <field name="name">note.signature.form</field>
        <field name="model">note.signature</field>
        <field name="arch" type="xml">
            <form string="Signature" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="note_id" string="Meeting Minutes" readonly="1"/>
                            <field name="partner_id" string="Signer" readonly="1"/>
                        </group>
                        <group>
                            <field name="is_signed" string="Signed" readonly="1"/>
                            <field name="signed_by" string="Signed By" readonly="1"/>
                            <field name="signed_on" string="Signed On" readonly="1"/>
                        </group>
                    </group>
                    <group string="Signature" invisible="not is_signed">
                        <field name="signature" widget="image" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- note.signature Search View                                    -->
    <!-- 簽名記錄搜尋視圖                                               -->
    <!-- ============================================================ -->
    <record id="view_note_signature_search" model="ir.ui.view">
        <field name="name">note.signature.search</field>
        <field name="model">note.signature</field>
        <field name="arch" type="xml">
            <search string="Search Signatures">
                <field name="note_id" string="Meeting Minutes"/>
                <field name="partner_id" string="Signer"/>

                <separator/>
                <filter string="Signed" name="signed"
                        domain="[('is_signed', '=', True)]"/>
                <filter string="Pending" name="pending"
                        domain="[('is_signed', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter string="Meeting Minutes" name="group_note"
                            context="{'group_by': 'note_id'}"/>
                    <filter string="Signer" name="group_signer"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
