<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- note.recording List View                                      -->
    <!-- 錄音清單視圖                                                   -->
    <!-- ============================================================ -->
    <record id="view_note_recording_list" model="ir.ui.view">
        <field name="name">note.recording.list</field>
        <field name="model">note.recording</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Name"/>
                <field name="record_start" string="Start Time"/>
                <field name="duration" string="Duration (s)" widget="float_time"/>
                <field name="file_format" string="Format" optional="hide"/>
                <field name="file_size" string="Size" optional="hide"/>
                <field name="state" string="Status" widget="badge"
                       decoration-info="state == 'uploaded'"
                       decoration-warning="state == 'processing'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- note.recording Form View                                      -->
    <!-- 錄音表單視圖                                                   -->
    <!-- ============================================================ -->
    <record id="view_note_recording_form" model="ir.ui.view">
        <field name="name">note.recording.form</field>
        <field name="model">note.recording</field>
        <field name="arch" type="xml">
            <form string="Recording">
                <header>
                    <button name="action_transcribe" type="object"
                            string="Start Transcription" class="btn-primary"
                            icon="fa-language"
                            invisible="state != 'uploaded'"/>
                    <button name="action_retry_transcribe" type="object"
                            string="Retry" class="btn-warning"
                            icon="fa-refresh"
                            invisible="state != 'error' or not can_retry"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="uploaded,processing,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object"
                                class="oe_stat_button" icon="fa-history"
                                invisible="log_count == 0">
                            <field name="log_count" widget="statinfo" string="Logs"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="note_id"/>
                            <field name="record_start"/>
                            <field name="record_end"/>
                        </group>
                        <group>
                            <field name="duration" widget="float_time"/>
                            <field name="file_format"/>
                            <field name="file_size"/>
                            <field name="attachment_id"/>
                        </group>
                    </group>
                    <group string="Worker Info" invisible="state != 'processing'">
                        <group>
                            <field name="worker_pid" readonly="1"/>
                            <field name="worker_started_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="can_retry" invisible="1"/>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'error' or not error_message">
                        <i class="fa fa-exclamation-triangle me-2" title="Error"/>
                        <strong>Last error:</strong>
                        <field name="error_message" readonly="1" nolabel="1"
                               class="d-inline ms-2 text-pre-wrap"/>
                    </div>
                    <notebook>
                        <page string="Transcription History" name="history"
                              invisible="log_count == 0">
                            <field name="log_ids" readonly="1" nolabel="1">
                                <list create="false" delete="false">
                                    <field name="create_date" string="When"/>
                                    <field name="attempt_no" string="#"/>
                                    <field name="provider"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'success'"
                                           decoration-warning="state in ('timeout','network_error','stale_worker','upload_failed')"
                                           decoration-danger="state in ('config_error','http_error','quota_exceeded','parse_error','internal_error')"/>
                                    <field name="http_status" optional="show"/>
                                    <field name="request_latency_ms" string="Latency (ms)" optional="hide"/>
                                    <field name="retriable" optional="hide"/>
                                    <field name="error_message" optional="show"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="create_date"/>
                                                <field name="provider"/>
                                                <field name="attempt_no"/>
                                                <field name="state"/>
                                                <field name="retriable"/>
                                            </group>
                                            <group>
                                                <field name="http_status"/>
                                                <field name="http_url"/>
                                                <field name="request_latency_ms"/>
                                                <field name="audio_bytes"/>
                                                <field name="audio_duration"/>
                                            </group>
                                        </group>
                                        <group string="Error Message">
                                            <field name="error_message" nolabel="1" readonly="1"/>
                                        </group>
                                        <group string="Response Body (masked)" invisible="not response_snippet">
                                            <field name="response_snippet" nolabel="1" readonly="1"
                                                   widget="text"/>
                                        </group>
                                        <group string="Traceback" invisible="not traceback">
                                            <field name="traceback" nolabel="1" readonly="1"
                                                   widget="text"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- note.transcript.segment List View                             -->
    <!-- 逐字稿段落清單視圖                                             -->
    <!-- ============================================================ -->
    <record id="view_note_transcript_segment_list" model="ir.ui.view">
        <field name="name">note.transcript.segment.list</field>
        <field name="model">note.transcript.segment</field>
        <field name="arch" type="xml">
            <list>
                <field name="time_start" string="Start" widget="float_time"/>
                <field name="time_end" string="End" widget="float_time"/>
                <field name="speaker_label" string="Speaker ID"/>
                <field name="speaker_name" string="Speaker"/>
                <field name="text" string="Content"/>
                <field name="confidence" string="Confidence" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- note.speaker.mapping List View                                -->
    <!-- 說話者對應清單視圖                                             -->
    <!-- ============================================================ -->
    <record id="view_note_speaker_mapping_list" model="ir.ui.view">
        <field name="name">note.speaker.mapping.list</field>
        <field name="model">note.speaker.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="speaker_label" string="Speaker ID" readonly="1"/>
                <field name="partner_id" string="Contact"/>
                <field name="display_name_override" string="Display Name"/>
            </list>
        </field>
    </record>

</odoo>
