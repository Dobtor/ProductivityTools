<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_note_summary_template_list" model="ir.ui.view">
        <field name="name">note.summary.template.list</field>
        <field name="model">note.summary.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description" optional="show"/>
                <field name="is_system" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_note_summary_template_form" model="ir.ui.view">
        <field name="name">note.summary.template.form</field>
        <field name="model">note.summary.template</field>
        <field name="arch" type="xml">
            <form string="Summary Template">
                <sheet>
                    <widget name="web_ribbon" title="System" bg_color="text-bg-info"
                            invisible="not is_system"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Technical Review Summary"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="unique_code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="is_system" readonly="1"/>
                        </group>
                        <group>
                            <field name="description" placeholder="One-line description shown in listings."/>
                        </group>
                    </group>
                    <separator string="Prompt"/>
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle me-1"/>
                        Use <code>{transcript}</code> placeholder — it will be replaced with the meeting transcript at runtime.
                    </div>
                    <field name="prompt" widget="text" options="{'rows': 20}"
                           placeholder="你是專業的會議記錄助理..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_note_summary_template_search" model="ir.ui.view">
        <field name="name">note.summary.template.search</field>
        <field name="model">note.summary.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_active" string="Active" domain="[('active','=',True)]"/>
                <filter name="filter_system" string="System" domain="[('is_system','=',True)]"/>
                <filter name="filter_custom" string="Custom" domain="[('is_system','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_note_summary_template" model="ir.actions.act_window">
        <field name="name">Summary Templates</field>
        <field name="res_model">note.summary.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_note_summary_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create meeting summary templates</p>
            <p>Templates define the prompt sent to the AI for summary generation.</p>
        </field>
    </record>

</odoo>
