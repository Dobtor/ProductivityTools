<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- note.note Form View - Meeting Minutes Extensions              -->
    <!-- 繼承筆記表單，加入會議記錄功能                                   -->
    <!-- ============================================================ -->
    <record id="view_note_note_form_meeting" model="ir.ui.view">
        <field name="name">note.note.form.meeting</field>
        <field name="model">note.note</field>
        <field name="inherit_id" ref="dobtor_mail_activity.view_note_note_form"/>
        <field name="arch" type="xml">

            <!-- ===== Header: 會議記錄模式隱藏筆記 stage statusbar ===== -->
            <xpath expr="//header/field[@name='stage_id']" position="attributes">
                <attribute name="invisible">note_type == 'meeting'</attribute>
            </xpath>

            <!-- ===== Header: 會議記錄按鈕 ===== -->
            <xpath expr="//header" position="inside">
                <button name="action_send_for_signature" type="object"
                        string="Send for Signature" class="btn-primary"
                        icon="fa-paper-plane"
                        invisible="note_type != 'meeting' or state != 'draft' or calendar_event_count == 0"/>
                <button name="action_preview_portal" type="object"
                        string="Preview in Portal" class="btn-secondary"
                        icon="fa-eye"
                        invisible="note_type != 'meeting' or calendar_event_count == 0"/>
                <button name="action_reset_to_draft" type="object"
                        string="Reset to Draft" class="btn-secondary"
                        invisible="note_type != 'meeting' or state == 'draft'"
                        confirm="This will reset the meeting minutes to draft and clear all signatures. Continue?"/>
                <button name="action_add_calendar_event" type="object"
                        string="Schedule Meeting" class="btn-secondary"
                        icon="fa-calendar-plus-o"
                        invisible="note_type != 'meeting'"/>
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,sent,partial,signed"
                       invisible="note_type != 'meeting' or calendar_event_count == 0"/>
            </xpath>

            <!-- ===== Hidden fields for meeting logic ===== -->
            <xpath expr="//field[@name='note_type' and @invisible='1']" position="after">
                <field name="is_locked" invisible="1"/>
                <field name="calendar_event_count" invisible="1"/>
                <field name="signature_count" invisible="1"/>
                <field name="available_signer_ids" invisible="1"/>
                <field name="recording_count" invisible="1"/>
                <field name="transcript_state" invisible="1"/>
                <field name="last_transcript_error" invisible="1"/>
            </xpath>

            <!-- ===== Ribbons ===== -->
            <xpath expr="//widget[@name='web_ribbon']" position="after">
                <widget name="web_ribbon" title="Fully Signed" bg_color="text-bg-success"
                        invisible="state != 'signed' or calendar_event_count == 0"/>
                <widget name="web_ribbon" title="Locked" bg_color="text-bg-warning"
                        invisible="not is_locked or state == 'signed' or calendar_event_count == 0"/>
            </xpath>

            <!-- ===== Button Box: Calendar Events + Signatures stat buttons ===== -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_calendar_events" type="object"
                        class="oe_stat_button" icon="fa-calendar"
                        invisible="calendar_event_count == 0">
                    <field name="calendar_event_count" widget="statinfo" string="Events"/>
                </button>
                <button name="action_view_signatures" type="object"
                        class="oe_stat_button" icon="fa-pencil"
                        invisible="note_type != 'meeting' or signature_count == 0 or calendar_event_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="signed_count" nolabel="1"/>/<field name="signature_count" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">Signatures</span>
                    </div>
                </button>
                <button name="action_transcribe_all" type="object"
                        class="oe_stat_button" icon="fa-microphone"
                        invisible="note_type != 'meeting' or recording_count == 0">
                    <field name="recording_count" widget="statinfo" string="Recordings"/>
                </button>
            </xpath>

            <!-- ===== Locked alert ===== -->
            <xpath expr="//notebook" position="before">
                <div class="alert alert-warning" role="alert"
                     invisible="not is_locked or calendar_event_count == 0">
                    <i class="fa fa-lock me-2" title="Locked"/>
                    <strong>This meeting minutes is locked.</strong>
                    Content cannot be modified after sending for signature.
                    To make changes, please click "Reset to Draft" (this will clear all existing signatures).
                </div>

                <!-- Signature Settings -->
                <group string="Signature Settings"
                       invisible="note_type != 'meeting' or calendar_event_count == 0">
                    <group colspan="2">
                        <field name="signer_ids" string="Required Signers"
                               widget="many2many_tags"
                               options="{'color_field': 'color'}"
                               domain="[('id', 'in', available_signer_ids)]"
                               readonly="is_locked"
                               help="Select signers from calendar event attendees"/>
                    </group>
                </group>

                <!-- Alert: need to link calendar event first -->
                <div class="alert alert-info" role="alert"
                     invisible="note_type != 'meeting' or calendar_event_count > 0">
                    <i class="fa fa-info-circle me-2" title="Information"/>
                    <strong>Link a calendar event to enable meeting minutes features.</strong>
                    Use the "Calendar Events" tab below to link an existing event or schedule a new meeting.
                    The meeting attendees will become available as signers.
                </div>
            </xpath>

            <!-- ===== Make Content readonly when locked ===== -->
            <xpath expr="//page[@name='content']//field[@name='memo']" position="attributes">
                <attribute name="readonly">is_locked and note_type == 'meeting'</attribute>
            </xpath>

            <!-- ===== Notebook: Recordings page ===== -->
            <xpath expr="//page[@name='content']" position="after">
                <page string="Recordings" name="recordings"
                      invisible="note_type != 'meeting'">
                    <div class="mb-3">
                        <div class="alert alert-info d-flex align-items-center" role="alert"
                             invisible="recording_count > 0">
                            <i class="fa fa-microphone fa-2x me-3" title="Recording"/>
                            <div>
                                Use the recording button below to record meeting audio directly from your browser.
                                After uploading, click "Start Transcription" to convert speech to text.
                            </div>
                        </div>
                    </div>
                    <!-- Recorder Widget -->
                    <field name="recording_count" widget="meeting_recorder_widget"
                           nolabel="1" class="mb-3"/>
                    <field name="recording_ids">
                        <list create="false" editable="bottom">
                            <field name="name" string="Name" readonly="1"/>
                            <field name="duration" string="Duration (s)" readonly="1"/>
                            <field name="audio_url" string="Play" widget="audio_player"
                                   readonly="1"/>
                            <field name="file_format" string="Format" readonly="1" optional="hide"/>
                            <field name="state" string="Status" widget="badge"
                                   decoration-info="state == 'uploaded'"
                                   decoration-warning="state == 'processing'"
                                   decoration-success="state == 'done'"
                                   decoration-danger="state == 'error'"
                                   readonly="1"/>
                            <field name="error_message" string="Error Detail"
                                   readonly="1" optional="show"
                                   decoration-danger="state == 'error'"/>
                            <field name="can_retry" column_invisible="1"/>
                            <button name="action_transcribe" type="object"
                                    string="Transcribe" icon="fa-language"
                                    invisible="state != 'uploaded'"/>
                            <button name="action_retry_transcribe" type="object"
                                    string="Retry" icon="fa-refresh" class="btn-warning"
                                    invisible="state != 'error' or not can_retry"/>
                            <button name="action_view_logs" type="object"
                                    string="History" icon="fa-history"
                                    invisible="state not in ('done', 'error')"/>
                        </list>
                    </field>
                </page>

                <!-- Transcript page -->
                <page string="Transcript" name="transcript"
                      invisible="note_type != 'meeting' or transcript_state == 'none'">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="badge text-bg-warning"
                                  invisible="transcript_state != 'processing'">
                                <i class="fa fa-spinner fa-spin me-1"/>Processing...
                            </span>
                            <span class="badge text-bg-success"
                                  invisible="transcript_state != 'done'">
                                <i class="fa fa-check me-1"/>Transcription Complete
                            </span>
                            <span class="badge text-bg-warning"
                                  invisible="transcript_state != 'partial'">
                                <i class="fa fa-exclamation-circle me-1"/>Partially Done
                            </span>
                            <span class="badge text-bg-danger"
                                  invisible="transcript_state != 'error'">
                                <i class="fa fa-exclamation-triangle me-1"/>Error
                            </span>
                        </div>
                        <div class="d-flex gap-2">
                            <button name="action_export_transcript_txt" type="object"
                                    string="Export TXT" class="btn-outline-secondary btn-sm"
                                    icon="fa-file-text-o"
                                    invisible="transcript_state not in ('done', 'partial')"/>
                            <button name="action_export_transcript_srt" type="object"
                                    string="Export SRT" class="btn-outline-secondary btn-sm"
                                    icon="fa-file-video-o"
                                    invisible="transcript_state not in ('done', 'partial')"/>
                            <button name="action_transcribe_all" type="object"
                                    string="Re-transcribe" class="btn-secondary btn-sm"
                                    icon="fa-refresh"
                                    invisible="transcript_state not in ('done', 'partial', 'error')"/>
                        </div>
                    </div>

                    <!-- Error detail banner -->
                    <div class="alert alert-danger" role="alert"
                         invisible="transcript_state not in ('error', 'partial') or not last_transcript_error">
                        <i class="fa fa-exclamation-triangle me-2" title="Error"/>
                        <strong>Latest error:</strong>
                        <field name="last_transcript_error" nolabel="1" readonly="1"
                               class="d-inline ms-2 text-pre-wrap"/>
                        <div class="text-muted small mt-1">
                            See the Recordings tab for per-recording details and retry options.
                        </div>
                    </div>

                    <!-- Speaker Mapping -->
                    <group string="Speaker Mapping"
                           invisible="not speaker_mapping_ids">
                        <field name="speaker_mapping_ids" nolabel="1">
                            <list editable="bottom" create="false" delete="false">
                                <field name="speaker_label" string="Speaker ID" readonly="1"/>
                                <field name="partner_id" string="Contact"
                                       domain="[('id', 'in', parent.available_signer_ids)]"/>
                                <field name="display_name_override" string="Display Name"/>
                            </list>
                        </field>
                    </group>

                    <!-- Formatted transcript -->
                    <field name="transcript_html" readonly="1"
                           invisible="not transcript_html"/>

                    <!-- Segment details (inline editable) -->
                    <group string="Segment Details" invisible="not transcript_ids">
                        <field name="transcript_ids" nolabel="1">
                            <list create="false" delete="false" editable="bottom">
                                <field name="time_start" string="Start" widget="float_time" readonly="1"/>
                                <field name="speaker_name" string="Speaker" readonly="1"/>
                                <field name="text" string="Content"/>
                                <field name="confidence" string="Confidence" optional="hide" readonly="1"/>
                            </list>
                        </field>
                    </group>
                </page>

                <!-- Signatures page -->
                <page string="Signatures" name="signatures"
                      invisible="note_type != 'meeting' or signature_count == 0 or calendar_event_count == 0">
                    <field name="signature_ids">
                        <list create="false" delete="false" editable="bottom">
                            <field name="partner_id" string="Signer"/>
                            <field name="is_signed" string="Signed" widget="boolean_toggle" readonly="1"/>
                            <field name="signed_by" string="Signed By"/>
                            <field name="signed_on" string="Signed On"/>
                            <field name="signature" string="Signature" widget="image" options="{'size': [100, 50]}"/>
                        </list>
                    </field>
                </page>

                <!-- Calendar Events page -->
                <page string="Calendar Events" name="calendar_events"
                      invisible="note_type != 'meeting'">
                    <group>
                        <group>
                            <button name="action_add_calendar_event" type="object"
                                    string="Schedule Meeting" class="btn-secondary"
                                    icon="fa-calendar-plus-o" colspan="2"/>
                        </group>
                    </group>
                    <field name="calendar_event_ids">
                        <list>
                            <field name="name" string="Meeting"/>
                            <field name="start" string="Start"/>
                            <field name="stop" string="End"/>
                            <field name="location" string="Location" optional="show"/>
                            <field name="user_id" string="Organizer" widget="many2one_avatar_user"/>
                            <field name="partner_ids" string="Attendees" widget="many2many_tags"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- note.note List View - Add state column for meeting minutes    -->
    <!-- ============================================================ -->
    <record id="view_note_note_list_meeting" model="ir.ui.view">
        <field name="name">note.note.list.meeting</field>
        <field name="model">note.note</field>
        <field name="inherit_id" ref="dobtor_mail_activity.view_note_note_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="state" string="Status" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('sent', 'partial')"
                       decoration-success="state == 'signed'"
                       column_invisible="context.get('hide_state')"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Action - Meeting Minutes                                      -->
    <!-- ============================================================ -->
    <record id="action_meeting_minutes" model="ir.actions.act_window">
        <field name="name">Meeting Minutes</field>
        <field name="res_model">note.note</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('note_type', '=', 'meeting')]</field>
        <field name="context">{'search_default_open_true': 1, 'default_note_type': 'meeting', 'hide_stage': True}</field>
        <field name="search_view_id" ref="dobtor_mail_activity.view_note_note_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first meeting minutes</p>
            <p>Record meeting discussions, decisions, and action items.</p>
        </field>
    </record>

</odoo>
