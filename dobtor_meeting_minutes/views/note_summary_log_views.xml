<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_note_summary_log_list" model="ir.ui.view">
        <field name="name">note.summary.log.list</field>
        <field name="model">note.summary.log</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc"
                  decoration-success="state == 'success'"
                  decoration-warning="state in ('chatbot_error','empty_response','stale_worker')"
                  decoration-danger="state in ('config_error','parse_error','internal_error')">
                <field name="create_date" string="When"/>
                <field name="note_id"/>
                <field name="chatbot_id" optional="show"/>
                <field name="template_id" optional="hide"/>
                <field name="attempt_no" string="#"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-warning="state in ('chatbot_error','empty_response','stale_worker')"
                       decoration-danger="state in ('config_error','parse_error','internal_error')"/>
                <field name="prompt_length" string="Prompt" optional="hide"/>
                <field name="response_length" string="Resp" optional="hide"/>
                <field name="request_latency_ms" string="Latency (ms)" optional="show"/>
                <field name="retriable" optional="show"/>
                <field name="error_message" optional="show"/>
                <button name="action_retry" type="object"
                        string="Retry" icon="fa-refresh" class="btn-link"
                        invisible="not retriable"/>
                <button name="action_open_note" type="object"
                        string="Open" icon="fa-external-link" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_note_summary_log_form" model="ir.ui.view">
        <field name="name">note.summary.log.form</field>
        <field name="model">note.summary.log</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_retry" type="object"
                            string="Retry Summary" class="btn-warning"
                            icon="fa-refresh"
                            invisible="not retriable"/>
                    <button name="action_open_note" type="object"
                            string="Open Meeting" class="btn-secondary"
                            icon="fa-external-link"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="note_id" readonly="1"/>
                            <field name="chatbot_id" readonly="1"/>
                            <field name="template_id" readonly="1"/>
                            <field name="attempt_no" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="retriable" readonly="1"/>
                        </group>
                        <group>
                            <field name="request_latency_ms" readonly="1"/>
                            <field name="prompt_length" readonly="1"/>
                            <field name="transcript_length" readonly="1"/>
                            <field name="response_length" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="ended_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Error Message" invisible="not error_message">
                        <field name="error_message" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Traceback" invisible="not traceback">
                        <field name="traceback" nolabel="1" readonly="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_note_summary_log_search" model="ir.ui.view">
        <field name="name">note.summary.log.search</field>
        <field name="model">note.summary.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="note_id"/>
                <field name="error_message"/>
                <filter name="filter_failed" string="Failures" domain="[('state','!=','success')]"/>
                <filter name="filter_success" string="Successes" domain="[('state','=','success')]"/>
                <filter name="filter_retriable" string="Retriable" domain="[('retriable','=',True)]"/>
                <separator/>
                <filter name="filter_week" string="Last 7 Days"
                        domain="[('create_date','&gt;=',(context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Result" context="{'group_by': 'state'}"/>
                    <filter name="group_note" string="Meeting" context="{'group_by': 'note_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_note_summary_log_pivot" model="ir.ui.view">
        <field name="name">note.summary.log.pivot</field>
        <field name="model">note.summary.log</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="create_date" interval="day" type="row"/>
                <field name="state" type="col"/>
                <field name="id" type="measure" string="Count"/>
                <field name="request_latency_ms" type="measure"/>
                <field name="response_length" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_note_summary_log" model="ir.actions.act_window">
        <field name="name">Summary Logs</field>
        <field name="res_model">note.summary.log</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="view_note_summary_log_search"/>
        <field name="context">{'search_default_filter_failed': 1, 'search_default_filter_week': 1}</field>
    </record>

</odoo>
