<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- note.stage List View                                          -->
    <!-- 階段清單視圖，支援行內編輯                                      -->
    <!-- ============================================================ -->
    <record id="view_note_stage_list" model="ir.ui.view">
        <field name="name">note.stage.list</field>
        <field name="model">note.stage</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Stage Name"/>
                <field name="user_id" string="Owner" widget="many2one_avatar_user"/>
                <field name="fold" string="Folded by Default" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- note.stage Form View                                          -->
    <!-- 階段表單視圖                                                   -->
    <!-- ============================================================ -->
    <record id="view_note_stage_form" model="ir.ui.view">
        <field name="name">note.stage.form</field>
        <field name="model">note.stage</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="Note Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Stage Name"/>
                            <field name="sequence" string="Sequence"/>
                        </group>
                        <group>
                            <field name="user_id" string="Owner" widget="many2one_avatar_user"/>
                            <field name="fold" string="Folded by Default" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Actions                                                       -->
    <!-- ============================================================ -->

    <!-- Action - 筆記階段 -->
    <record id="action_note_stage" model="ir.actions.act_window">
        <field name="name">Note Stages</field>
        <field name="res_model">note.stage</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'default_user_id': uid}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first stage</p>
            <p>Use stages to organize your notes, e.g.: Pending, In Progress, Completed.</p>
        </field>
    </record>

    <record model="ir.actions.act_window.view" id="action_note_stage_list">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_note_stage_list"/>
        <field name="act_window_id" ref="action_note_stage"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_note_stage_form">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_note_stage_form"/>
        <field name="act_window_id" ref="action_note_stage"/>
    </record>

</odoo>
