<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- calendar.event Calendar View Extension                        -->
    <!-- 日曆視圖擴展 - 增加 note_count 欄位供 popover 使用              -->
    <!-- ============================================================ -->
    <record id="view_calendar_event_calendar_inherit" model="ir.ui.view">
        <field name="name">calendar.event.calendar.inherit.meeting_minutes</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_calendar"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_organizer_alone']" position="after">
                <field name="note_count" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- calendar.event Form View Extension                            -->
    <!-- 日曆事件表單視圖擴展 - 增加會議記錄功能                         -->
    <!-- ============================================================ -->
    <record id="view_calendar_event_form_inherit" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.meeting_minutes</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <!-- 在 header 增加新增會議記錄按鈕 -->
            <xpath expr="//form/div[hasclass('alert', 'alert-info', 'oe_edit_only')]" position="before">
                <header>
                    <button name="action_create_note"
                            type="object"
                            string="Create Meeting Minutes"
                            class="btn-primary"
                            icon="fa-sticky-note-o"/>
                </header>
            </xpath>

            <!-- 在 button_box 增加會議記錄 smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="note_count" invisible="1"/>
                <button name="action_view_notes"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-sticky-note"
                        invisible="note_count == 0">
                    <field name="note_count" widget="statinfo" string="Meeting Minutes"/>
                </button>
            </xpath>

            <!-- 在 notebook 增加會議記錄頁籤 -->
            <xpath expr="//notebook" position="inside">
                <page string="Meeting Minutes" name="meeting_notes">
                    <field name="note_ids" mode="kanban" nolabel="1">
                        <kanban create="0" class="o_kanban_mobile w-100">
                            <field name="name"/>
                            <field name="memo"/>
                            <field name="stage_id"/>
                            <field name="user_id"/>
                            <field name="color"/>
                            <templates>
                                <t t-name="card" class="flex-row w-100">
                                    <aside>
                                        <field name="color" widget="color_picker"/>
                                    </aside>
                                    <main class="ms-2 w-100 overflow-hidden">
                                        <div class="o_kanban_record_title mb-1">
                                            <field name="name" placeholder="(No Title)"/>
                                        </div>
                                        <div class="o_kanban_record_body text-muted small text-truncate">
                                            <field name="memo" class="text-truncate"/>
                                        </div>
                                        <footer class="pt-2">
                                            <field name="stage_id" widget="badge"/>
                                            <field name="user_id" widget="many2one_avatar_user"/>
                                        </footer>
                                    </main>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- calendar.event Quick Create Form Extension                    -->
    <!-- 快速建立表單擴展                                               -->
    <!-- ============================================================ -->
    <record id="view_calendar_event_form_quick_create_inherit" model="ir.ui.view">
        <field name="name">calendar.event.form.quick_create.inherit.meeting_minutes</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form_quick_create"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="after">
                <field name="note_ids" widget="many2many_tags" placeholder="Link notes..."/>
            </xpath>
        </field>
    </record>

</odoo>
