        <field name="model">mail.activity.merge.wizard</field>
        <field name="inherit_id" ref="dobtor_mail_activity.mail_activity_merge_wizard_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='master_id']" position="after">
                <field name="merged_note_count" string="Notes to Attach"/>
            </xpath>
            <xpath expr="//span[@name='merge_intro']" position="after">
                <span class="ms-1">Their referenced notes are attached to the master, and chips inside those notes start pointing at the master.</span>
            </xpath>
        </field>
    </record>

    <record id="weekly_schedule_config_view_form_note" model="ir.ui.view">
        <field name="name">weekly.schedule.config.note.weekly_schedule_config_view_form_note</field>
        <field name="model">weekly.schedule.config</field>
        <field name="inherit_id" ref="dobtor_mail_activity.weekly_schedule_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='target_model']" position="after">
                <field name="note_id" invisible="target_model != 'note.note'"/>
                <field name="auto_create_note" invisible="target_model != 'note.note'"/>
            </xpath>
        </field>
    </record>

</odoo>
