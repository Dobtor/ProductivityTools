<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 允許將待辦關聯/轉移到 CRM、專案、銷售訂單。 -->
        <!-- partner_field 留空 → mail.activity 自動探測各模型的 partner_id。 -->
        <record id="transfer_config_crm_lead" model="mail.activity.transfer.config">
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="sequence">20</field>
        </record>

        <record id="transfer_config_project_project" model="mail.activity.transfer.config">
            <field name="model_id" ref="project.model_project_project"/>
            <field name="sequence">30</field>
        </record>

        <record id="transfer_config_project_task" model="mail.activity.transfer.config">
            <field name="model_id" ref="project.model_project_task"/>
            <field name="sequence">40</field>
        </record>

        <record id="transfer_config_sale_order" model="mail.activity.transfer.config">
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="sequence">50</field>
        </record>

    </data>
</odoo>
