<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_knowledge_monthly" model="ir.cron">
        <field name="name">知識：每月全量重拍（保底）</field>
        <field name="model_id" ref="dobtor_corpaas_product.model_infrastructure_solution_package"/>
        <field name="state">code</field>
        <field name="code">model._cron_knowledge_monthly()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
    </record>
    <record id="cron_knowledge_image_watch" model="ir.cron">
        <field name="name">知識：偵測母體映像變更</field>
        <field name="model_id" ref="dobtor_corpaas_product.model_infrastructure_solution_package"/>
        <field name="state">code</field>
        <field name="code">model._cron_knowledge_image_watch()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_knowledge_gc" model="ir.cron">
        <field name="name">知識：清理舊修訂與被取代素材</field>
        <field name="model_id" ref="model_corpaas_knowledge_asset"/>
        <field name="state">code</field>
        <field name="code">model._gc_superseded(30)
env['corpaas.knowledge.revision']._gc_keep_last(5)
env['corpaas.knowledge.fingerprint']._gc(30)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_knowledge_help_misses" model="ir.cron">
        <field name="name">知識：找不到答案的問句交給 AI 補同義詞</field>
        <field name="model_id" ref="model_corpaas_knowledge_help_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_feed_misses()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_knowledge_push_help_keys" model="ir.cron">
        <field name="name">知識：下發租戶的說明查詢金鑰</field>
        <field name="model_id" ref="dobtor_infrastructure.model_infrastructure_database"/>
        <field name="state">code</field>
        <field name="code">model._cron_knowledge_push_help_keys()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="cron_knowledge_gap_cluster" model="ir.cron">
        <field name="name">知識：沒有對應功能的問句分群成缺口主題</field>
        <field name="model_id" ref="model_corpaas_knowledge_help_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_cluster_gaps()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
    </record>
    <!-- ★ 新的清理排程用新 xmlid：這個檔是 noupdate，改舊排程的 code 對既有資料庫無效。 -->
    <record id="cron_knowledge_gc_logs" model="ir.cron">
        <field name="name">知識：清理 AI 快取回應、舊查詢紀錄與不處理的缺口</field>
        <field name="model_id" ref="model_corpaas_knowledge_ai_call"/>
        <field name="state">code</field>
        <field name="code">model._gc_cache()
env['corpaas.knowledge.help.log']._gc(180)
env['corpaas.knowledge.gap']._gc(180)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
