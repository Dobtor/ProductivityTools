<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_knowledge" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.knowledge</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="dobtor_infrastructure.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='corpaas_infra']" position="inside">
                <block title="方案知識（說明書／行銷／建議書）" name="knowledge_block">
                    <setting string="說明主機" help="只在這台主機上的方案母體製作素材；方案沒有在這台上架就擋下。">
                        <field name="knowledge_doc_server_id"/>
                    </setting>
                    <setting string="AI Hub" help="content 模式的網址與金鑰（ai.hub.source 的 uplink 金鑰）。">
                        <field name="knowledge_hub_url" placeholder="https://ai.corpaas.com"/>
                        <field name="knowledge_hub_key" password="True"/>
                    </setting>
                    <setting string="AI 預算" help="每次更新的點數上限；超過的工作排到下一次。">
                        <field name="knowledge_budget"/>
                    </setting>
                    <setting string="截圖環境" help="一次性 Playwright 容器的映像與主機上的中文字型目錄（沒掛字型中文會變方框）。">
                        <field name="knowledge_playwright_image"/>
                        <field name="knowledge_fonts_dir"/>
                    </setting>
                    <setting string="門檻" help="dHash 位元差低於門檻不換圖；改名偵測相似度門檻。">
                        <field name="knowledge_phash_threshold"/>
                        <field name="knowledge_rename_threshold"/>
                    </setting>
                    <setting string="官方模組排除清單" help="黃金庫裝的 Odoo 官方模組預設納入知識盤點（只盤選單與選單動作）；列在這裡的不盤。逗號分隔、可用萬用字元；各方案可再追加。">
                        <field name="knowledge_official_exclude"/>
                    </setting>
                    <setting string="說明頁網址前綴" help="help API 回傳的連結前綴。">
                        <field name="knowledge_public_base_url" placeholder="https://www.corpaas.com"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
