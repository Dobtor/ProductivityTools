<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kb_sandbox_list" model="ir.ui.view">
        <field name="name">corpaas.knowledge.sandbox.list</field>
        <field name="model">corpaas.knowledge.sandbox</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state == 'failed'" decoration-muted="state == 'dropped'">
                <field name="db_name"/>
                <field name="package_id"/>
                <field name="scenario_id"/>
                <field name="master_instance_id"/>
                <field name="state"/>
                <field name="ready_at"/>
            </list>
        </field>
    </record>
    <record id="view_kb_sandbox_form" model="ir.ui.view">
        <field name="name">corpaas.knowledge.sandbox.form</field>
        <field name="model">corpaas.knowledge.sandbox</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_rebuild" string="重建說明庫" type="object"
                            confirm="會從黃金庫重新複製並重播示範資料，確定？"
                            groups="dobtor_corpaas_knowledge.group_knowledge_manager"/>
                    <button name="action_drop" string="刪除說明庫" type="object"
                            invisible="state == 'dropped'" confirm="確定刪除？"
                            groups="dobtor_corpaas_knowledge.group_knowledge_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="db_name"/>
                            <field name="package_id"/>
                            <field name="scenario_id"/>
                        </group>
                        <group>
                            <field name="master_instance_id"/>
                            <field name="golden_id"/>
                            <field name="ready_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="錯誤" name="error" invisible="not error">
                            <field name="error"/>
                        </page>
                        <page string="清除報告（D1）" name="purge">
                            <field name="purge_report"/>
                        </page>
                        <page string="示範資料報告" name="seed">
                            <field name="seed_report"/>
                            <field name="role_logins"/>
                        </page>
                        <page string="程式碼清單" name="manifest">
                            <field name="code_manifest"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_kb_sandbox" model="ir.actions.act_window">
        <field name="name">說明庫</field>
        <field name="res_model">corpaas.knowledge.sandbox</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_kb_sandbox" action="action_kb_sandbox" sequence="60"
              parent="menu_knowledge_ops"/>
</odoo>
