<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_solution_package_form_knowledge" model="ir.ui.view">
        <field name="name">infrastructure.solution.package.form.knowledge</field>
        <field name="model">infrastructure.solution.package</field>
        <field name="inherit_id" ref="dobtor_corpaas_product.infrastructure_module_integrations_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="方案知識" name="knowledge"
                      groups="dobtor_corpaas_knowledge.group_knowledge_editor">
                    <div class="alert alert-warning" role="alert" invisible="not knowledge_blocker">
                        <field name="knowledge_blocker"/>
                    </div>
                    <group>
                        <group>
                            <field name="knowledge_enabled"/>
                            <field name="knowledge_last_refresh"/>
                            <field name="knowledge_feature_count"/>
                            <field name="knowledge_event_count"/>
                            <field name="knowledge_coverage_rate"/>
                            <field name="knowledge_pending_count"/>
                            <field name="knowledge_pending_days"/>
                        </group>
                        <group>
                            <button name="action_knowledge_refresh" string="立即全量更新" type="object"
                                    class="btn-primary" invisible="knowledge_blocker"
                                    groups="dobtor_corpaas_knowledge.group_knowledge_manager"/>
                            <button name="action_knowledge_ai_select" string="AI 圈選情境與能力" type="object"
                                    invisible="knowledge_blocker"
                                    groups="dobtor_corpaas_knowledge.group_knowledge_manager"/>
                            <button name="action_knowledge_coverage" string="說明覆蓋率" type="object"/>
                            <button name="action_knowledge_cost_plan" string="估算 AI 成本" type="object"
                                    invisible="knowledge_blocker"/>
                            <button name="action_knowledge_fix_gaps" string="只修缺口" type="object"
                                    invisible="knowledge_blocker or not knowledge_gap_open"
                                    groups="dobtor_corpaas_knowledge.group_knowledge_manager"/>
                            <button name="action_open_knowledge_gaps" type="object" class="btn-link"
                                    string="缺口清單"/>
                            <button name="action_knowledge_save_library" string="存成範本庫" type="object"
                                    groups="dobtor_corpaas_knowledge.group_knowledge_manager"
                                    confirm="把目前上線中的能力、情境、流程存成範本：清除重跑時直接套用，不重新叫 AI 生。要繼續嗎？"/>
                            <field name="knowledge_gap_open"/>
                            <field name="knowledge_gap_human"/>
                            <field name="knowledge_library_at"/>
                            <field name="knowledge_library_note"/>
                        </group>
                    </group>
                    <group string="AI 成本估算（下一次全量更新）" invisible="not knowledge_cost_plan_at">
                        <field name="knowledge_cost_plan_at"/>
                        <field name="knowledge_cost_plan_html" nolabel="1" colspan="2"/>
                    </group>
                    <group string="盤點範圍">
                        <field name="knowledge_include_official"/>
                        <field name="knowledge_document_native"/>
                        <field name="knowledge_official_exclude"
                               invisible="not knowledge_include_official"
                               placeholder="例如 website_*, event"/>
                    </group>
                    <group string="方案設定檔（分析條件與門檻）">
                        <group>
                            <field name="knowledge_reader"/>
                            <field name="knowledge_max_scenarios"/>
                            <label for="knowledge_cap_min" string="能力數範圍"/>
                            <div class="o_row">
                                <field name="knowledge_cap_min" nolabel="1"/> –
                                <field name="knowledge_cap_max" nolabel="1"/>
                            </div>
                        </group>
                        <group>
                            <field name="knowledge_shot_threshold"/>
                            <field name="knowledge_empty_max_pct"/>
                            <field name="knowledge_max_iterations"/>
                        </group>
                    </group>
                    <group string="情境與能力">
                        <field name="knowledge_scenario_ids" widget="many2many_tags"/>
                        <field name="knowledge_capability_ids" widget="many2many_tags"/>
                    </group>
                    <field name="knowledge_sandbox_ids" readonly="1">
                        <list>
                            <field name="db_name"/>
                            <field name="scenario_id"/>
                            <field name="state"/>
                            <field name="last_prep" optional="show"/>
                            <field name="purge_skipped" optional="hide"/>
                            <field name="ready_at"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
