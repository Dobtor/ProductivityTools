<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_kb_run_list" model="ir.ui.view">
        <field name="name">corpaas.knowledge.run.list</field>
        <field name="model">corpaas.knowledge.run</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state == 'failed'" decoration-info="state == 'running'">
                <field name="started_at"/>
                <field name="package_id"/>
                <field name="reason"/>
                <field name="full"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'" decoration-info="state == 'running'"/>
                <field name="stage"/>
                <field name="duration_min"/>
                <field name="ai_cost" sum="AI 成本"/>
                <field name="summary"/>
            </list>
        </field>
    </record>

    <record id="view_kb_run_form" model="ir.ui.view">
        <field name="name">corpaas.knowledge.run.form</field>
        <field name="model">corpaas.knowledge.run</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_resume" string="從失敗的階段重跑" type="object"
                            class="btn-primary" invisible="state != 'failed'"
                            groups="dobtor_corpaas_knowledge.group_knowledge_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="package_id"/>
                            <field name="reason"/>
                            <field name="full"/>
                            <field name="stage"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="ended_at"/>
                            <field name="duration_min"/>
                            <field name="ai_calls"/>
                            <field name="ai_cost"/>
                        </group>
                    </group>
                    <group string="成果">
                        <field name="summary" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="錯誤" name="error" invisible="not error">
                            <field name="error"/>
                        </page>
                        <page string="說明庫" name="sandboxes">
                            <field name="sandbox_ids"/>
                        </page>
                        <page string="階段紀錄" name="log">
                            <field name="log_json" widget="text" class="font-monospace"/>
                        </page>
                        <page string="原始成果" name="stats" groups="base.group_no_one">
                            <field name="stats_json" widget="text" class="font-monospace"/>
                            <field name="token"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kb_run" model="ir.actions.act_window">
        <field name="name">更新執行紀錄</field>
        <field name="res_model">corpaas.knowledge.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_kb_run" name="更新執行紀錄" parent="menu_knowledge_ops"
              action="action_kb_run" sequence="1"/>
</odoo>
