<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 程式知識（計畫第 49–53 項）：系統與 AI 產生，全部唯讀 -->
    <record id="view_kb_module_summary_list" model="ir.ui.view">
        <field name="name">corpaas.knowledge.module_summary.list</field>
        <field name="model">corpaas.knowledge.module_summary</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="module"/>
                <field name="title"/>
                <field name="source" widget="badge" decoration-success="source == 'ai'" decoration-muted="source == 'facts'"/>
                <field name="purpose"/>
                <field name="dir_hash" optional="hide"/>
                <field name="write_date" optional="show" string="更新時間"/>
            </list>
        </field>
    </record>
    <record id="view_kb_module_summary_form" model="ir.ui.view">
        <field name="name">corpaas.knowledge.module_summary.form</field>
        <field name="model">corpaas.knowledge.module_summary</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="title"/></h1><field name="module"/></div>
                    <group>
                        <group>
                            <field name="source"/>
                            <field name="depends_text"/>
                        </group>
                        <group>
                            <field name="dir_hash"/>
                            <field name="write_date" string="更新時間"/>
                        </group>
                    </group>
                    <group string="用途"><field name="purpose" nolabel="1" colspan="2"/></group>
                    <group string="核心規則"><field name="rules_text" nolabel="1" colspan="2"/></group>
                    <group>
                        <group string="串接"><field name="links_text" nolabel="1" colspan="2"/></group>
                        <group string="前置設定"><field name="setup_text" nolabel="1" colspan="2"/></group>
                    </group>
                    <group string="主要模型"><field name="models_text" nolabel="1" colspan="2"/></group>
                    <notebook>
                        <page string="原始資料" name="raw" groups="base.group_no_one">
                            <group>
                                <field name="summary_json"/>
                                <field name="facts_json"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_kb_module_summary_search" model="ir.ui.view">
        <field name="name">corpaas.knowledge.module_summary.search</field>
        <field name="model">corpaas.knowledge.module_summary</field>
        <field name="arch" type="xml">
            <search>
                <field name="module"/>
                <filter name="ai" string="AI 讀過程式" domain="[('source', '=', 'ai')]"/>
                <filter name="facts" string="只有結構事實" domain="[('source', '=', 'facts')]"/>
            </search>
        </field>
    </record>
    <record id="action_kb_module_summary" model="ir.actions.act_window">
        <field name="name">模組摘要</field>
        <field name="res_model">corpaas.knowledge.module_summary</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_kb_code_tree_list" model="ir.ui.view">
        <field name="name">corpaas.knowledge.code_tree.list</field>
        <field name="model">corpaas.knowledge.code_tree</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="odoo_version"/>
                <field name="image_digest"/>
                <field name="match"/>
                <field name="core_path"/>
                <field name="server_id" optional="show"/>
                <field name="last_seen"/>
            </list>
        </field>
    </record>
    <record id="view_kb_code_tree_form" model="ir.ui.view">
        <field name="name">corpaas.knowledge.code_tree.form</field>
        <field name="model">corpaas.knowledge.code_tree</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="odoo_version"/>
                            <field name="image_digest"/>
                            <field name="match"/>
                            <field name="tree_hash"/>
                        </group>
                        <group>
                            <field name="server_id"/>
                            <field name="core_path"/>
                            <field name="core_container_path"/>
                            <field name="core_tried"/>
                            <field name="first_seen"/>
                            <field name="last_seen"/>
                        </group>
                    </group>
                    <group string="與上一版不同的官方模組"><field name="changed_core" nolabel="1" colspan="2"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_kb_code_tree" model="ir.actions.act_window">
        <field name="name">程式碼版本</field>
        <field name="res_model">corpaas.knowledge.code_tree</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_kb_code_fact_list" model="ir.ui.view">
        <field name="name">corpaas.knowledge.code_fact.list</field>
        <field name="model">corpaas.knowledge.code_fact</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="subject"/>
                <field name="state" widget="badge" decoration-success="state == 'current'"
                       decoration-warning="state in ('stale', 'suspect')" decoration-muted="state == 'structural'"/>
                <field name="verified"/>
                <field name="write_date" string="更新時間" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_kb_code_fact_form" model="ir.ui.view">
        <field name="name">corpaas.knowledge.code_fact.form</field>
        <field name="model">corpaas.knowledge.code_fact</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="subject"/></h1></div>
                    <group>
                        <group><field name="state"/><field name="verified"/></group>
                        <group><field name="chain_hash"/></group>
                    </group>
                    <group string="結論"><field name="fact_text" nolabel="1" colspan="2"/></group>
                    <group string="依序的定義（官方原碼在前、各模組覆寫在後）">
                        <field name="def_ids" nolabel="1" colspan="2">
                            <list>
                                <field name="module"/>
                                <field name="path"/>
                                <field name="line_start"/>
                                <field name="line_end"/>
                                <field name="summary_json" string="這一段做什麼"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_kb_code_fact_search" model="ir.ui.view">
        <field name="name">corpaas.knowledge.code_fact.search</field>
        <field name="model">corpaas.knowledge.code_fact</field>
        <field name="arch" type="xml">
            <search>
                <field name="subject"/>
                <filter name="current" string="有效" domain="[('state', '=', 'current')]"/>
                <filter name="todo" string="還沒有結論" domain="[('state', 'in', ('structural', 'stale', 'suspect'))]"/>
            </search>
        </field>
    </record>
    <record id="action_kb_code_fact" model="ir.actions.act_window">
        <field name="name">程式結論</field>
        <field name="res_model">corpaas.knowledge.code_fact</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_kb_module_summary" name="模組摘要" sequence="91"
              parent="menu_knowledge_ops" action="action_kb_module_summary"/>
    <menuitem id="menu_kb_code_fact" name="程式結論" sequence="92"
              parent="menu_knowledge_ops" action="action_kb_code_fact"/>
    <menuitem id="menu_kb_code_tree" name="程式碼版本" sequence="93"
              parent="menu_knowledge_ops" action="action_kb_code_tree"/>

    <record id="view_kb_package_form_module_summary" model="ir.ui.view">
        <field name="name">infrastructure.solution.package.form.module.summary</field>
        <field name="model">infrastructure.solution.package</field>
        <field name="inherit_id" ref="view_kb_package_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_knowledge_coverage']" position="after">
                <button name="action_knowledge_module_summaries" string="模組摘要" type="object"/>
            </xpath>
        </field>
    </record>
</odoo>
