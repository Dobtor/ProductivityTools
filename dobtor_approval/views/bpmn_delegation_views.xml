<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bpmn_delegation_list" model="ir.ui.view">
        <field name="name">bpmn.delegation.list</field>
        <field name="model">bpmn.delegation</field>
        <field name="arch" type="xml">
            <list>
                <field name="delegator_id"/>
                <field name="delegate_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_bpmn_delegation_form" model="ir.ui.view">
        <field name="name">bpmn.delegation.form</field>
        <field name="model">bpmn.delegation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="delegator_id"/>
                            <field name="delegate_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group string="適用流程（留空=全部）">
                        <field name="definition_ids" nolabel="1"
                               widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bpmn_delegation" model="ir.actions.act_window">
        <field name="name">職務代理</field>
        <field name="res_model">bpmn.delegation</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
