<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_bpmn" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bpmn.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="BPMN 簽核" string="BPMN 簽核" name="dobtor_approval"
                     groups="dobtor_approval.group_bpmn_approval_designer">
                    <block title="T0 入門·線性簽核（預設啟用）" name="bpmn_t0">
                        <setting string="精靈建立流程"
                                 help="以精靈快速建立線性簽核流程">
                            <field name="bpmn_enable_wizard"/>
                        </setting>
                        <setting string="基本簽核"
                                 help="開始/簽核/結束、任一核准、直屬主管/部門經理">
                            <field name="bpmn_enable_basic_approval"/>
                        </setting>
                    </block>

                    <block title="T1 條件與會簽" name="bpmn_t1">
                        <setting string="條件分歧（互斥閘道）">
                            <field name="bpmn_enable_conditional"/>
                        </setting>
                        <setting string="會簽 / 依序簽核">
                            <field name="bpmn_enable_cosign"/>
                        </setting>
                        <setting string="進階 HR 簽核人解析"
                                 help="manager_level / job / field_on_record / expression">
                            <field name="bpmn_enable_hr_resolvers"/>
                        </setting>
                        <setting string="職務代理（代簽核）">
                            <field name="bpmn_enable_delegation"/>
                        </setting>
                    </block>

                    <block title="T2 業務動作整合" name="bpmn_t2">
                        <setting string="Action 攔截閘門"
                                 help="把簽核掛上 Odoo 按鈕：攔截→簽核→回放">
                            <field name="bpmn_enable_action_gate"/>
                        </setting>
                    </block>

                    <block title="T3 彈性例外（需先開 T1 會簽）" name="bpmn_t3">
                        <setting string="主管自主加簽 / 上呈"
                                 help="需先啟用「會簽 / 依序簽核」">
                            <field name="bpmn_enable_escalation"
                                   readonly="not bpmn_enable_cosign"/>
                        </setting>
                        <setting string="平行 / 包容閘道"
                                 help="需先啟用「會簽 / 依序簽核」">
                            <field name="bpmn_enable_parallel_gw"
                                   readonly="not bpmn_enable_cosign"/>
                        </setting>
                    </block>

                    <block title="T4 自助設計器（需先開 T1 條件）" name="bpmn_t4">
                        <setting string="自助積木設計器"
                                 help="需先啟用「條件分歧」">
                            <field name="bpmn_enable_designer"
                                   readonly="not bpmn_enable_conditional"/>
                        </setting>
                        <setting string="即時驗證 (bpmnlint)"
                                 help="需先啟用「自助積木設計器」">
                            <field name="bpmn_enable_lint"
                                   readonly="not bpmn_enable_designer"/>
                        </setting>
                        <setting string="沙箱模擬 (dry-run)"
                                 help="需先啟用「自助積木設計器」">
                            <field name="bpmn_enable_sandbox"
                                   readonly="not bpmn_enable_designer"/>
                        </setting>
                    </block>

                    <block title="T5 進階引擎（需先開 T2 / T1）" name="bpmn_t5">
                        <setting string="SLA 逾時事件"
                                 help="需先啟用「Action 攔截閘門」">
                            <field name="bpmn_enable_sla_timer"
                                   readonly="not bpmn_enable_action_gate"/>
                        </setting>
                        <setting string="失敗重試 (Incident)"
                                 help="需先啟用「Action 攔截閘門」">
                            <field name="bpmn_enable_incident"
                                   readonly="not bpmn_enable_action_gate"/>
                        </setting>
                        <setting string="真會簽 (Multi-instance 比例通過)"
                                 help="需先啟用「會簽 / 依序簽核」">
                            <field name="bpmn_enable_multi_instance"
                                   readonly="not bpmn_enable_cosign"/>
                        </setting>
                        <setting string="DMN 決策表求值"
                                 help="需先啟用「條件分歧」">
                            <field name="bpmn_enable_dmn"
                                   readonly="not bpmn_enable_conditional"/>
                        </setting>
                        <setting string="子流程複用 (Call Activity)"
                                 help="需先啟用「自助積木設計器」">
                            <field name="bpmn_enable_call_activity"
                                   readonly="not bpmn_enable_designer"/>
                        </setting>
                    </block>

                    <block title="T6 治理與專家（需先開 T4）" name="bpmn_t6">
                        <setting string="送審生命週期"
                                 help="需先啟用「自助積木設計器」">
                            <field name="bpmn_enable_governance"
                                   readonly="not bpmn_enable_designer"/>
                        </setting>
                        <setting string="公民 scope 權限限制"
                                 help="需先啟用「送審生命週期」">
                            <field name="bpmn_enable_scope"
                                   readonly="not bpmn_enable_governance"/>
                        </setting>
                        <setting string="專家完整調色盤"
                                 help="需先啟用「自助積木設計器」">
                            <field name="bpmn_enable_expert_mode"
                                   readonly="not bpmn_enable_designer"/>
                        </setting>
                        <setting string="執行中實例遷移"
                                 help="需先啟用「送審生命週期」">
                            <field name="bpmn_enable_migration"
                                   readonly="not bpmn_enable_governance"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_bpmn_config_settings" model="ir.actions.act_window">
        <field name="name">BPMN 簽核設定</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'dobtor_approval'}</field>
    </record>

</odoo>
