<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bpmn_delegate_wizard_form" model="ir.ui.view">
        <field name="name">bpmn.delegate.wizard.form</field>
        <field name="model">bpmn.delegate.wizard</field>
        <field name="arch" type="xml">
            <form string="委派代簽">
                <field name="link_id" invisible="1"/>
                <group>
                    <field name="delegate_user_id"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_delegate" type="object" string="委派"
                            class="btn-primary"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
