<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bpmn_lateral_wizard_form" model="ir.ui.view">
        <field name="name">bpmn.lateral.wizard.form</field>
        <field name="model">bpmn.lateral.wizard</field>
        <field name="arch" type="xml">
            <form string="橫向送簽">
                <field name="link_id" invisible="1"/>
                <field name="is_reply" invisible="1"/>
                <group invisible="is_reply">
                    <field name="mode"/>
                    <field name="user_ids" widget="many2many_tags"
                           required="not is_reply"/>
                    <field name="reason"/>
                </group>
                <group invisible="not is_reply">
                    <field name="reply"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="送出"
                            class="btn-primary"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
