#. module: dobtor_mail_activity_project
#: model_terms:ir.ui.view,arch_db:dobtor_mail_activity_project.mail_activity_done_wizard_view_form_project
msgid ""
"<i class=\"fa fa-exclamation-triangle\"/>\n"
"                    <span class=\"ms-1\">No project is linked to this activity: hours will not be logged to the timesheet. Link a project later and use \"Log Time\" in the Timesheet tab.</span>"
msgstr ""
"<i class=\"fa fa-exclamation-triangle\"/>\n"
"                    <span class=\"ms-1\">此待辦未關聯專案：工時不會登錄到工時表。之後關聯專案，可於「工時表」分頁按「登錄工時」補登。</span>"

#. module: dobtor_mail_activity_project
#: model_terms:ir.ui.view,arch_db:dobtor_mail_activity_project.res_company_view_form_inherit_productivity
msgid ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                        When an activity is completed without a linked project, the system will use this default project to create timesheet entries.\n"
"                        Please ensure the selected project has timesheet feature enabled."
msgstr ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                        當待辦完成時若未關聯專案，系統將使用此預設專案建立工時表記錄。\n"
"                        請確保選定的專案已啟用工時表功能。"

#. module: dobtor_mail_activity_project
#: model_terms:ir.ui.view,arch_db:dobtor_mail_activity_project.mail_activity_view_form_schedule_timesheet
msgid ""
"<i class=\"fa fa-info-circle\"/>\n"
"                        <span class=\"ms-1\">Link a project to log time.</span>"
msgstr ""
"<i class=\"fa fa-info-circle\"/>\n"
"                        <span class=\"ms-1\">關聯專案後即可登錄工時。</span>"

