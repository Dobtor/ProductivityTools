<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 工時管理員可查看所有效率指標 -->
        <record id="efficiency_metrics_rule_timesheet_manager_project" model="ir.rule">
            <field name="name">Efficiency Metrics: Timesheet Manager Access All Metrics</field>
            <field name="model_id" ref="dobtor_mail_activity.model_activity_efficiency_metrics"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_timesheet.group_timesheet_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>

    <!-- 隱藏 project_todo 的「待辦事項」App（改用 dobtor_mail_activity 自有的同名 App）。
         以「沒有成員的群組」限制選單可見性：project_todo 升級不會重設選單的群組，
         而本模組卸載時群組被刪 → 選單自動恢復可見，不需 uninstall hook。 -->
    <record id="group_hide_project_todo_app" model="res.groups">
        <field name="name">Hidden: project_todo To-do App</field>
        <field name="comment">Technical group with no members. Hides project_todo's To-do app in favour of the dobtor_mail_activity To-do app.</field>
    </record>
</odoo>
