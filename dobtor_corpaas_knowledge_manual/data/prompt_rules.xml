<?xml version="1.0" encoding="utf-8"?>
<!-- AI 提示詞規則（#18）：從程式搬出來的寫作規則，之後在「規則」畫面調整，不必部署。 -->
<odoo noupdate="1">
    <record id="rule_prompt_title_verb" model="corpaas.knowledge.rule">
        <field name="name">情境說明：標題動詞與操作步驟一致</field>
        <field name="kind">ai_prompt</field>
        <field name="track">prompt</field>
        <field name="value">{"purpose": "manual_scenario", "text": "標題的動詞要和下面的操作步驟一致：步驟只有查看就寫「查看／確認…」，不要寫成開啟、建立、維護。"}</field>
        <field name="source">builtin</field>
        <field name="evidence">2026-10-11 新架構第一輪：多數自審不過的文章把「開啟／建立」寫成腳本沒做的操作</field>
    </record>
    <record id="rule_prompt_demo_data_only" model="corpaas.knowledge.rule">
        <field name="name">情境說明：具體資料只用示範資料</field>
        <field name="kind">ai_prompt</field>
        <field name="track">prompt</field>
        <field name="value">{"purpose": "manual_scenario", "text": "品名、數量、單價、電話等具體資料只能用「截圖裡的示範資料」，沒有就不寫。"}</field>
        <field name="source">builtin</field>
        <field name="evidence">2026-10-11 新架構第一輪：編造數字被審稿退回</field>
    </record>
</odoo>
