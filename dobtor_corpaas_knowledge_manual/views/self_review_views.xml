<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kb_package_form_automation" model="ir.ui.view">
        <field name="name">corpaas.knowledge.package.form.automation</field>
        <field name="model">infrastructure.solution.package</field>
        <field name="inherit_id" ref="dobtor_corpaas_knowledge.view_kb_package_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='knowledge_document_native']" position="after">
                <field name="knowledge_automation"/>
            </xpath>
        </field>
    </record>
    <record id="view_kb_article_form_review" model="ir.ui.view">
        <field name="name">corpaas.knowledge.article.form.review</field>
        <field name="model">corpaas.knowledge.article</field>
        <field name="inherit_id" ref="view_kb_article_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="自審" invisible="not manual_review_state">
                    <field name="manual_review_state"/>
                    <field name="manual_review_note"/>
                    <field name="manual_review_sampled"/>
                    <field name="manual_sample_result" invisible="not manual_sample_result"/>
                    <div colspan="2" invisible="not manual_review_sampled">
                        <button name="action_sample_ok" type="object" string="抽查正確" class="btn-primary"
                                groups="dobtor_corpaas_knowledge.group_knowledge_approver"/>
                        <button name="action_sample_bad" type="object" string="抽查退回" class="btn-secondary"
                                groups="dobtor_corpaas_knowledge.group_knowledge_approver"/>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
