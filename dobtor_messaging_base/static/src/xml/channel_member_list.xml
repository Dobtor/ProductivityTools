<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- 以公司為主軸的成員面板（取代官方 online/offline 為頂層分組） -->
    <t t-name="dobtor_messaging_base.ChannelMemberList">
        <ActionPanel title.translate="Members" minWidth="200" initialWidth="250" icon="'fa fa-users'">
            <!-- 頂部：加入公司 -->
            <div t-if="canManageCompanies"
                 class="o-mail-ActionPanel-header position-sticky top-0 pt-2 pb-1 d-flex flex-column bg-inherit smaller pe-2">
                <span class="text-muted o-xsmaller text-uppercase opacity-75 mb-1">Company</span>
                <CompanyAutocomplete onSelect.bind="addCompany"/>
            </div>

            <button t-on-click="() => props.openChannelInvitePanel({ keepPrevious: env.inChatWindow })"
                    class="btn btn-sm btn-secondary mt-2 d-flex align-items-center justify-content-center gap-1 rounded">
                <i class="fa fa-user-plus opacity-75"/><span>Invite a User</span>
            </button>

            <!-- 依公司分組 -->
            <t t-foreach="props.thread.membersByCompany" t-as="group" t-key="group.id">
                <t t-call="discuss.ChannelMemberList.section">
                    <t t-set="sectionName" t-value="group.name + ' — ' + group.count"/>
                </t>
                <div class="d-flex flex-column bg-inherit gap-1">
                    <t t-foreach="group.online" t-as="member" t-key="member.id"
                       t-call="dobtor_messaging_base.channel_member"/>
                    <div t-if="group.offline.length and group.online.length"
                         class="o-xsmaller text-muted opacity-75 ps-2 pt-1">Offline</div>
                    <t t-foreach="group.offline" t-as="member" t-key="member.id"
                       t-call="dobtor_messaging_base.channel_member">
                        <t t-set="offline" t-value="1"/>
                    </t>
                </div>
            </t>

            <span t-if="props.thread.unknownMembersCount === 1" class="mx-2 mt-2">And 1 other member.</span>
            <span t-if="props.thread.unknownMembersCount > 1" class="mx-2 mt-2">And <t t-esc="props.thread.unknownMembersCount"/> other members.</span>
            <div t-if="!props.thread.areAllMembersLoaded" class="mx-2 my-1">
                <button class="btn btn-secondary" title="Load more" t-on-click.stop="() => props.thread.fetchChannelMembers()">Load more</button>
            </div>
        </ActionPanel>
    </t>

    <!-- 成員列：官方樣式 + 「加入公司」下拉 -->
    <t t-name="dobtor_messaging_base.channel_member">
        <div class="o-discuss-ChannelMember d-flex align-items-center p-1 bg-inherit rounded"
             t-att-class="{ 'cursor-pointer': canOpenChatWith(member), 'o-offline': offline }">
            <div class="bg-inherit o-discuss-ChannelMember-avatar position-relative d-flex flex-shrink-0"
                 t-on-click.stop="(ev) => this.onClickAvatar(ev, member)">
                <img class="w-100 h-100 rounded o_object_fit_cover" t-att-src="member.persona.avatarUrl"/>
                <ImStatus member="member" className="'position-absolute top-100 start-100 translate-middle mt-n1 ms-n1'" size="'md'"/>
            </div>
            <div class="d-flex overflow-hidden flex-column">
                <span class="ms-2 text-truncate text-muted fw-bold" t-esc="member.name" t-att-title="member.name"/>
            </div>
            <span class="ms-auto d-flex align-items-center">
                <span t-if="member.in(props.thread.invitedMembers)" class="p-1 fa fa-user-plus opacity-75"/>
                <Dropdown t-if="canManageCompanies and member.persona?.type === 'partner'" menuClass="'o-messaging-CompanyMenu'">
                    <button class="btn btn-sm btn-link p-1 text-muted" title="Assign company">
                        <i class="fa fa-building-o opacity-75"/>
                    </button>
                    <t t-set-slot="content">
                        <DropdownItem t-foreach="companyChoices" t-as="company" t-key="company.id"
                                      class="member.persona?.messagingCompanyId === company.id ? 'active' : ''"
                                      onSelected="() => this.assignMemberCompany(member, company.id)">
                            <i class="fa fa-building-o me-1 opacity-75"/><t t-esc="company.name"/>
                        </DropdownItem>
                        <div t-if="companyChoices.length" role="separator" class="dropdown-divider"/>
                        <DropdownItem onSelected="() => this.assignMemberCompany(member, false)">
                            <i class="fa fa-times me-1 opacity-75"/><span>Unassign</span>
                        </DropdownItem>
                    </t>
                </Dropdown>
            </span>
        </div>
    </t>

</templates>
