<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dobtor_messaging_base.MessagingPartnerCard">
        <div class="o_messaging_partner_card p-0" style="min-width: 240px; max-width: 320px;">
            <div class="d-flex align-items-center p-2 border-bottom">
                <img class="rounded o_messaging_partner_card_avatar me-2"
                     t-att-src="avatarUrl" alt="Avatar"
                     width="48" height="48" style="object-fit: cover;"/>
                <div class="d-flex flex-column overflow-hidden">
                    <b class="text-truncate" t-esc="partner.name"/>
                    <small t-if="partner.function" class="text-muted text-truncate"
                           t-esc="partner.function"/>
                </div>
            </div>
            <div class="d-flex flex-column p-2">
                <a t-if="partner.email" t-att-href="'mailto:' + partner.email" class="text-truncate">
                    <i class="fa fa-envelope me-1 text-muted"/><t t-esc="partner.email"/>
                </a>
                <a t-if="partner.phone" t-att-href="'tel:' + partner.phone" class="text-truncate">
                    <i class="fa fa-phone me-1 text-muted"/><t t-esc="partner.phone"/>
                </a>
                <a t-if="partner.mobile" t-att-href="'tel:' + partner.mobile" class="text-truncate">
                    <i class="fa fa-mobile me-1 text-muted"/><t t-esc="partner.mobile"/>
                </a>
                <button class="btn btn-sm btn-link text-start ps-0 mt-1"
                        t-on-click="onClickViewContact">
                    <i class="fa fa-address-card me-1"/>Open contact
                </button>
            </div>
        </div>
    </t>

</templates>
