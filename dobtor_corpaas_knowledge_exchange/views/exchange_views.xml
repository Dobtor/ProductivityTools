<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 對端主控台 -->
    <record id="view_kbx_peer_list" model="ir.ui.view">
        <field name="model">corpaas.knowledge.exchange.peer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="role"/>
                <field name="url"/>
                <field name="last_ok"/>
                <field name="last_error"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_kbx_peer_form" model="ir.ui.view">
        <field name="model">corpaas.knowledge.exchange.peer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_key" type="object" string="產生金鑰"
                            invisible="role != 'replica'"
                            groups="dobtor_corpaas_knowledge.group_knowledge_manager"
                            confirm="產生新金鑰後，從屬要換成新金鑰才能繼續交換。確定？"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="role"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="url" invisible="role != 'master'" required="role == 'master'"/>
                            <field name="key" password="True"
                                   groups="dobtor_corpaas_knowledge.group_knowledge_manager"/>
                            <field name="allowed_ips" invisible="role != 'replica'"/>
                        </group>
                    </group>
                    <group>
                        <field name="feed_cursor" invisible="role != 'master'"/>
                        <field name="last_ok"/>
                        <field name="last_error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_kbx_peer" model="ir.actions.act_window">
        <field name="name">對端主控台</field>
        <field name="res_model">corpaas.knowledge.exchange.peer</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 送件匣（從屬） -->
    <record id="view_kbx_outbox_list" model="ir.ui.view">
        <field name="model">corpaas.knowledge.exchange.outbox</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state in ('rejected', 'error')" decoration-muted="state in ('exists', 'ingested')">
                <field name="create_date"/>
                <field name="kind"/>
                <field name="name"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="reason"/>
            </list>
        </field>
    </record>
    <record id="view_kbx_outbox_search" model="ir.ui.view">
        <field name="model">corpaas.knowledge.exchange.outbox</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="todo" string="待送／失敗" domain="[('state', 'in', ('pending', 'error'))]"/>
                <filter name="review" string="待主體審核" domain="[('state', '=', 'review')]"/>
                <filter name="rejected" string="退回" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="分組">
                    <filter name="by_kind" string="類別" context="{'group_by': 'kind'}"/>
                    <filter name="by_state" string="狀態" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_kbx_outbox" model="ir.actions.act_window">
        <field name="name">送件匣</field>
        <field name="res_model">corpaas.knowledge.exchange.outbox</field>
        <field name="view_mode">list</field>
    </record>

    <!-- 入庫紀錄（主體） -->
    <record id="view_kbx_ingest_list" model="ir.ui.view">
        <field name="model">corpaas.knowledge.exchange.ingest</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="result == 'rejected'">
                <field name="create_date"/>
                <field name="peer_id"/>
                <field name="kind"/>
                <field name="key_text"/>
                <field name="result"/>
                <field name="reason"/>
            </list>
        </field>
    </record>
    <record id="action_kbx_ingest" model="ir.actions.act_window">
        <field name="name">入庫紀錄</field>
        <field name="res_model">corpaas.knowledge.exchange.ingest</field>
        <field name="view_mode">list</field>
    </record>

    <!-- 上收提案與修改意見（主體） -->
    <record id="view_kbx_promotion_list" model="ir.ui.view">
        <field name="model">corpaas.knowledge.exchange.promotion</field>
        <field name="arch" type="xml">
            <list create="0" decoration-info="state == 'pending'">
                <field name="create_date"/>
                <field name="type"/>
                <field name="peer_id"/>
                <field name="kind"/>
                <field name="name"/>
                <field name="state"/>
                <field name="reviewer_id"/>
            </list>
        </field>
    </record>
    <record id="view_kbx_promotion_form" model="ir.ui.view">
        <field name="model">corpaas.knowledge.exchange.promotion</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_approve" type="object" string="核准" class="btn-primary"
                            invisible="type != 'promotion' or state != 'pending'"/>
                    <button name="action_merge" type="object" string="併入既有"
                            invisible="type != 'promotion' or state != 'pending'"/>
                    <button name="action_reject" type="object" string="退回"
                            invisible="state != 'pending'"/>
                    <button name="action_mark_done" type="object" string="已處理"
                            invisible="type != 'feedback' or state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="type" readonly="1"/>
                            <field name="peer_id" readonly="1"/>
                            <field name="kind" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="kb_uid" readonly="1"/>
                        </group>
                        <group>
                            <field name="merged_into_uid" invisible="type != 'promotion'"
                                   readonly="state != 'pending'"/>
                            <field name="reviewer_id"/>
                            <field name="reviewed_at"/>
                        </group>
                    </group>
                    <field name="note" readonly="1" invisible="not note"/>
                    <group string="相似的既有項目" invisible="not similar_text">
                        <field name="similar_text" nolabel="1" colspan="2"/>
                    </group>
                    <group string="提案內容" invisible="type != 'promotion'">
                        <field name="payload" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_kbx_promotion" model="ir.actions.act_window">
        <field name="name">上收提案與意見</field>
        <field name="res_model">corpaas.knowledge.exchange.promotion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
    <record id="view_kbx_promotion_search" model="ir.ui.view">
        <field name="model">corpaas.knowledge.exchange.promotion</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="pending" string="待審" domain="[('state', '=', 'pending')]"/>
                <filter name="promotions" string="上收提案" domain="[('type', '=', 'promotion')]"/>
                <filter name="feedbacks" string="修改意見" domain="[('type', '=', 'feedback')]"/>
            </search>
        </field>
    </record>


    <!-- 移交 -->
    <record id="view_kbx_transfer_list" model="ir.ui.view">
        <field name="model">corpaas.knowledge.exchange.transfer</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="name"/>
                <field name="direction"/>
                <field name="partner_id"/>
                <field name="partner_name" optional="hide"/>
                <field name="state"/>
                <field name="item_count"/>
                <field name="executor_id"/>
            </list>
        </field>
    </record>
    <record id="view_kbx_transfer_form" model="ir.ui.view">
        <field name="model">corpaas.knowledge.exchange.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object" string="送出移交" class="btn-primary"
                            invisible="direction != 'out' or state != 'draft'"
                            confirm="會把這些模組的程式知識（含客戶私有）整包送給主體。確定客戶已同意？"/>
                    <button name="action_cancel" type="object" string="取消" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,received"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="direction"/>
                            <field name="partner_id" readonly="state != 'draft'" invisible="direction == 'in'"/>
                            <field name="partner_name" invisible="direction == 'out'"/>
                            <field name="peer_id" invisible="direction == 'out'"/>
                        </group>
                        <group>
                            <field name="item_count"/>
                            <field name="executor_id"/>
                            <field name="executed_at"/>
                            <field name="remote_ref"/>
                        </group>
                    </group>
                    <group string="範圍">
                        <field name="module_names" nolabel="1" colspan="2" readonly="state != 'draft'"
                               placeholder="一行一個模組技術名"/>
                    </group>
                    <group string="客戶同意">
                        <field name="consent" readonly="state != 'draft'"/>
                        <field name="consent_note" readonly="state != 'draft'" required="consent"/>
                        <field name="consent_user_id"/>
                        <field name="consent_at"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_kbx_transfer" model="ir.actions.act_window">
        <field name="name">移交</field>
        <field name="res_model">corpaas.knowledge.exchange.transfer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_knowledge_exchange" name="主從交換" parent="dobtor_corpaas_knowledge.menu_knowledge_root"
              sequence="40" groups="dobtor_corpaas_knowledge.group_knowledge_manager"/>
    <menuitem id="menu_kbx_promotion" name="上收提案與意見" parent="menu_knowledge_exchange"
              action="action_kbx_promotion" sequence="10"/>
    <menuitem id="menu_kbx_ingest" name="入庫紀錄" parent="menu_knowledge_exchange"
              action="action_kbx_ingest" sequence="20"/>
    <menuitem id="menu_kbx_outbox" name="送件匣" parent="menu_knowledge_exchange"
              action="action_kbx_outbox" sequence="30"/>
    <menuitem id="menu_kbx_transfer" name="移交" parent="menu_knowledge_exchange"
              action="action_kbx_transfer" sequence="40"/>
    <menuitem id="menu_kbx_peer" name="對端主控台" parent="menu_knowledge_exchange"
              action="action_kbx_peer" sequence="90"/>
</odoo>
