<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kbx_feedback_wizard" model="ir.ui.view">
        <field name="model">corpaas.knowledge.exchange.feedback.wizard</field>
        <field name="arch" type="xml">
            <form string="送修改意見給主體">
                <div class="alert alert-info" role="status">
                    這筆是主體的鏡像（內容唯讀）。意見會進主體的「上收提案與意見」清單，主體改了之後自動同步回來。
                    請不要寫客戶名稱或客戶資料。
                </div>
                <group>
                    <field name="record_name"/>
                    <field name="text" placeholder="例如：痛點寫得太籠統，建議改成…"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="送出" class="btn-primary"/>
                    <button string="取消" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_kbx_feedback_capability" model="ir.actions.act_window">
        <field name="name">送修改意見給主體</field>
        <field name="res_model">corpaas.knowledge.exchange.feedback.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="dobtor_corpaas_knowledge.model_corpaas_knowledge_capability"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('dobtor_corpaas_knowledge.group_knowledge_editor'))]"/>
    </record>
    <record id="action_kbx_feedback_scenario" model="ir.actions.act_window">
        <field name="name">送修改意見給主體</field>
        <field name="res_model">corpaas.knowledge.exchange.feedback.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="dobtor_corpaas_knowledge.model_corpaas_knowledge_scenario"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('dobtor_corpaas_knowledge.group_knowledge_editor'))]"/>
    </record>
    <record id="action_kbx_feedback_step_block" model="ir.actions.act_window">
        <field name="name">送修改意見給主體</field>
        <field name="res_model">corpaas.knowledge.exchange.feedback.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="dobtor_corpaas_knowledge_manual.model_corpaas_knowledge_step_block"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('dobtor_corpaas_knowledge.group_knowledge_editor'))]"/>
    </record>
</odoo>
