<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Topic Tree View (Hierarchical) -->
    <record id="view_xmind_topic_tree" model="ir.ui.view">
        <field name="name">xmind.topic.tree</field>
        <field name="model">xmind.topic</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="title"/>
                <field name="parent_id"/>
                <field name="child_count"/>
                <field name="note" optional="hide"/>
                <field name="markers" optional="hide"/>
                <field name="labels" optional="hide"/>
                <field name="depth"/>
            </tree>
        </field>
    </record>

    <!-- Topic Form View -->
    <record id="view_xmind_topic_form" model="ir.ui.view">
        <field name="name">xmind.topic.form</field>
        <field name="model">xmind.topic</field>
        <field name="arch" type="xml">
            <form string="Topic">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="title" placeholder="Topic Title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sheet_id"/>
                            <field name="parent_id"/>
                            <field name="is_root"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="component_id" readonly="1"/>
                            <field name="depth"/>
                            <field name="full_path"/>
                            <field name="child_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <group>
                                <field name="note" placeholder="Add notes here..."/>
                            </group>
                            <group string="Markers">
                                <field name="markers" widget="char"/>
                            </group>
                            <group string="Labels">
                                <field name="labels" widget="char"/>
                            </group>
                        </page>
                        <page string="Children" name="children">
                            <field name="child_ids">
                                <tree>
                                    <field name="sequence" widget="handle"/>
                                    <field name="title"/>
                                    <field name="child_count"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Visual" name="visual">
                            <group>
                                <field name="position_x"/>
                                <field name="position_y"/>
                                <field name="style_id"/>
                            </group>
                            <group string="Image">
                                <field name="image_attachment_id"/>
                                <field name="image_width"/>
                                <field name="image_height"/>
                            </group>
                        </page>
                        <page string="Summary" name="summary">
                            <group>
                                <field name="summary_title"/>
                                <field name="summary_edge_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Topic Search View -->
    <record id="view_xmind_topic_search" model="ir.ui.view">
        <field name="name">xmind.topic.search</field>
        <field name="model">xmind.topic</field>
        <field name="arch" type="xml">
            <search string="Search Topics">
                <field name="title"/>
                <field name="note"/>
                <field name="sheet_id"/>
                <field name="workbook_id"/>
                <filter string="Root Topics" name="root" domain="[('is_root', '=', True)]"/>
                <filter string="Has Notes" name="has_notes" domain="[('note', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Sheet" name="group_sheet" context="{'group_by': 'sheet_id'}"/>
                    <filter string="Parent" name="group_parent" context="{'group_by': 'parent_id'}"/>
                    <filter string="Depth" name="group_depth" context="{'group_by': 'depth'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Sheet Action -->
    <record id="action_xmind_sheet" model="ir.actions.act_window">
        <field name="name">Sheets</field>
        <field name="res_model">xmind.sheet</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Topic Action -->
    <record id="action_xmind_topic" model="ir.actions.act_window">
        <field name="name">Topics</field>
        <field name="res_model">xmind.topic</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_xmind_topic_search"/>
    </record>

</odoo>
