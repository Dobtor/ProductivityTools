<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Marker View -->
    <record id="view_xmind_marker_tree" model="ir.ui.view">
        <field name="name">xmind.marker.tree</field>
        <field name="model">xmind.marker</field>
        <field name="arch" type="xml">
            <tree string="Markers">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="icon"/>
                <field name="color" widget="color"/>
            </tree>
        </field>
    </record>

    <record id="view_xmind_marker_form" model="ir.ui.view">
        <field name="name">xmind.marker.form</field>
        <field name="model">xmind.marker</field>
        <field name="arch" type="xml">
            <form string="Marker">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="category"/>
                        <field name="icon"/>
                        <field name="color" widget="color"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Marker Action (must be defined before menuitem) -->
    <record id="action_xmind_marker" model="ir.actions.act_window">
        <field name="name">Markers</field>
        <field name="res_model">xmind.marker</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Main Menu -->
    <menuitem id="menu_xmind_root"
        name="Mind Maps"
        web_icon="dobtor_xmind,static/description/icon.png"
        sequence="100"/>

    <!-- Mind Maps Menu -->
    <menuitem id="menu_xmind_workbooks"
        name="Mind Maps"
        parent="menu_xmind_root"
        action="action_xmind_workbook"
        sequence="10"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_xmind_config"
        name="Configuration"
        parent="menu_xmind_root"
        sequence="100"/>

    <menuitem id="menu_xmind_markers"
        name="Markers"
        parent="menu_xmind_config"
        action="action_xmind_marker"
        sequence="10"/>

    <menuitem id="menu_xmind_sheets"
        name="Sheets"
        parent="menu_xmind_config"
        action="action_xmind_sheet"
        sequence="20"/>

    <menuitem id="menu_xmind_topics"
        name="Topics"
        parent="menu_xmind_config"
        action="action_xmind_topic"
        sequence="30"/>
</odoo>
