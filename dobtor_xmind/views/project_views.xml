<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Add Mind Map create/sync buttons + smart button to the project form. -->
    <record id="view_project_form_xmind" model="ir.ui.view">
        <field name="name">project.project.form.xmind</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_mindmap" type="object" string="建立心智圖"
                        class="btn-secondary" invisible="xmind_workbook_count &gt; 0"
                        groups="base.group_user"/>
                <button name="action_sync_mindmap" type="object" string="同步心智圖"
                        class="btn-secondary" invisible="xmind_workbook_count == 0"
                        groups="base.group_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_open_mindmaps"
                        icon="fa-sitemap" invisible="xmind_workbook_count == 0">
                    <field name="xmind_workbook_count" widget="statinfo" string="Mind Maps"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Add an "open mind map" jump box to the project kanban card. -->
    <record id="view_project_kanban_xmind" model="ir.ui.view">
        <field name="name">project.project.kanban.xmind</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_project_kanban_boxes')]" position="inside">
                <a class="o_project_kanban_box me-1" name="action_open_mindmaps" type="object"
                   t-if="record.xmind_workbook_count.raw_value &gt; 0" title="開啟心智圖">
                    <div>
                        <field name="xmind_workbook_count" class="o_value"/>
                        <span class="ms-1">心智圖</span>
                    </div>
                </a>
            </xpath>
        </field>
    </record>
</odoo>
