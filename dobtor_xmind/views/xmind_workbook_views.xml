<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Workbook List View -->
    <record id="view_xmind_workbook_list" model="ir.ui.view">
        <field name="name">xmind.workbook.list</field>
        <field name="model">xmind.workbook</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="creator"/>
                <field name="sheet_count"/>
                <field name="topic_count"/>
                <field name="modified_time"/>
            </list>
        </field>
    </record>

    <!-- Workbook Form View -->
    <record id="view_xmind_workbook_form" model="ir.ui.view">
        <field name="name">xmind.workbook.form</field>
        <field name="model">xmind.workbook</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_editor" string="Open Visual Editor" type="object" class="btn-primary"/>
                    <button name="export_xmind_file" string="Export .xmind" type="object" class="btn-secondary"/>
                    <button name="export_svg" string="Export SVG" type="object" class="btn-secondary"/>
                    <button name="export_png" string="Export PNG" type="object" class="btn-secondary"/>
                    <button name="export_pdf" string="Export PDF" type="object" class="btn-secondary"/>
                    <button name="import_xmind_file" string="Import .xmind" type="object" class="btn-secondary"/>
                    <button name="import_freemind_file" string="Import FreeMind" type="object" class="btn-secondary"/>
                    <button name="import_mindmanager_file" string="Import MindManager" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Mind Map Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="creator"/>
                        </group>
                        <group>
                            <field name="created_time"/>
                            <field name="modified_time"/>
                            <field name="sheet_count"/>
                            <field name="topic_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sheets">
                            <field name="sheet_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="layout_type"/>
                                    <field name="theme"/>
                                </list>
                            </field>
                        </page>
                        <page string="Import/Export">
                            <group>
                                <field name="xmind_file" filename="xmind_filename"/>
                                <field name="xmind_filename" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Workbook Kanban View -->
    <record id="view_xmind_workbook_kanban" model="ir.ui.view">
        <field name="name">xmind.workbook.kanban</field>
        <field name="model">xmind.workbook</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="creator"/>
                <field name="topic_count"/>
                <field name="modified_time"/>
                <field name="thumbnail"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <t t-if="record.thumbnail.raw_value">
                                    <img t-att-src="kanban_image('xmind.workbook', 'thumbnail', record.id.raw_value)" alt="Thumbnail"/>
                                </t>
                                <t t-else="">
                                    <span class="fa fa-sitemap fa-3x text-muted"/>
                                </t>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="creator"/>
                                </div>
                                <div>
                                    <span class="badge text-bg-info">
                                        <field name="topic_count"/> topics
                                    </span>
                                </div>
                                <div class="text-muted">
                                    <field name="modified_time"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Workbook Action -->
    <record id="action_xmind_workbook" model="ir.actions.act_window">
        <field name="name">Mind Maps</field>
        <field name="res_model">xmind.workbook</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
