<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Workbook List View -->
    <record id="view_xmind_workbook_list" model="ir.ui.view">
        <field name="name">xmind.workbook.list</field>
        <field name="model">xmind.workbook</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="show"/>
                <field name="creator" optional="hide"/>
                <field name="sheet_count" optional="hide"/>
                <field name="topic_count"/>
                <field name="modified_time"/>
            </list>
        </field>
    </record>

    <!-- Workbook Form View -->
    <record id="view_xmind_workbook_form" model="ir.ui.view">
        <field name="name">xmind.workbook.form</field>
        <field name="model">xmind.workbook</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_editor" string="Open Visual Editor" type="object" class="btn-primary" invisible="not active"/>
                    <button name="action_archive" string="Archive" type="object" class="btn-secondary" invisible="not active"/>
                    <button name="action_unarchive" string="Unarchive" type="object" class="btn-primary" invisible="active"/>
                    <button name="export_xmind_file" string="Export .xmind" type="object" class="btn-secondary"/>
                    <button name="export_svg" string="Export SVG" type="object" class="btn-secondary"/>
                    <button name="export_png" string="Export PNG" type="object" class="btn-secondary"/>
                    <button name="export_pdf" string="Export PDF" type="object" class="btn-secondary"/>
                    <button name="import_xmind_file" string="Import .xmind" type="object" class="btn-secondary" invisible="not active"/>
                    <button name="import_freemind_file" string="Import FreeMind" type="object" class="btn-secondary" invisible="not active"/>
                    <button name="import_mindmanager_file" string="Import MindManager" type="object" class="btn-secondary" invisible="not active"/>
                </header>
                <sheet>
                    <div class="alert alert-warning text-center" role="alert" invisible="active">
                        <strong>This mind map is archived.</strong>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Mind Map Name"/>
                        </h1>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" placeholder="Tags..."/>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="description"/>
                            <field name="creator"/>
                            <field name="create_uid" readonly="1"/>
                        </group>
                        <group>
                            <field name="created_time"/>
                            <field name="modified_time"/>
                            <field name="sheet_count"/>
                            <field name="topic_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sheets">
                            <field name="sheet_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="layout_type"/>
                                    <field name="theme"/>
                                </list>
                            </field>
                        </page>
                        <page string="Import/Export">
                            <group>
                                <field name="xmind_file" filename="xmind_filename"/>
                                <field name="xmind_filename" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Workbook Kanban View -->
    <record id="view_xmind_workbook_kanban" model="ir.ui.view">
        <field name="name">xmind.workbook.kanban</field>
        <field name="model">xmind.workbook</field>
        <field name="arch" type="xml">
            <kanban action="action_open_editor" type="object">
                <field name="create_uid"/>
                <field name="tag_ids"/>
                <field name="topic_count"/>
                <field name="modified_time"/>
                <field name="thumbnail"/>
                <templates>
                    <t t-name="menu">
                        <a role="menuitem" type="open" class="dropdown-item">Settings</a>
                        <a role="menuitem" type="archive" class="dropdown-item">Archive</a>
                        <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                    </t>
                    <t t-name="card">
                        <field name="name" class="fw-bolder fs-5"/>
                        <field name="partner_id" class="text-muted" invisible="not partner_id"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <div class="d-flex align-items-center justify-content-between mt-1">
                            <span class="badge text-bg-info">
                                <field name="topic_count"/> topics
                            </span>
                            <field name="create_uid" widget="many2one_avatar_user"/>
                        </div>
                        <div class="text-muted small mt-1">
                            <field name="modified_time"/>
                        </div>
                        <field name="thumbnail" widget="image"
                               invisible="not thumbnail"
                               options="{'img_class': 'w-100 rounded mt-2', 'size': [0, 120]}"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Workbook Action -->
    <record id="action_xmind_workbook" model="ir.actions.act_window">
        <field name="name">Mind Maps</field>
        <field name="res_model">xmind.workbook</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
