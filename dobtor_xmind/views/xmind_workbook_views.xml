<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Workbook Tree View -->
    <record id="view_xmind_workbook_tree" model="ir.ui.view">
        <field name="name">xmind.workbook.tree</field>
        <field name="model">xmind.workbook</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="sheet_count"/>
                <field name="theme"/>
                <field name="creator"/>
                <field name="last_modified"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Workbook Form View -->
    <record id="view_xmind_workbook_form" model="ir.ui.view">
        <field name="name">xmind.workbook.form</field>
        <field name="model">xmind.workbook</field>
        <field name="arch" type="xml">
            <form string="XMind Workbook">
                <header>
                    <button name="action_view_editor" type="object"
                            string="Open Editor" class="oe_highlight"
                            icon="fa-edit"/>
                    <button name="export_to_xmind" type="object"
                            string="Export .xmind" icon="fa-download"/>
                    <button name="action_create_sheet" type="object"
                            string="Add Sheet" icon="fa-plus"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(dobtor_xmind.action_xmind_sheet)d"
                                type="action" class="oe_stat_button"
                                icon="fa-sitemap">
                            <field name="sheet_count" widget="statinfo"
                                   string="Sheets"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Workbook Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="theme"/>
                            <field name="creator"/>
                        </group>
                        <group>
                            <field name="last_modified"/>
                            <field name="attachment_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sheets" name="sheets">
                            <field name="sheet_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="topic_count"/>
                                    <field name="theme_override"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Add description..."/>
                        </page>
                        <page string="JSON Data" name="json_data" groups="base.group_no_one">
                            <field name="json_data" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Workbook Kanban View -->
    <record id="view_xmind_workbook_kanban" model="ir.ui.view">
        <field name="name">xmind.workbook.kanban</field>
        <field name="model">xmind.workbook</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="sheet_count"/>
                <field name="theme"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <i class="fa fa-sitemap fa-3x text-primary"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_tags_section">
                                    <span class="badge badge-pill badge-info">
                                        <field name="sheet_count"/> Sheets
                                    </span>
                                    <span class="badge badge-pill badge-secondary">
                                        <field name="theme"/>
                                    </span>
                                </div>
                                <div class="text-muted">
                                    <field name="last_modified" widget="date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Workbook Search View -->
    <record id="view_xmind_workbook_search" model="ir.ui.view">
        <field name="name">xmind.workbook.search</field>
        <field name="model">xmind.workbook</field>
        <field name="arch" type="xml">
            <search string="Search Workbooks">
                <field name="name"/>
                <field name="creator"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Archived" name="archived" domain="[('state', '=', 'archived')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Theme" name="group_theme" context="{'group_by': 'theme'}"/>
                    <filter string="Creator" name="group_creator" context="{'group_by': 'creator'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Workbook Action -->
    <record id="action_xmind_workbook" model="ir.actions.act_window">
        <field name="name">Mind Maps</field>
        <field name="res_model">xmind.workbook</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_xmind_workbook_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Mind Map
            </p>
            <p>
                Design visual mind maps to organize your ideas, projects, and workflows.
            </p>
        </field>
    </record>

</odoo>
