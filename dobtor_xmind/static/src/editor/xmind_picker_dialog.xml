<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="dobtor_xmind.PickerDialog">
        <Dialog title="title" size="'md'">
            <div t-if="state.picked" class="o_xmind_picker_sheets">
                <div class="fw-bold mb-2">
                    <i class="fa fa-sitemap text-primary me-1"/><t t-esc="state.picked.name"/>
                </div>
                <label class="form-label" for="o_xmind_picker_sheet_select" t-esc="sheetStepLabel"/>
                <select class="form-select" id="o_xmind_picker_sheet_select"
                        t-on-change="onSheetSelect">
                    <option t-foreach="state.sheets" t-as="sheet" t-key="sheet.id"
                            t-att-value="sheet.id" t-att-selected="sheet.id === state.sheetId">
                        <t t-esc="sheetLabel(sheet)"/>
                    </option>
                </select>
            </div>
            <t t-else="">
            <div class="mb-2">
                <input type="text" class="form-control"
                       placeholder="Search mind map names…"
                       t-att-value="state.search"
                       t-on-input="onSearchInput"/>
            </div>
            <div t-if="state.loading" class="text-center text-muted p-3">
                <i class="fa fa-spinner fa-spin"/>
            </div>
            <div t-elif="!state.workbooks.length" class="text-muted p-3">
                No mind map found.
            </div>
            <div t-else="" class="list-group o_xmind_picker">
                <button t-foreach="state.workbooks" t-as="wb" t-key="wb.id"
                        type="button"
                        class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                        t-on-click="() => this.onSelect(wb)">
                    <i class="fa fa-sitemap fa-fw text-primary"/>
                    <span class="flex-grow-1 text-truncate" t-esc="wb.name"/>
                    <span t-if="subtitle(wb)" class="text-muted small text-truncate"
                          t-esc="subtitle(wb)"/>
                </button>
            </div>
            </t>
            <t t-set-slot="footer">
                <button t-if="state.picked" class="btn btn-primary o_xmind_picker_insert"
                        t-on-click="onInsertSheet">
                    Insert
                </button>
                <button t-if="state.picked" class="btn btn-secondary" t-on-click="onBack">
                    Back
                </button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

</templates>
