<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dobtor_xmind.MindmapPromptDialog">
        <Dialog title="props.title" size="'md'">
            <div class="o_mindmap_prompt">
                <div t-foreach="props.fields" t-as="field" t-key="field.name" class="mb-3">
                    <label class="form-label" t-att-for="'o_mindmap_prompt_' + field.name">
                        <t t-esc="field.label"/>
                    </label>
                    <input class="form-control"
                           t-att-id="'o_mindmap_prompt_' + field.name"
                           t-att-type="field.type or 'text'"
                           t-att-placeholder="field.placeholder or ''"
                           t-att-value="state.values[field.name]"
                           t-ref="{{ 'input_' + field_index }}"
                           t-on-input="(ev) => this.onInput(field.name, ev)"
                           t-on-keydown="onKeydown"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onConfirm">
                    <t t-esc="confirmLabel"/>
                </button>
                <button class="btn btn-secondary" t-on-click="() => props.close()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

</templates>
