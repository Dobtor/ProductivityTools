<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="dobtor_xmind.MindmapEditor">
        <div class="o_mindmap_editor_container">
            <!-- Toolbar: Mind map layout -->
            <div class="o_mindmap_toolbar" t-if="!readonly">

                <!-- 資料所屬資訊（仿 form view 麵包屑）：模型 + 記錄名 + 齒輪 → 開啟資料表單。 -->
                <div class="o_mindmap_breadcrumb d-flex flex-column justify-content-center me-2"
                     role="button" t-on-click="onOpenForm"
                     title="開啟資料表單（客戶／專案／可見性／建立資訊…）">
                    <small class="o_mindmap_bc_model text-muted lh-1">心智圖</small>
                    <span class="d-flex align-items-center gap-1 lh-1">
                        <span class="o_mindmap_record_name fw-bold text-truncate"/>
                        <i class="fa fa-cog text-muted"/>
                    </span>
                </div>

                <!-- Group 1: 建立/同步專案 · 儲存 · 匯出SVG · 復原 · 重做 -->
                <div class="btn-group me-2">
                    <button class="btn btn-sm btn-outline-info o_mindmap_btn_project_sync" title="建立 / 同步專案" t-on-click="onSyncOrCreateProject">
                        <i class="fa fa-refresh"/>
                    </button>
                    <button class="btn btn-sm btn-outline-success o_mindmap_btn_save" title="儲存 (Ctrl+S)" t-on-click="onSave">
                        <i class="fa fa-save"/>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary o_mindmap_btn_export" title="匯出 SVG" t-on-click="onExportSVG">
                        <i class="fa fa-download"/>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary o_mindmap_btn_undo" title="復原 (Ctrl+Z)" disabled="disabled" t-on-click="onUndo">
                        <i class="fa fa-undo"/>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary o_mindmap_btn_redo" title="重做 (Ctrl+Y)" disabled="disabled" t-on-click="onRedo">
                        <i class="fa fa-repeat"/>
                    </button>
                </div>

                <!-- Group 2: Topic dropdown (Mind map: Topic + Subtopic + Before + Parent) -->
                <div class="btn-group me-2">
                    <button class="btn btn-sm btn-outline-primary o_mindmap_btn_add_child" title="新增子主題 (Tab)" t-on-click="onAddChild">
                        <i class="fa fa-plus"/>
                    </button>
                    <button class="btn btn-sm btn-outline-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" title="更多主題選項"/>
                    <div class="dropdown-menu">
                        <a class="dropdown-item" href="#" t-on-click="onAddSibling">
                            <i class="fa fa-plus text-primary"/> 主題 (Enter)
                        </a>
                        <a class="dropdown-item o_mindmap_btn_add_child" href="#" t-on-click="onAddChild">
                            <i class="fa fa-level-down text-primary"/> 子主題 (Tab)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onAddTopicBefore">
                            <i class="fa fa-level-up text-primary"/> 前方主題 (Shift+Enter)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onAddParentTopic">
                            <i class="fa fa-outdent text-primary"/> 父主題 (Ctrl+Enter)
                        </a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item o_mindmap_btn_floating" href="#" t-on-click="onAddFloatingTopic">
                            <i class="fa fa-plus-circle text-muted"/> 浮動主題
                        </a>
                        <a class="dropdown-item o_mindmap_btn_callout" href="#" t-on-click="onAddCallout">
                            <i class="fa fa-comment text-warning"/> 標註
                        </a>
                    </div>
                </div>

                <!-- Group 3: Relationship / Boundary / Summary (Mind map: mindmap toolbar group) -->
                <div class="btn-group me-2">
                    <button class="btn btn-sm btn-outline-secondary o_mindmap_btn_relationship" title="關連線：點選來源 → 點選目標" t-on-click="onAddRelationship">
                        <i class="fa fa-long-arrow-right"/> 關連線
                    </button>
                    <button class="btn btn-sm btn-outline-secondary o_mindmap_btn_boundary" title="外框：拖曳選取主題" t-on-click="onAddBoundary">
                        <i class="fa fa-square-o"/> 外框
                    </button>
                    <button class="btn btn-sm btn-outline-secondary o_mindmap_btn_summary" title="括弧總結：拖曳選取主題" t-on-click="onAddSummary">
                        <i class="fa fa-indent"/> 括弧總結
                    </button>
                </div>

                <!-- Group 4: Insert dropdown (Mind map: Markers + Notes + Label + Hyperlink + Image + Attachment) -->
                <div class="btn-group me-2">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="插入">
                        <i class="fa fa-plus"/> 插入
                    </button>
                    <div class="dropdown-menu">
                        <a class="dropdown-item o_mindmap_btn_marker" href="#" t-on-click="onOpenMarker">
                            <i class="fa fa-flag text-warning"/> 標記
                        </a>
                        <a class="dropdown-item o_mindmap_btn_note" href="#" t-on-click="onOpenNote">
                            <i class="fa fa-sticky-note text-info"/> 備註
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onInsertHyperlink">
                            <i class="fa fa-link text-primary"/> 超連結
                        </a>
                        <a class="dropdown-item o_mindmap_insert_image" href="#" t-on-click="onInsertImage">
                            <i class="fa fa-image text-success"/> 圖片
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onInsertComment">
                            <i class="fa fa-comments text-muted"/> 評論
                        </a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item o_mindmap_insert_attachment" href="#" t-on-click="onInsertAttachment">
                            <i class="fa fa-paperclip text-secondary"/> 附件
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onInsertNote">
                            <i class="fa fa-tag text-info"/> 標籤
                        </a>
                    </div>
                </div>

                <!-- Group 5: Format dropdown (Mind map: Properties panel - Shape/Text/Branch) -->
                <div class="btn-group me-2">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="格式">
                        <i class="fa fa-paint-brush"/> 格式
                    </button>
                    <div class="dropdown-menu o_format_menu" style="min-width: 280px;">
                        <!-- Shape Style Section -->
                        <h6 class="dropdown-header">
                            <i class="fa fa-square"/> 形狀樣式
                        </h6>
                        <div class="px-3 py-1">
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">形狀類型</label>
                                <select class="form-control form-control-sm o_format_shape_type">
                                    <option value="rectangle">矩形</option>
                                    <option value="rounded" selected="selected">圓角矩形</option>
                                    <option value="ellipse">橢圓</option>
                                    <option value="circle">圓形</option>
                                    <option value="diamond">菱形</option>
                                    <option value="parallelogram">平行四邊形</option>
                                    <option value="hexagon">六邊形</option>
                                    <option value="cloud">雲朵</option>
                                    <option value="underline">僅底線</option>
                                    <option value="noBorder">無邊框</option>
                                    <option value="stroke">筆畫圓</option>
                                    <option value="fishhead_left">魚頭向左</option>
                                    <option value="fishhead_right">魚頭向右</option>
                                </select>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">填色</label>
                                <input type="color" class="form-control form-control-sm o_format_fill_color" value="#DCE6F2"/>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">邊框色</label>
                                <input type="color" class="form-control form-control-sm o_format_border_color" value="#558ED5"/>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">邊框寬度</label>
                                <select class="form-control form-control-sm o_format_border_width">
                                    <option value="1">細 (1px)</option>
                                    <option value="2" selected="selected">標準 (2px)</option>
                                    <option value="3">中等 (3px)</option>
                                    <option value="4">粗 (4px)</option>
                                </select>
                            </div>
                        </div>

                        <div class="dropdown-divider"></div>

                        <!-- Text Style Section -->
                        <h6 class="dropdown-header">
                            <i class="fa fa-font"/> 文字樣式
                        </h6>
                        <div class="px-3 py-1">
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">字型</label>
                                <select class="form-control form-control-sm o_format_font_family">
                                    <option value="inherit">預設</option>
                                    <option value="Arial, sans-serif">Arial</option>
                                    <option value="'Helvetica Neue', Helvetica, sans-serif">Helvetica</option>
                                    <option value="'Times New Roman', Times, serif">Times New Roman</option>
                                    <option value="Georgia, serif">Georgia</option>
                                    <option value="'Courier New', Courier, monospace">Courier New</option>
                                    <option value="Verdana, sans-serif">Verdana</option>
                                    <option value="'Trebuchet MS', sans-serif">Trebuchet MS</option>
                                </select>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">字級</label>
                                <select class="form-control form-control-sm o_format_font_size">
                                    <option value="10">10px</option>
                                    <option value="12">12px</option>
                                    <option value="14" selected="selected">14px</option>
                                    <option value="16">16px</option>
                                    <option value="18">18px</option>
                                    <option value="20">20px</option>
                                    <option value="24">24px</option>
                                    <option value="28">28px</option>
                                    <option value="32">32px</option>
                                </select>
                            </div>
                            <div class="btn-group btn-group-sm mb-2" role="group">
                                <button class="btn btn-outline-secondary o_format_bold" title="粗體" t-on-click="onFormatBold">
                                    <i class="fa fa-bold"/>
                                </button>
                                <button class="btn btn-outline-secondary o_format_italic" title="斜體" t-on-click="onFormatItalic">
                                    <i class="fa fa-italic"/>
                                </button>
                                <button class="btn btn-outline-secondary o_format_underline" title="底線" t-on-click="onFormatUnderline">
                                    <i class="fa fa-underline"/>
                                </button>
                                <button class="btn btn-outline-secondary o_format_strikethrough" title="刪除線" t-on-click="onFormatStrikethrough">
                                    <i class="fa fa-strikethrough"/>
                                </button>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">文字對齊</label>
                                <div class="btn-group btn-group-sm d-flex">
                                    <button class="btn btn-outline-secondary" title="靠左對齊" t-on-click="onTextAlignLeft"><i class="fa fa-align-left"/></button>
                                    <button class="btn btn-outline-secondary" title="置中對齊" t-on-click="onTextAlignCenter"><i class="fa fa-align-center"/></button>
                                    <button class="btn btn-outline-secondary" title="靠右對齊" t-on-click="onTextAlignRight"><i class="fa fa-align-right"/></button>
                                </div>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">文字色</label>
                                <input type="color" class="form-control form-control-sm o_format_text_color" value="#17375E"/>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">背景色</label>
                                <input type="color" class="form-control form-control-sm o_format_bg_color" value="#ffffff"/>
                            </div>
                        </div>

                        <div class="dropdown-divider"></div>

                        <!-- Structure Section -->
                        <h6 class="dropdown-header">
                            <i class="fa fa-sitemap"/> 結構
                        </h6>
                        <div class="px-3 py-1">
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">佈局類型</label>
                                <select class="form-control form-control-sm o_format_structure_type" t-on-change="onFormatStructureChange">
                                    <option value="map">心智圖</option>
                                    <option value="org_chart_down">組織圖 (向下)</option>
                                    <option value="org_chart_up">組織圖 (向上)</option>
                                    <option value="tree_right">樹狀圖 (向右)</option>
                                    <option value="tree_left">樹狀圖 (向左)</option>
                                    <option value="logic_right">邏輯圖 (向右)</option>
                                    <option value="logic_left">邏輯圖 (向左)</option>
                                    <option value="timeline_horizontal">時間軸 - 水平</option>
                                    <option value="timeline_vertical">時間軸 - 垂直</option>
                                    <option value="fishbone_right">魚骨圖 (頭向左)</option>
                                    <option value="fishbone_left">魚骨圖 (頭向右)</option>
                                </select>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">水平間距</label>
                                <input type="range" class="form-range o_format_h_space" min="30" max="150" value="80" t-on-input="onFormatHSpaceChange"/>
                                <small class="text-muted o_format_h_space_val">80px</small>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">垂直間距</label>
                                <input type="range" class="form-range o_format_v_space" min="10" max="80" value="25" t-on-input="onFormatVSpaceChange"/>
                                <small class="text-muted o_format_v_space_val">25px</small>
                            </div>
                        </div>

                        <div class="dropdown-divider"></div>

                        <!-- Branch Style Section -->
                        <h6 class="dropdown-header">
                            <i class="fa fa-code-fork"/> 分支樣式
                        </h6>
                        <div class="px-3 py-1">
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">線型</label>
                                <select class="form-control form-control-sm o_format_line_type">
                                    <option value="curved">曲線</option>
                                    <option value="straight">直線</option>
                                    <option value="angular">直角折線</option>
                                    <option value="rounded">圓角折線</option>
                                    <option value="none">無</option>
                                </select>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">線寬</label>
                                <select class="form-control form-control-sm o_format_line_width">
                                    <option value="1">細 (1px)</option>
                                    <option value="2" selected="selected">標準 (2px)</option>
                                    <option value="3">中等 (3px)</option>
                                    <option value="4">粗 (4px)</option>
                                    <option value="5">特粗 (5px)</option>
                                </select>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">線色</label>
                                <input type="color" class="form-control form-control-sm o_format_line_color" value="#558ED5"/>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">線條樣式</label>
                                <select class="form-control form-control-sm o_format_line_style">
                                    <option value="solid">實線</option>
                                    <option value="dashed">虛線</option>
                                    <option value="dotted">點線</option>
                                </select>
                            </div>
                        </div>

                        <div class="dropdown-divider"></div>

                        <div class="px-3 py-1">
                            <button class="btn btn-sm btn-primary w-100 o_format_apply" t-on-click="onFormatApply">
                                <i class="fa fa-check"/> 套用至選取
                            </button>
                            <button class="btn btn-sm btn-outline-secondary w-100 mt-1 o_format_apply_all" t-on-click="onFormatApplyAll">
                                <i class="fa fa-globe"/> 套用至全部
                            </button>
                            <button class="btn btn-sm btn-outline-warning w-100 mt-1 o_format_reset" t-on-click="onFormatReset">
                                <i class="fa fa-undo"/> 重設為預設
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Group 6: View dropdown (Mind map: View menu — Zoom / Drill / Expand / Overview / Outline) -->
                <div class="btn-group me-2">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="檢視">
                        <i class="fa fa-eye"/> 檢視
                    </button>
                    <div class="dropdown-menu">
                        <h6 class="dropdown-header"><i class="fa fa-search"/> 縮放</h6>
                        <a class="dropdown-item" href="#" t-on-click="onZoomIn">
                            <i class="fa fa-search-plus"/> 放大 (Ctrl++)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onZoomOut">
                            <i class="fa fa-search-minus"/> 縮小 (Ctrl+-)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onZoomReset">
                            <i class="fa fa-compress"/> 實際大小
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onZoomFit">
                            <i class="fa fa-arrows-alt"/> 符合畫面
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onZoomFitSelection">
                            <i class="fa fa-crosshairs"/> 符合選取
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-sitemap"/> 導覽</h6>
                        <a class="dropdown-item" href="#" t-on-click="onDrillDown">
                            <i class="fa fa-arrow-circle-down"/> 鑽研進入
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onDrillUp">
                            <i class="fa fa-arrow-circle-up"/> 鑽研返回
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-toggle-on"/> 顯示</h6>
                        <a class="dropdown-item o_mindmap_btn_expand_all" href="#" t-on-click="onExpandAll">
                            <i class="fa fa-expand"/> 全部展開
                        </a>
                        <a class="dropdown-item o_mindmap_btn_collapse_all" href="#" t-on-click="onCollapseAll">
                            <i class="fa fa-compress"/> 全部收合
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-columns"/> 面板</h6>
                        <a class="dropdown-item" href="#" t-on-click="onToggleOverview">
                            <i class="fa fa-eye"/> 概覽
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onToggleOutline">
                            <i class="fa fa-list"/> 大綱
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onToggleLegend">
                            <i class="fa fa-list-ul"/> 圖例
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onToggleRevisions">
                            <i class="fa fa-history"/> 版本紀錄
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-wrench"/> 工具</h6>
                        <a class="dropdown-item" href="#" t-on-click="onFindReplace">
                            <i class="fa fa-search"/> 尋找與取代 (Ctrl+F)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onToggleNumbering">
                            <i class="fa fa-list-ol"/> 編號
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onToggleTapering">
                            <i class="fa fa-long-arrow-right"/> 漸細線
                        </a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="#" t-on-click="onShowResourceManager">
                            <i class="fa fa-th-large"/> 資源管理員
                        </a>
                    </div>
                </div>

                <!-- Group 7: Modify dropdown (Mind map: Modify menu — Edit/Sort/Align/Delete) -->
                <div class="btn-group me-2">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="修改">
                        <i class="fa fa-pencil"/> 修改
                    </button>
                    <div class="dropdown-menu">
                        <h6 class="dropdown-header"><i class="fa fa-pencil"/> 編輯</h6>
                        <a class="dropdown-item" href="#" t-on-click="onCutTopic">
                            <i class="fa fa-scissors"/> 剪下 (Ctrl+X)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onCopyTopic">
                            <i class="fa fa-copy"/> 複製 (Ctrl+C)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onPasteTopic">
                            <i class="fa fa-paste"/> 貼上 (Ctrl+V)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onDuplicateTopic">
                            <i class="fa fa-files-o"/> 重製 (Ctrl+D)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onDelete">
                            <i class="fa fa-trash text-danger"/> 刪除 (Del)
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-arrows-v"/> 位置</h6>
                        <a class="dropdown-item" href="#" t-on-click="onMoveUp">
                            <i class="fa fa-arrow-up"/> 上移 (Alt+Up)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onMoveDown">
                            <i class="fa fa-arrow-down"/> 下移 (Alt+Down)
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-eye"/> 顯示</h6>
                        <a class="dropdown-item" href="#" t-on-click="onExpandAll">
                            <i class="fa fa-expand"/> 全部展開
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onCollapseAll">
                            <i class="fa fa-compress"/> 全部收合
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-sort"/> 排序</h6>
                        <a class="dropdown-item" href="#" t-on-click="onSortAscending">
                            <i class="fa fa-sort-alpha-asc"/> 排序 A → Z
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onSortDescending">
                            <i class="fa fa-sort-alpha-desc"/> 排序 Z → A
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onSortByPriority">
                            <i class="fa fa-sort-numeric-asc"/> 依優先級排序
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-paint-brush"/> 樣式</h6>
                        <a class="dropdown-item" href="#" t-on-click="onResetStyle">
                            <i class="fa fa-eraser"/> 移除所有樣式
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-mouse-pointer"/> 選取</h6>
                        <a class="dropdown-item o_mindmap_btn_multiselect" href="#" t-on-click="onToggleMultiSelect">
                            <i class="fa fa-object-group"/> 多選模式
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onSelectSiblings">
                            <i class="fa fa-users"/> 選取同層主題
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onSelectChildren">
                            <i class="fa fa-level-down"/> 選取子主題
                        </a>
                    </div>
                </div>

                <!-- Group 7b: 專案整合按鈕已移到工具列下方的 o_mindmap_project_bar -->

                <!-- Group 8: Structure / Theme selectors (Mind map: Window > Properties panels) -->
                <div class="btn-group me-2">
                    <select class="form-control form-control-sm o_mindmap_layout_select" title="結構" t-on-change="onLayoutChange">
                        <option value="map">心智圖</option>
                        <option value="org_chart_down">組織圖 (向下)</option>
                        <option value="org_chart_up">組織圖 (向上)</option>
                        <option value="tree_right">樹狀圖 (向右)</option>
                        <option value="tree_left">樹狀圖 (向左)</option>
                        <option value="logic_right">邏輯圖 (向右)</option>
                        <option value="logic_left">邏輯圖 (向左)</option>
                        <option value="timeline_horizontal">時間軸 - 水平</option>
                        <option value="timeline_vertical">時間軸 - 垂直</option>
                        <option value="fishbone_right">魚骨圖 (頭向左)</option>
                        <option value="fishbone_left">魚骨圖 (頭向右)</option>
                        <option value="matrix_vertical">表格圖 (橫列)</option>
                        <option value="matrix_horizontal">表格圖 (直行)</option>
                    </select>
                </div>

                <div class="btn-group me-2">
                    <select class="form-control form-control-sm o_mindmap_theme_select" title="主題色" t-on-change="onThemeChange">
                        <option value="primary">主色</option>
                        <option value="warning">警告</option>
                        <option value="danger">危險</option>
                        <option value="success">成功</option>
                        <option value="info">資訊</option>
                        <option value="greensea">碧海綠</option>
                        <option value="nephrite">翡翠綠</option>
                        <option value="belizehole">貝里斯藍</option>
                        <option value="wisteria">紫藤紫</option>
                        <option value="asphalt">瀝青灰</option>
                        <option value="orange">橙色</option>
                        <option value="pumpkin">南瓜橘</option>
                        <option value="pomegranate">石榴紅</option>
                    </select>
                </div>

                <!-- 縮放%、指令數、選取數皆移至下方狀態列右側（縮放控制左邊）；
                     匯出SVG 已移到 Group 1。工具列右側不再放計數。 -->

                <!-- 右上角：仿 Odoo control panel 的 view 切換 + pager（在可讀心智圖間翻頁）。 -->
                <div class="o_mindmap_topright ms-auto d-flex align-items-center gap-2">
                    <div class="o_mindmap_view_switcher btn-group btn-group-sm">
                        <button class="btn btn-light active" disabled="disabled" title="心智圖">
                            <i class="fa fa-sitemap"/>
                        </button>
                        <button class="btn btn-light" t-on-click="onOpenForm" title="以表單開啟">
                            <i class="fa fa-list-alt"/>
                        </button>
                    </div>
                    <MindmapPager workbookId="workbookId" onNavigate.bind="_navigateToRecord"/>
                </div>
            </div>

            <!-- Project bar：位於工具列下方。可編輯的專案/客戶（子元件 MindmapProjectBar，
                 客戶/專案 AutoComplete、依客戶過濾專案、有專案客戶轉唯讀）。建立/同步專案
                 已移到上方工具列 Group 1 的 icon 按鈕。 -->
            <div class="o_mindmap_project_bar d-flex align-items-center flex-wrap gap-3 px-2 py-1" t-if="!readonly">
                <MindmapProjectBar workbookId="workbookId"
                    onOpenProject.bind="onOpenProject"
                    onProjectChanged.bind="_onProjectBarChanged"
                    registerApi.bind="_registerProjectBarApi"/>
            </div>

            <!-- Sidebar for Properties -->
            <div class="o_mindmap_sidebar" t-ref="sidebar" t-if="!readonly">
                <div class="o_mindmap_sidebar_header">
                    <h5>主題屬性</h5>
                    <button class="btn btn-sm btn-link o_mindmap_sidebar_close" t-on-click="onSidebarClose">
                        <i class="fa fa-times"/>
                    </button>
                </div>
                <div class="o_mindmap_sidebar_content">
                    <!-- Child Structure Layout -->
                    <div class="mb-3">
                        <label>
                            <i class="fa fa-sitemap text-primary"/> 子主題結構
                        </label>
                        <select class="form-control form-control-sm o_topic_child_structure" t-on-change="onTopicChildStructureChange">
                            <option value="">繼承 (預設)</option>
                            <option value="map">心智圖</option>
                            <option value="org_chart_down">組織圖 (向下)</option>
                            <option value="org_chart_up">組織圖 (向上)</option>
                            <option value="tree_right">樹狀圖 (向右)</option>
                            <option value="tree_left">樹狀圖 (向左)</option>
                            <option value="logic_right">邏輯圖 (向右)</option>
                            <option value="logic_left">邏輯圖 (向左)</option>
                            <option value="timeline_horizontal">時間軸 - 水平</option>
                            <option value="timeline_vertical">時間軸 - 垂直</option>
                            <option value="fishbone_right">魚骨圖 (頭向左)</option>
                            <option value="fishbone_left">魚骨圖 (頭向右)</option>
                        </select>
                    </div>

                    <!-- Hyperlink Section -->
                    <div class="mb-3">
                        <label>
                            <i class="fa fa-link text-primary"/> 超連結
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="url" class="form-control o_topic_hyperlink" placeholder="https://..." t-on-change="onTopicHyperlinkChange"/>
                            <button class="btn btn-outline-primary o_topic_hyperlink_open" type="button" title="開啟連結" t-on-click="onOpenHyperlink">
                                <i class="fa fa-external-link"/>
                            </button>
                        </div>
                        <input type="text" class="form-control form-control-sm o_topic_hyperlink_title mt-1" placeholder="連結標題 (選填)" t-on-change="onTopicHyperlinkChange"/>
                    </div>

                    <!-- Task Info -->
                    <div class="mb-3 o_topic_task_section">
                        <label>
                            <i class="fa fa-tasks text-warning"/> 任務資訊
                        </label>
                        <div class="d-flex" style="gap:6px;">
                            <div style="flex:1;">
                                <span class="small text-muted">開始</span>
                                <input type="date" class="form-control form-control-sm o_topic_task_start" t-on-change="onTopicTaskChange"/>
                            </div>
                            <div style="flex:1;">
                                <span class="small text-muted">結束</span>
                                <input type="date" class="form-control form-control-sm o_topic_task_end" t-on-change="onTopicTaskChange"/>
                            </div>
                            <div style="flex:1;">
                                <span class="small text-muted">時間</span>
                                <input type="time" class="form-control form-control-sm o_topic_task_end_time" t-on-change="onTopicTaskChange"/>
                            </div>
                        </div>
                        <div class="mt-1">
                            <span class="small text-muted">進度：<span class="o_topic_task_progress_val">0%</span></span>
                            <input type="range" min="0" max="100" step="5" class="form-range o_topic_task_progress" t-on-input="onTopicTaskChange"/>
                        </div>
                        <input type="text" class="form-control form-control-sm o_topic_task_assignee mt-1" placeholder="指派對象" t-on-change="onTopicTaskChange"/>
                    </div>

                    <!-- Image/Attachment Preview -->
                    <div class="mb-3">
                        <label>
                            <i class="fa fa-image text-success"/> 圖片／附件
                        </label>
                        <div class="o_topic_image_preview" style="min-height: 60px; border: 1px dashed #ccc; border-radius: 4px; padding: 8px; text-align: center;">
                            <span class="text-muted">尚未附加圖片</span>
                        </div>
                        <button class="btn btn-sm btn-outline-success mt-1 o_topic_change_image" t-on-click="onChangeImage">
                            <i class="fa fa-upload"/> 更換圖片
                        </button>
                        <button class="btn btn-sm btn-outline-danger mt-1 o_topic_remove_image" style="display:none;" t-on-click="onRemoveImage">
                            <i class="fa fa-trash"/> 移除
                        </button>
                    </div>

                    <!-- Shape Type -->
                    <div class="mb-3">
                        <label>
                            <i class="fa fa-square-o text-secondary"/> 形狀類型
                        </label>
                        <select class="form-control form-control-sm o_topic_shape_type" t-on-change="onTopicShapeChange">
                            <option value="rectangle">矩形</option>
                            <option value="rounded" selected="selected">圓角矩形</option>
                            <option value="ellipse">橢圓</option>
                            <option value="circle">圓形</option>
                            <option value="diamond">菱形</option>
                            <option value="parallelogram">平行四邊形</option>
                            <option value="hexagon">六邊形</option>
                            <option value="cloud">雲朵</option>
                            <option value="underline">僅底線</option>
                            <option value="noBorder">無邊框</option>
                            <option value="stroke">筆畫圓</option>
                        </select>
                    </div>
                    <!-- Border Width -->
                    <div class="mb-3">
                        <label>
                            <i class="fa fa-square text-secondary"/> 邊框寬度
                        </label>
                        <select class="form-control form-control-sm o_topic_border_width" t-on-change="onTopicShapeChange">
                            <option value="1">細 (1px)</option>
                            <option value="2" selected="selected">標準 (2px)</option>
                            <option value="3">中等 (3px)</option>
                            <option value="4">粗 (4px)</option>
                        </select>
                    </div>
                    <!-- Connection Line Style -->
                    <div class="mb-3">
                        <label>
                            <i class="fa fa-code-fork text-info"/> 線型
                        </label>
                        <select class="form-control form-control-sm o_topic_line_type" t-on-change="onTopicBranchStyleChange">
                            <option value="curved">曲線</option>
                            <option value="straight">直線</option>
                            <option value="roundedElbow">圓角折線</option>
                            <option value="angular">直角折線</option>
                            <option value="none">無</option>
                        </select>
                    </div>
                    <!-- Connection Line Width -->
                    <div class="mb-3">
                        <label>
                            <i class="fa fa-minus text-info"/> 線寬
                        </label>
                        <select class="form-control form-control-sm o_topic_line_width" t-on-change="onTopicBranchStyleChange">
                            <option value="1" selected="selected">1px</option>
                            <option value="2">2px</option>
                            <option value="3">3px</option>
                            <option value="4">4px</option>
                            <option value="5">5px</option>
                        </select>
                    </div>
                    <!-- Numbering -->
                    <div class="mb-3">
                        <label>
                            <i class="fa fa-list-ol text-warning"/> 編號
                        </label>
                        <select class="form-control form-control-sm o_topic_numbering" t-on-change="onTopicNumberingChange">
                            <option value="none">無</option>
                            <option value="1">1, 2, 3...</option>
                            <option value="a">a, b, c...</option>
                            <option value="A">A, B, C...</option>
                            <option value="i">i, ii, iii...</option>
                            <option value="I">I, II, III...</option>
                            <option value="1.1">1.1, 1.2...</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>背景色</label>
                        <input type="color" class="form-control form-control-sm o_topic_bg_color" t-on-change="onTopicStyleChange"/>
                    </div>
                    <div class="mb-3">
                        <label>文字色</label>
                        <input type="color" class="form-control form-control-sm o_topic_text_color" value="#333333" t-on-change="onTopicStyleChange"/>
                    </div>
                    <div class="mb-3">
                        <label>字級</label>
                        <input type="number" class="form-control form-control-sm o_topic_font_size" min="10" max="36" value="14" t-on-change="onTopicStyleChange"/>
                    </div>
                    <div class="mb-3">
                        <label>字重</label>
                        <select class="form-control form-control-sm o_topic_font_weight" t-on-change="onTopicStyleChange">
                            <option value="normal">標準</option>
                            <option value="bold">粗體</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>
                            <i class="fa fa-sticky-note text-info"/> 備註
                        </label>
                        <textarea class="form-control form-control-sm o_topic_note" rows="4" placeholder="在此新增備註..." t-on-change="onTopicNoteChange" t-on-input="onTopicNoteInput"></textarea>
                        <small class="text-muted o_topic_note_count">0 字元</small>
                    </div>
                    <div class="mb-3">
                        <label>標籤 (以逗號分隔)</label>
                        <input type="text" class="form-control form-control-sm o_topic_labels" t-on-change="onTopicPropertyChange"/>
                    </div>
                    <div class="mb-3">
                        <label>標記</label>
                        <div class="o_topic_markers"></div>
                    </div>

                    <!-- Attachments List -->
                    <div class="mb-3">
                        <label>
                            <i class="fa fa-paperclip text-secondary"/> 附件
                        </label>
                        <div class="o_topic_attachments" style="max-height: 150px; overflow-y: auto;">
                            <small class="text-muted">無附件</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Canvas -->
            <div class="o_mindmap_canvas" t-ref="canvas">
                <div id="jsmind_container" t-ref="jsmindContainer" style="width:100%;height:100%;"/>
            </div>

            <!-- Status Bar -->
            <div class="o_mindmap_statusbar" t-if="!readonly">
                <span class="o_mindmap_status_text">就緒</span>
                <span class="o_mindmap_autosave_indicator"></span>
                <span class="o_mindmap_status_spacer"/>
                <span class="o_mindmap_status_counts">
                    <span class="o_mindmap_topic_count" title="主題數">0 個主題</span>
                    <span class="o_mindmap_command_count" title="指令數（可復原步數）">  ·  0 個指令</span>
                    <span class="o_mindmap_selection_count"></span>
                </span>
                <span class="o_mindmap_zoom_control">
                    <button type="button" class="o_mindmap_zoom_btn" title="縮小" t-on-click="onZoomOut">−</button>
                    <input type="range" class="o_mindmap_zoom_slider" min="30" max="300" step="10" value="100"
                           title="縮放" t-on-input="onZoomSlider"/>
                    <button type="button" class="o_mindmap_zoom_btn" title="放大" t-on-click="onZoomIn">+</button>
                    <span class="o_mindmap_zoom_level" t-on-click="onZoomReset" title="點擊重設為 100%">100%</span>
                </span>
            </div>
        </div>
    </t>

    <!-- Dead templates removed: MarkerSelector, SummaryProperties, BoundaryProperties, RelationshipProperties -->
    <!-- All dialogs are now built with DOM in mindmap_editor.js -->

    <!-- Top-right record pager (reactive child of MindmapEditor; isolates the Odoo
         Pager widget from the non-reactive god-component). -->
    <t t-name="dobtor_xmind.MindmapPager">
        <Pager t-if="state.total"
               offset="state.offset" limit="1"
               total="state.total" onUpdate.bind="onPagerUpdate"
               withAccessKey="false"/>
    </t>

    <!-- Editable project/customer bar (reactive child of MindmapEditor). -->
    <t t-name="dobtor_xmind.MindmapProjectBar">
        <div class="o_mindmap_project_bar_inner d-flex align-items-center flex-wrap gap-3">
            <!-- 客戶：有專案 → 由專案帶入，唯讀顯示；無專案 → 可搜尋選填。 -->
            <div class="d-flex align-items-center gap-1">
                <i class="fa fa-building text-muted"/>
                <span class="small text-muted">客戶：</span>
                <t t-if="state.projectId">
                    <span class="small fw-bold" t-esc="state.partnerName or '—'"/>
                    <span class="small text-muted">（由專案帶入）</span>
                </t>
                <t t-else="">
                    <AutoComplete
                        value="state.partnerName"
                        sources="partnerSources"
                        onSelect.bind="onSelectPartner"
                        placeholder="'搜尋客戶…'"
                        class="'o_mindmap_pb_ac'"/>
                    <button t-if="state.partnerId" class="btn btn-sm btn-link p-0 text-muted"
                            title="清除客戶" t-on-click="() => this.clearPartner()">
                        <i class="fa fa-times"/>
                    </button>
                </t>
            </div>
            <!-- 專案：可搜尋選填（依已選客戶過濾）；已選可開啟或清除。 -->
            <div class="d-flex align-items-center gap-1">
                <i class="fa fa-folder-open text-muted"/>
                <span class="small text-muted">專案：</span>
                <AutoComplete
                    value="state.projectName"
                    sources="projectSources"
                    onSelect.bind="onSelectProject"
                    placeholder="'搜尋專案…'"
                    class="'o_mindmap_pb_ac'"/>
                <button t-if="state.projectId" class="btn btn-sm btn-link p-0 text-muted"
                        title="開啟專案" t-on-click="onOpenProject">
                    <i class="fa fa-external-link"/>
                </button>
                <button t-if="state.projectId" class="btn btn-sm btn-link p-0 text-muted"
                        title="清除專案" t-on-click="() => this.clearProject()">
                    <i class="fa fa-times"/>
                </button>
            </div>
            <!-- 關聯物件：嵌入此圖的記錄名稱。 -->
            <span t-if="embedsLabel" class="small text-muted">
                關聯物件：<span t-esc="embedsLabel"/>
            </span>
        </div>
    </t>
</templates>
