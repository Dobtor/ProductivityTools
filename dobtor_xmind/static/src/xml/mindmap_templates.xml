<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="dobtor_xmind.MindmapEditor">
        <div class="o_mindmap_editor_container">
            <!-- Toolbar: XMind 2 layout -->
            <div class="o_mindmap_toolbar">

                <!-- Group 1: Home / Save / Undo / Redo (XMind 2: Dashboard toolbar) -->
                <div class="btn-group me-2">
                    <button class="btn btn-sm btn-outline-success o_mindmap_btn_save" title="Save (Ctrl+S)" t-on-click="onSave">
                        <i class="fa fa-save"/>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary o_mindmap_btn_undo" title="Undo (Ctrl+Z)" disabled="disabled" t-on-click="onUndo">
                        <i class="fa fa-undo"/>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary o_mindmap_btn_redo" title="Redo (Ctrl+Y)" disabled="disabled" t-on-click="onRedo">
                        <i class="fa fa-repeat"/>
                    </button>
                </div>

                <!-- Group 2: Topic dropdown (XMind 2: Topic + Subtopic + Before + Parent) -->
                <div class="btn-group me-2">
                    <button class="btn btn-sm btn-outline-primary o_mindmap_btn_add_child" title="Add Subtopic (Tab)" t-on-click="onAddChild">
                        <i class="fa fa-plus"/>
                    </button>
                    <button class="btn btn-sm btn-outline-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" title="More topic options"/>
                    <div class="dropdown-menu">
                        <a class="dropdown-item" href="#" t-on-click="onAddSibling">
                            <i class="fa fa-plus text-primary"/> Topic (Enter)
                        </a>
                        <a class="dropdown-item o_mindmap_btn_add_child" href="#" t-on-click="onAddChild">
                            <i class="fa fa-level-down text-primary"/> Subtopic (Tab)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onAddTopicBefore">
                            <i class="fa fa-level-up text-primary"/> Topic Before (Shift+Enter)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onAddParentTopic">
                            <i class="fa fa-outdent text-primary"/> Parent Topic (Ctrl+Enter)
                        </a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item o_mindmap_btn_floating" href="#" t-on-click="onAddFloatingTopic">
                            <i class="fa fa-plus-circle text-muted"/> Floating Topic
                        </a>
                        <a class="dropdown-item o_mindmap_btn_callout" href="#" t-on-click="onAddCallout">
                            <i class="fa fa-comment text-warning"/> Callout
                        </a>
                    </div>
                </div>

                <!-- Group 3: Relationship / Boundary / Summary (XMind 2: mindmap toolbar group) -->
                <div class="btn-group me-2">
                    <button class="btn btn-sm btn-outline-secondary o_mindmap_btn_relationship" title="Relationship" t-on-click="onAddRelationship">
                        <i class="fa fa-link"/>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary o_mindmap_btn_boundary" title="Boundary" t-on-click="onAddBoundary">
                        <i class="fa fa-square-o"/>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary o_mindmap_btn_summary" title="Summary" t-on-click="onAddSummary">
                        <i class="fa fa-indent"/>
                    </button>
                </div>

                <!-- Group 4: Insert dropdown (XMind 2: Markers + Notes + Label + Hyperlink + Image + Attachment) -->
                <div class="btn-group me-2">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="Insert">
                        <i class="fa fa-plus"/> Insert
                    </button>
                    <div class="dropdown-menu">
                        <a class="dropdown-item o_mindmap_btn_marker" href="#" t-on-click="onOpenMarker">
                            <i class="fa fa-flag text-warning"/> Marker
                        </a>
                        <a class="dropdown-item o_mindmap_btn_note" href="#" t-on-click="onOpenNote">
                            <i class="fa fa-sticky-note text-info"/> Notes
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onInsertHyperlink">
                            <i class="fa fa-link text-primary"/> Hyperlink
                        </a>
                        <a class="dropdown-item o_mindmap_insert_image" href="#" t-on-click="onInsertImage">
                            <i class="fa fa-image text-success"/> Image
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onInsertComment">
                            <i class="fa fa-comments text-muted"/> Comments
                        </a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item o_mindmap_insert_attachment" href="#" t-on-click="onInsertAttachment">
                            <i class="fa fa-paperclip text-secondary"/> Attachment
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onInsertNote">
                            <i class="fa fa-tag text-info"/> Label
                        </a>
                    </div>
                </div>

                <!-- Group 5: Format dropdown (XMind 2: Properties panel - Shape/Text/Branch) -->
                <div class="btn-group me-2">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="Format">
                        <i class="fa fa-paint-brush"/> Format
                    </button>
                    <div class="dropdown-menu o_format_menu" style="min-width: 280px;">
                        <!-- Shape Style Section -->
                        <h6 class="dropdown-header">
                            <i class="fa fa-square"/> Shape Style
                        </h6>
                        <div class="px-3 py-1">
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Shape Type</label>
                                <select class="form-control form-control-sm o_format_shape_type">
                                    <option value="rectangle">Rectangle</option>
                                    <option value="rounded" selected="selected">Rounded Rectangle</option>
                                    <option value="ellipse">Ellipse</option>
                                    <option value="circle">Circle</option>
                                    <option value="diamond">Diamond</option>
                                    <option value="parallelogram">Parallelogram</option>
                                    <option value="hexagon">Hexagon</option>
                                    <option value="cloud">Cloud</option>
                                    <option value="underline">Underline Only</option>
                                    <option value="noBorder">No Border</option>
                                    <option value="stroke">Stroke Circle</option>
                                    <option value="fishhead_left">Fishhead Left</option>
                                    <option value="fishhead_right">Fishhead Right</option>
                                </select>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Fill Color</label>
                                <input type="color" class="form-control form-control-sm o_format_fill_color" value="#DCE6F2"/>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Border Color</label>
                                <input type="color" class="form-control form-control-sm o_format_border_color" value="#558ED5"/>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Border Width</label>
                                <select class="form-control form-control-sm o_format_border_width">
                                    <option value="1">Thin (1px)</option>
                                    <option value="2" selected="selected">Normal (2px)</option>
                                    <option value="3">Medium (3px)</option>
                                    <option value="4">Thick (4px)</option>
                                </select>
                            </div>
                        </div>

                        <div class="dropdown-divider"></div>

                        <!-- Text Style Section -->
                        <h6 class="dropdown-header">
                            <i class="fa fa-font"/> Text Style
                        </h6>
                        <div class="px-3 py-1">
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Font Family</label>
                                <select class="form-control form-control-sm o_format_font_family">
                                    <option value="inherit">Default</option>
                                    <option value="Arial, sans-serif">Arial</option>
                                    <option value="'Helvetica Neue', Helvetica, sans-serif">Helvetica</option>
                                    <option value="'Times New Roman', Times, serif">Times New Roman</option>
                                    <option value="Georgia, serif">Georgia</option>
                                    <option value="'Courier New', Courier, monospace">Courier New</option>
                                    <option value="Verdana, sans-serif">Verdana</option>
                                    <option value="'Trebuchet MS', sans-serif">Trebuchet MS</option>
                                </select>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Font Size</label>
                                <select class="form-control form-control-sm o_format_font_size">
                                    <option value="10">10px</option>
                                    <option value="12">12px</option>
                                    <option value="14" selected="selected">14px</option>
                                    <option value="16">16px</option>
                                    <option value="18">18px</option>
                                    <option value="20">20px</option>
                                    <option value="24">24px</option>
                                    <option value="28">28px</option>
                                    <option value="32">32px</option>
                                </select>
                            </div>
                            <div class="btn-group btn-group-sm mb-2" role="group">
                                <button class="btn btn-outline-secondary o_format_bold" title="Bold" t-on-click="onFormatBold">
                                    <i class="fa fa-bold"/>
                                </button>
                                <button class="btn btn-outline-secondary o_format_italic" title="Italic" t-on-click="onFormatItalic">
                                    <i class="fa fa-italic"/>
                                </button>
                                <button class="btn btn-outline-secondary o_format_underline" title="Underline" t-on-click="onFormatUnderline">
                                    <i class="fa fa-underline"/>
                                </button>
                                <button class="btn btn-outline-secondary o_format_strikethrough" title="Strikethrough" t-on-click="onFormatStrikethrough">
                                    <i class="fa fa-strikethrough"/>
                                </button>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Text Alignment</label>
                                <div class="btn-group btn-group-sm d-flex">
                                    <button class="btn btn-outline-secondary" title="Align Left" t-on-click="onTextAlignLeft"><i class="fa fa-align-left"/></button>
                                    <button class="btn btn-outline-secondary" title="Align Center" t-on-click="onTextAlignCenter"><i class="fa fa-align-center"/></button>
                                    <button class="btn btn-outline-secondary" title="Align Right" t-on-click="onTextAlignRight"><i class="fa fa-align-right"/></button>
                                </div>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Text Color</label>
                                <input type="color" class="form-control form-control-sm o_format_text_color" value="#17375E"/>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Background Color</label>
                                <input type="color" class="form-control form-control-sm o_format_bg_color" value="#ffffff"/>
                            </div>
                        </div>

                        <div class="dropdown-divider"></div>

                        <!-- Structure Section -->
                        <h6 class="dropdown-header">
                            <i class="fa fa-sitemap"/> Structure
                        </h6>
                        <div class="px-3 py-1">
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Layout Type</label>
                                <select class="form-control form-control-sm o_format_structure_type" t-on-change="onFormatStructureChange">
                                    <option value="map">Mind Map (Balanced)</option>
                                    <option value="tree_right">Tree Right</option>
                                    <option value="tree_left">Tree Left</option>
                                    <option value="logic_right">Logic Right</option>
                                    <option value="logic_left">Logic Left</option>
                                    <option value="org_chart_down">Org Chart Down</option>
                                    <option value="org_chart_up">Org Chart Up</option>
                                    <option value="fishbone_left">Fishbone Left</option>
                                    <option value="fishbone_right">Fishbone Right</option>
                                </select>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Horizontal Spacing</label>
                                <input type="range" class="form-range o_format_h_space" min="30" max="150" value="80" t-on-input="onFormatHSpaceChange"/>
                                <small class="text-muted o_format_h_space_val">80px</small>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Vertical Spacing</label>
                                <input type="range" class="form-range o_format_v_space" min="10" max="80" value="25" t-on-input="onFormatVSpaceChange"/>
                                <small class="text-muted o_format_v_space_val">25px</small>
                            </div>
                        </div>

                        <div class="dropdown-divider"></div>

                        <!-- Branch Style Section -->
                        <h6 class="dropdown-header">
                            <i class="fa fa-code-fork"/> Branch Style
                        </h6>
                        <div class="px-3 py-1">
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Line Type</label>
                                <select class="form-control form-control-sm o_format_line_type">
                                    <option value="curved">Curved</option>
                                    <option value="straight">Straight</option>
                                    <option value="angular">Angular</option>
                                    <option value="rounded">Rounded</option>
                                </select>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Line Width</label>
                                <select class="form-control form-control-sm o_format_line_width">
                                    <option value="1">Thin (1px)</option>
                                    <option value="2" selected="selected">Normal (2px)</option>
                                    <option value="3">Medium (3px)</option>
                                    <option value="4">Thick (4px)</option>
                                    <option value="5">Extra Thick (5px)</option>
                                </select>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Line Color</label>
                                <input type="color" class="form-control form-control-sm o_format_line_color" value="#558ED5"/>
                            </div>
                            <div class="mb-3 mb-2">
                                <label class="small mb-1">Line Style</label>
                                <select class="form-control form-control-sm o_format_line_style">
                                    <option value="solid">Solid</option>
                                    <option value="dashed">Dashed</option>
                                    <option value="dotted">Dotted</option>
                                </select>
                            </div>
                        </div>

                        <div class="dropdown-divider"></div>

                        <div class="px-3 py-1">
                            <button class="btn btn-sm btn-primary w-100 o_format_apply" t-on-click="onFormatApply">
                                <i class="fa fa-check"/> Apply to Selected
                            </button>
                            <button class="btn btn-sm btn-outline-secondary w-100 mt-1 o_format_apply_all" t-on-click="onFormatApplyAll">
                                <i class="fa fa-globe"/> Apply to All
                            </button>
                            <button class="btn btn-sm btn-outline-warning w-100 mt-1 o_format_reset" t-on-click="onFormatReset">
                                <i class="fa fa-undo"/> Reset to Default
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Group 6: View dropdown (XMind 2: View menu — Zoom / Drill / Expand / Overview / Outline) -->
                <div class="btn-group me-2">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="View">
                        <i class="fa fa-eye"/> View
                    </button>
                    <div class="dropdown-menu">
                        <h6 class="dropdown-header"><i class="fa fa-search"/> Zoom</h6>
                        <a class="dropdown-item" href="#" t-on-click="onZoomIn">
                            <i class="fa fa-search-plus"/> Zoom In (Ctrl++)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onZoomOut">
                            <i class="fa fa-search-minus"/> Zoom Out (Ctrl+-)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onZoomReset">
                            <i class="fa fa-compress"/> Actual Size
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onZoomFit">
                            <i class="fa fa-arrows-alt"/> Fit Map
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onZoomFitSelection">
                            <i class="fa fa-crosshairs"/> Fit Selection
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-sitemap"/> Navigate</h6>
                        <a class="dropdown-item" href="#" t-on-click="onDrillDown">
                            <i class="fa fa-arrow-circle-down"/> Drill Down
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onDrillUp">
                            <i class="fa fa-arrow-circle-up"/> Drill Up
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-toggle-on"/> Visibility</h6>
                        <a class="dropdown-item o_mindmap_btn_expand_all" href="#" t-on-click="onExpandAll">
                            <i class="fa fa-expand"/> Expand All
                        </a>
                        <a class="dropdown-item o_mindmap_btn_collapse_all" href="#" t-on-click="onCollapseAll">
                            <i class="fa fa-compress"/> Collapse All
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-columns"/> Panels</h6>
                        <a class="dropdown-item" href="#" t-on-click="onToggleOverview">
                            <i class="fa fa-eye"/> Overview
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onToggleOutline">
                            <i class="fa fa-list"/> Outline
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onToggleLegend">
                            <i class="fa fa-list-ul"/> Legend
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onToggleRevisions">
                            <i class="fa fa-history"/> Revisions
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-wrench"/> Tools</h6>
                        <a class="dropdown-item" href="#" t-on-click="onFindReplace">
                            <i class="fa fa-search"/> Find &amp; Replace (Ctrl+F)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onToggleNumbering">
                            <i class="fa fa-list-ol"/> Numbering
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onToggleTapering">
                            <i class="fa fa-long-arrow-right"/> Tapered Lines
                        </a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="#" t-on-click="onShowResourceManager">
                            <i class="fa fa-th-large"/> Resource Manager
                        </a>
                    </div>
                </div>

                <!-- Group 7: Modify dropdown (XMind 2: Modify menu — Edit/Sort/Align/Delete) -->
                <div class="btn-group me-2">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="Modify">
                        <i class="fa fa-pencil"/> Modify
                    </button>
                    <div class="dropdown-menu">
                        <h6 class="dropdown-header"><i class="fa fa-pencil"/> Edit</h6>
                        <a class="dropdown-item" href="#" t-on-click="onCutTopic">
                            <i class="fa fa-scissors"/> Cut (Ctrl+X)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onCopyTopic">
                            <i class="fa fa-copy"/> Copy (Ctrl+C)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onPasteTopic">
                            <i class="fa fa-paste"/> Paste (Ctrl+V)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onDuplicateTopic">
                            <i class="fa fa-files-o"/> Duplicate (Ctrl+D)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onDelete">
                            <i class="fa fa-trash text-danger"/> Delete (Del)
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-arrows-v"/> Position</h6>
                        <a class="dropdown-item" href="#" t-on-click="onMoveUp">
                            <i class="fa fa-arrow-up"/> Move Up (Alt+Up)
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onMoveDown">
                            <i class="fa fa-arrow-down"/> Move Down (Alt+Down)
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-eye"/> Visibility</h6>
                        <a class="dropdown-item" href="#" t-on-click="onExpandAll">
                            <i class="fa fa-expand"/> Expand All
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onCollapseAll">
                            <i class="fa fa-compress"/> Collapse All
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-sort"/> Sort</h6>
                        <a class="dropdown-item" href="#" t-on-click="onSortAscending">
                            <i class="fa fa-sort-alpha-asc"/> Sort A → Z
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onSortDescending">
                            <i class="fa fa-sort-alpha-desc"/> Sort Z → A
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onSortByPriority">
                            <i class="fa fa-sort-numeric-asc"/> Sort by Priority
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-paint-brush"/> Style</h6>
                        <a class="dropdown-item" href="#" t-on-click="onResetStyle">
                            <i class="fa fa-eraser"/> Remove All Styles
                        </a>
                        <div class="dropdown-divider"></div>
                        <h6 class="dropdown-header"><i class="fa fa-mouse-pointer"/> Selection</h6>
                        <a class="dropdown-item o_mindmap_btn_multiselect" href="#" t-on-click="onToggleMultiSelect">
                            <i class="fa fa-object-group"/> Multi-Select Mode
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onSelectSiblings">
                            <i class="fa fa-users"/> Select Siblings
                        </a>
                        <a class="dropdown-item" href="#" t-on-click="onSelectChildren">
                            <i class="fa fa-level-down"/> Select Children
                        </a>
                    </div>
                </div>

                <!-- Group 8: Structure / Theme selectors (XMind 2: Window > Properties panels) -->
                <div class="btn-group me-2">
                    <select class="form-control form-control-sm o_mindmap_layout_select" title="Structure" t-on-change="onLayoutChange">
                        <option value="map">Mind Map</option>
                        <option value="tree_right">Tree Right</option>
                        <option value="tree_left">Tree Left</option>
                        <option value="logic_right">Logic Right</option>
                        <option value="org_chart_down">Org Chart</option>
                        <option value="fishbone_right">Fishbone →</option>
                        <option value="fishbone_left">Fishbone ←</option>
                        <option value="matrix">Matrix</option>
                    </select>
                </div>

                <div class="btn-group me-2">
                    <select class="form-control form-control-sm o_mindmap_theme_select" title="Theme" t-on-change="onThemeChange">
                        <option value="primary">Primary</option>
                        <option value="warning">Warning</option>
                        <option value="danger">Danger</option>
                        <option value="success">Success</option>
                        <option value="info">Info</option>
                        <option value="greensea">Green Sea</option>
                        <option value="nephrite">Nephrite</option>
                        <option value="belizehole">Belize Hole</option>
                        <option value="wisteria">Wisteria</option>
                        <option value="asphalt">Asphalt</option>
                        <option value="orange">Orange</option>
                        <option value="pumpkin">Pumpkin</option>
                        <option value="pomegranate">Pomegranate</option>
                    </select>
                </div>

                <!-- Group 9: Zoom indicator + Export (XMind 2: Export toolbar) -->
                <div class="ms-auto d-flex align-items-center">
                    <span class="btn btn-sm btn-outline-secondary disabled o_mindmap_zoom_level me-1">100%</span>
                    <div class="btn-group me-2">
                        <button class="btn btn-sm btn-outline-secondary o_mindmap_btn_export dropdown-toggle" data-bs-toggle="dropdown" title="Export">
                            <i class="fa fa-download"/>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a class="dropdown-item" href="#" t-on-click="onExport">
                                <i class="fa fa-file-archive-o text-primary"/> Export .xmind
                            </a>
                            <a class="dropdown-item" href="#" t-on-click="onExportImage">
                                <i class="fa fa-image text-success"/> Export PNG
                            </a>
                            <a class="dropdown-item" href="#" t-on-click="onExportSVG">
                                <i class="fa fa-code text-info"/> Export SVG
                            </a>
                            <a class="dropdown-item" href="#" t-on-click="onExportPDF">
                                <i class="fa fa-file-pdf-o text-danger"/> Export PDF
                            </a>
                        </div>
                    </div>
                    <span class="badge text-bg-info me-1 o_mindmap_selection_count" style="display:none;">
                        <i class="fa fa-check-square"/> <span class="count">0</span>
                    </span>
                    <span class="badge text-bg-secondary o_mindmap_command_count">0 commands</span>
                </div>
            </div>

            <!-- Sidebar for Properties -->
            <div class="o_mindmap_sidebar" t-ref="sidebar">
                <div class="o_mindmap_sidebar_header">
                    <h5>Topic Properties</h5>
                    <button class="btn btn-sm btn-link o_mindmap_sidebar_close" t-on-click="onSidebarClose">
                        <i class="fa fa-times"/>
                    </button>
                </div>
                <div class="o_mindmap_sidebar_content">
                    <div class="mb-3">
                        <label>Title</label>
                        <input type="text" class="form-control form-control-sm o_topic_title" t-on-change="onTopicPropertyChange"/>
                    </div>

                    <!-- Hyperlink Section -->
                    <div class="mb-3">
                        <label>
                            <i class="fa fa-link text-primary"/> Hyperlink
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="url" class="form-control o_topic_hyperlink" placeholder="https://..." t-on-change="onTopicHyperlinkChange"/>
                            <button class="btn btn-outline-primary o_topic_hyperlink_open" type="button" title="Open Link" t-on-click="onOpenHyperlink">
                                <i class="fa fa-external-link"/>
                            </button>
                        </div>
                        <input type="text" class="form-control form-control-sm o_topic_hyperlink_title mt-1" placeholder="Link Title (optional)" t-on-change="onTopicHyperlinkChange"/>
                    </div>

                    <!-- Image/Attachment Preview -->
                    <div class="mb-3">
                        <label>
                            <i class="fa fa-image text-success"/> Image/Attachment
                        </label>
                        <div class="o_topic_image_preview" style="min-height: 60px; border: 1px dashed #ccc; border-radius: 4px; padding: 8px; text-align: center;">
                            <span class="text-muted">No image attached</span>
                        </div>
                        <button class="btn btn-sm btn-outline-success mt-1 o_topic_change_image" t-on-click="onChangeImage">
                            <i class="fa fa-upload"/> Change Image
                        </button>
                        <button class="btn btn-sm btn-outline-danger mt-1 o_topic_remove_image" style="display:none;" t-on-click="onRemoveImage">
                            <i class="fa fa-trash"/> Remove
                        </button>
                    </div>

                    <div class="mb-3">
                        <label>Background Color</label>
                        <input type="color" class="form-control form-control-sm o_topic_bg_color" t-on-change="onTopicStyleChange"/>
                    </div>
                    <div class="mb-3">
                        <label>Text Color</label>
                        <input type="color" class="form-control form-control-sm o_topic_text_color" value="#333333" t-on-change="onTopicStyleChange"/>
                    </div>
                    <div class="mb-3">
                        <label>Font Size</label>
                        <input type="number" class="form-control form-control-sm o_topic_font_size" min="10" max="36" value="14" t-on-change="onTopicStyleChange"/>
                    </div>
                    <div class="mb-3">
                        <label>Font Weight</label>
                        <select class="form-control form-control-sm o_topic_font_weight" t-on-change="onTopicStyleChange">
                            <option value="normal">Normal</option>
                            <option value="bold">Bold</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>
                            <i class="fa fa-sticky-note text-info"/> Notes
                        </label>
                        <textarea class="form-control form-control-sm o_topic_note" rows="4" placeholder="Add notes here..." t-on-change="onTopicNoteChange" t-on-input="onTopicNoteInput"></textarea>
                        <small class="text-muted o_topic_note_count">0 characters</small>
                    </div>
                    <div class="mb-3">
                        <label>Labels (comma separated)</label>
                        <input type="text" class="form-control form-control-sm o_topic_labels" t-on-change="onTopicPropertyChange"/>
                    </div>
                    <div class="mb-3">
                        <label>Markers</label>
                        <div class="o_topic_markers"></div>
                    </div>

                    <!-- Attachments List -->
                    <div class="mb-3">
                        <label>
                            <i class="fa fa-paperclip text-secondary"/> Attachments
                        </label>
                        <div class="o_topic_attachments" style="max-height: 150px; overflow-y: auto;">
                            <small class="text-muted">No attachments</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Canvas -->
            <div class="o_mindmap_canvas" t-ref="canvas">
                <div id="jsmind_container" t-ref="jsmindContainer" style="width:100%;height:100%;"/>
            </div>

            <!-- Status Bar -->
            <div class="o_mindmap_statusbar">
                <span class="o_mindmap_status_text">Ready</span>
                <span class="o_mindmap_autosave_indicator"></span>
            </div>
        </div>
    </t>

    <!-- Dead templates removed: MarkerSelector, SummaryProperties, BoundaryProperties, RelationshipProperties -->
    <!-- All dialogs are now built with DOM in mindmap_editor.js -->
</templates>
