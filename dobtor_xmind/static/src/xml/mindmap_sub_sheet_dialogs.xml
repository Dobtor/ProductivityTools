<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dobtor_xmind.SubSheetCreateDialog">
        <Dialog title="title" size="'md'">
            <div class="o_xmind_subsheet_dialog">
                <div class="list-group mb-3">
                    <div t-foreach="state.rows" t-as="row" t-key="row.key"
                         class="list-group-item d-flex align-items-center gap-2 o_xmind_subsheet_row">
                        <input type="checkbox" class="form-check-input mt-0"
                               t-att-checked="row.checked"
                               t-on-change="(ev) => { row.checked = ev.target.checked; }"/>
                        <div class="flex-grow-1 min-w-0">
                            <div class="small text-muted text-truncate" t-esc="row.title"/>
                            <input t-if="!row.existing" type="text"
                                   class="form-control form-control-sm o_xmind_subsheet_name"
                                   t-att-value="row.name"
                                   t-on-input="(ev) => { row.name = ev.target.value; }"/>
                            <div t-else="" class="small text-info o_xmind_subsheet_existing">
                                <i class="fa fa-external-link me-1"/>
                                <t t-esc="existingLabel(row)"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Mode</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="o_xmind_subsheet_mode"
                               id="o_xmind_subsheet_mode_extend"
                               t-att-checked="state.mode === 'extend' or !canSplit"
                               t-on-change="() => { state.mode = 'extend'; }"/>
                        <label class="form-check-label" for="o_xmind_subsheet_mode_extend">
                            Extend — a new empty sheet whose central topic mirrors the topic
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="o_xmind_subsheet_mode"
                               id="o_xmind_subsheet_mode_split"
                               t-att-disabled="!canSplit"
                               t-att-checked="state.mode === 'split' and canSplit"
                               t-on-change="() => { state.mode = 'split'; }"/>
                        <label class="form-check-label" for="o_xmind_subsheet_mode_split">
                            Split out — move the topic's existing subtopics into the new sheet
                        </label>
                    </div>
                </div>
                <div class="mb-1">
                    <label class="form-label fw-bold" for="o_xmind_subsheet_layout">Layout</label>
                    <select class="form-select form-select-sm" id="o_xmind_subsheet_layout"
                            t-on-change="(ev) => { state.layout = ev.target.value; }">
                        <option t-foreach="layouts" t-as="layout" t-key="layout.id"
                                t-att-value="layout.id"
                                t-att-selected="layout.id === state.layout">
                            <t t-esc="layout.name"/>
                        </option>
                    </select>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary o_xmind_subsheet_confirm"
                        t-att-disabled="!canConfirm" t-on-click="onConfirm">
                    <t t-esc="confirmLabel"/>
                </button>
                <button class="btn btn-secondary" t-on-click="() => props.close()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="dobtor_xmind.SheetTopicPickerDialog">
        <Dialog title="props.title" size="'md'">
            <div class="o_xmind_sheet_topic_picker">
                <p t-if="props.help" class="text-muted small" t-esc="props.help"/>
                <label class="form-label fw-bold" for="o_xmind_picker_sheet">Sheet</label>
                <select class="form-select form-select-sm mb-3 o_xmind_picker_sheet"
                        id="o_xmind_picker_sheet" t-on-change="onSheetChange">
                    <option t-foreach="props.sheets" t-as="sheet" t-key="sheet.id"
                            t-att-value="sheet.id" t-att-selected="sheet.id === state.sheetId">
                        <t t-esc="sheetLabel(sheet)"/>
                    </option>
                </select>
                <label class="form-label fw-bold">Topic</label>
                <div t-if="state.loading" class="text-center text-muted p-3">
                    <i class="fa fa-spinner fa-spin"/>
                </div>
                <div t-elif="!state.topics.length" class="text-muted p-2" t-esc="emptyLabel"/>
                <div t-else="" class="list-group o_xmind_picker_topics"
                     style="max-height: 320px; overflow-y: auto;">
                    <button t-foreach="state.topics" t-as="topic" t-key="topic.id" type="button"
                            t-att-class="'list-group-item list-group-item-action py-1 o_xmind_picker_topic'
                                + (isSelected(topic) ? ' active' : '')"
                            t-att-disabled="isDisabled(topic)"
                            t-att-style="topicIndent(topic)"
                            t-on-click="() => this.selectTopic(topic)">
                        <i t-if="!topic.depth" class="fa fa-dot-circle-o me-1"/>
                        <t t-esc="topic.title"/>
                    </button>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary o_xmind_picker_confirm"
                        t-att-disabled="!canConfirm" t-on-click="onConfirm">
                    <t t-esc="confirmText"/>
                </button>
                <button class="btn btn-secondary" t-on-click="() => props.close()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

</templates>
