/**
 * jsMind Core Styles
 * Open Source Mind Mapping Library
 */

/* Container */
.jsmind-inner {
    position: relative;
    overflow: auto;
    width: 100%;
    height: 100%;
}

/* Nodes Container */
.jmnodes {
    position: absolute;
    width: 100%;
    height: 100%;
    background: transparent;
    z-index: 2;
}

/* Node */
.jmnode {
    position: absolute;
    cursor: pointer;
    padding: 6px 12px;
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
    font-size: 14px;
    white-space: nowrap;
    transition: box-shadow 0.2s ease;
}

.jmnode:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

.jmnode.selected {
    background-color: #428bca;
    color: #ffffff;
    border-color: #357ebd;
}

.jmnode.root {
    font-size: 16px;
    font-weight: bold;
    padding: 10px 20px;
}

/* Expander Button */
.jmexpander {
    position: absolute;
    width: 16px;
    height: 16px;
    background-color: #ffffff;
    border: 1px solid #aaa;
    border-radius: 50%;
    cursor: pointer;
    font-size: 10px;
    line-height: 14px;
    text-align: center;
    z-index: 3;
    display: inline-block;
}

.jmexpander:hover {
    background-color: #f0f0f0;
}

/* Canvas for lines */
canvas.jsmind {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
}

/* Edit Input */
input.jmnode-input {
    position: absolute;
    z-index: 10;
    border: 2px solid #428bca;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 14px;
    outline: none;
    box-shadow: 0 0 10px rgba(66, 139, 202, 0.5);
}

/* Theme: Primary */
jmnodes.theme-primary jmnode {
    background-color: #428bca;
    color: #ffffff;
    border-color: #357ebd;
}

jmnodes.theme-primary jmnode.selected {
    background-color: #2a6496;
    border-color: #1f4f75;
}

/* Theme: Warning */
jmnodes.theme-warning jmnode {
    background-color: #f0ad4e;
    color: #ffffff;
    border-color: #eea236;
}

jmnodes.theme-warning jmnode.selected {
    background-color: #ec971f;
    border-color: #d58512;
}

/* Theme: Danger */
jmnodes.theme-danger jmnode {
    background-color: #d9534f;
    color: #ffffff;
    border-color: #d43f3a;
}

jmnodes.theme-danger jmnode.selected {
    background-color: #c9302c;
    border-color: #ac2925;
}

/* Theme: Success */
jmnodes.theme-success jmnode {
    background-color: #5cb85c;
    color: #ffffff;
    border-color: #4cae4c;
}

jmnodes.theme-success jmnode.selected {
    background-color: #449d44;
    border-color: #398439;
}

/* Theme: Info */
jmnodes.theme-info jmnode {
    background-color: #5bc0de;
    color: #ffffff;
    border-color: #46b8da;
}

jmnodes.theme-info jmnode.selected {
    background-color: #31b0d5;
    border-color: #269abc;
}

/* Theme: Greensea */
jmnodes.theme-greensea jmnode {
    background-color: #16a085;
    color: #ffffff;
    border-color: #138d75;
}

/* Theme: Nephrite */
jmnodes.theme-nephrite jmnode {
    background-color: #27ae60;
    color: #ffffff;
    border-color: #229954;
}

/* Theme: Belizehole */
jmnodes.theme-belizehole jmnode {
    background-color: #2980b9;
    color: #ffffff;
    border-color: #2471a3;
}

/* Theme: Wisteria */
jmnodes.theme-wisteria jmnode {
    background-color: #8e44ad;
    color: #ffffff;
    border-color: #7d3c98;
}

/* Theme: Asphalt */
jmnodes.theme-asphalt jmnode {
    background-color: #34495e;
    color: #ffffff;
    border-color: #2c3e50;
}

/* Theme: Orange */
jmnodes.theme-orange jmnode {
    background-color: #f39c12;
    color: #ffffff;
    border-color: #d68910;
}

/* Theme: Pumpkin */
jmnodes.theme-pumpkin jmnode {
    background-color: #d35400;
    color: #ffffff;
    border-color: #ba4a00;
}

/* Theme: Pomegranate */
jmnodes.theme-pomegranate jmnode {
    background-color: #c0392b;
    color: #ffffff;
    border-color: #a93226;
}

/* Scrollbar Styling */
.jsmind-inner::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}

.jsmind-inner::-webkit-scrollbar-track {
    background: #f1f1f1;
}

.jsmind-inner::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 4px;
}

.jsmind-inner::-webkit-scrollbar-thumb:hover {
    background: #555;
}
