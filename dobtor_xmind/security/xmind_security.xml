<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Groups                                                        -->
    <!-- ============================================================ -->
    <record id="group_xmind_manager" model="res.groups">
        <field name="name">Mind Map Manager</field>
        <field name="comment">Can see and manage all mind maps.</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules                                                  -->
    <!--                                                               -->
    <!-- Access model (additive OR):                                   -->
    <!--   1. Standalone mind maps  → owner or follower (original).    -->
    <!--   2. Project-linked maps   → governed by the project's        -->
    <!--      privacy_visibility, identical to project's own rules:    -->
    <!--      visible when privacy != 'followers' OR the user follows  -->
    <!--      the project.                                             -->
    <!--   3. Mind Map Manager      → all mind maps.                   -->
    <!--   4. Project Administrator  → all PROJECT-LINKED mind maps.    -->
    <!-- ============================================================ -->

    <!-- ===== Workbook ===== -->
    <record id="rule_xmind_workbook_user" model="ir.rule">
        <field name="name">Mind Map: own/follower or via project visibility</field>
        <field name="model_id" ref="model_xmind_workbook"/>
        <field name="domain_force">['|', '|',
            ('create_uid', '=', user.id),
            ('message_partner_ids', 'in', [user.partner_id.id]),
            '&amp;', ('project_id', '!=', False),
                 '|', ('project_id.privacy_visibility', '!=', 'followers'),
                      ('project_id.message_partner_ids', 'in', [user.partner_id.id])
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_xmind_workbook_manager" model="ir.rule">
        <field name="name">Mind Map: manager sees all</field>
        <field name="model_id" ref="model_xmind_workbook"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_xmind_manager'))]"/>
    </record>
    <record id="rule_xmind_workbook_project_manager" model="ir.rule">
        <field name="name">Mind Map: project admin sees project-linked maps</field>
        <field name="model_id" ref="model_xmind_workbook"/>
        <field name="domain_force">[('project_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
    </record>

