<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_xmind_manager" model="res.groups">
        <field name="name">Mind Map Manager</field>
        <field name="comment">Can see and manage all mind maps.</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Access model (READ visibility keyed on Customer):
         * No customer (partner_id empty) → ONLY the owner (create_uid) can see it.
         * Has customer (partner_id set — whether picked manually or brought in from
           the linked project) → visible to every internal Mind Map user.
         WRITE/CREATE/UNLINK stay restricted to owner / map follower / project
         follower (unchanged). Mind Map Manager → all maps. Project Administrator →
         all project-linked. Child models mirror the workbook's partner_id/owner. -->

    <!-- ===== workbook ===== -->
    <record id="rule_xmind_workbook_read" model="ir.rule">
        <field name="name">Mind Map workbook: read (own/follower or project-visible)</field>
        <field name="model_id" ref="model_xmind_workbook"/>
        <field name="domain_force">['|',
            ('partner_id', '!=', False),
            ('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_xmind_workbook_write" model="ir.rule">
        <field name="name">Mind Map workbook: write (own/follower or project follower)</field>
        <field name="model_id" ref="model_xmind_workbook"/>
        <field name="domain_force">['|', '|',
            ('create_uid', '=', user.id),
            ('message_partner_ids', 'in', [user.partner_id.id]),
            ('project_id.message_partner_ids', 'in', [user.partner_id.id])
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_xmind_workbook_manager" model="ir.rule">
        <field name="name">Mind Map workbook: manager sees all</field>
        <field name="model_id" ref="model_xmind_workbook"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_xmind_manager'))]"/>
    </record>
    <record id="rule_xmind_workbook_project_manager" model="ir.rule">
        <field name="name">Mind Map workbook: project admin sees project-linked</field>
        <field name="model_id" ref="model_xmind_workbook"/>
        <field name="domain_force">[('project_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
    </record>

