<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ─── 範本列表 Action ─── -->
    <record id="action_doc_template_list" model="ir.actions.act_window">
        <field name="name">文件範本</field>
        <field name="res_model">doc.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一個文件範本
            </p>
        </field>
    </record>

    <!-- ─── 範本列表 View ─── -->
    <record id="view_doc_template_list" model="ir.ui.view">
        <field name="name">doc.template.list</field>
        <field name="model">doc.template</field>
        <field name="arch" type="xml">
            <list string="文件範本">
                <field name="name"/>
                <field name="category"/>
                <field name="model_id" optional="show"/>
                <field name="page_format" optional="show"/>
                <field name="signer_count" optional="show"/>
                <field name="field_count" optional="show"/>
                <field name="alias_count" optional="show" string="對映數"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ─── 範本表單 View ─── -->
    <record id="view_doc_template_form" model="ir.ui.view">
        <field name="name">doc.template.form</field>
        <field name="model">doc.template</field>
        <field name="arch" type="xml">
            <form string="文件範本">
                <header>
                    <button name="action_open_editor"
                            type="object"
                            string="開啟編輯器"
                            class="btn-primary"
                            icon="fa-edit"
                            help="直接在全螢幕編輯器中編輯此範本的版面與內容"/>
                    <!-- Phase 5（決策二）：alias 機制退場中，不再提供「新增對映」入口。
                         要加變數請開啟編輯器，從左欄「欄位」分頁拖曳模型欄位。
                         清空按鈕保留，供遷移後手動清理殘留資料。 -->
                    <button name="action_clear_aliases"
                            type="object"
                            string="清空對映"
                            icon="fa-trash"
                            confirm="確定清空所有對映？此操作不可復原。"
                            invisible="alias_count == 0"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="範本名稱" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category" string="分類"/>
                            <field name="model_id" string="適用模型"/>
                            <field name="page_format" string="預設頁面格式"/>
                            <field name="active" string="啟用"/>
                            <field name="company_id"
                                   string="公司"
                                   groups="base.group_multi_company"/>
                            <field name="version_number" string="版本號" readonly="1"/>
                        </group>
                        <group>
                            <field name="description" string="說明" widget="text"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="範本內容">
                            <div class="alert alert-warning mb-2" role="alert">
                                <i class="fa fa-edit me-1"/>
                                <strong>建議用上方「開啟編輯器」編輯版面。</strong>
                                編輯器以 Canvas JSON（<code>content_json</code>）為權威格式，
                                下方的 HTML 欄位是攤平備份；直接改 HTML 不會同步回 Canvas 版面。
                            </div>
                            <div class="alert alert-info mb-2" role="alert">
                                <strong>DOCX 模板語法說明</strong>
                                <ul class="mb-0 mt-1 small">
                                    <li>一般變數：<code>{{ 變數名稱 }}</code>（例：<code>{{ project_name }}</code>）</li>
                                    <li>表格列迴圈：<code>{% tr for item in items %}</code> … <code>{% tr endfor %}</code></li>
                                    <li>條件顯示：<code>{% if 條件 %}</code> … <code>{% endif %}</code></li>
                                    <li>⚠️ 舊語法 <code>+++INS 變數名稱+++</code> 上傳時自動轉換，無需手動修改</li>
                                    <li>⚠️ 在 Word 中輸入 <code>{{</code> 前，請關閉「自動更正彎引號」</li>
                                </ul>
                            </div>
                            <field name="content_html"
                                   widget="html"
                                   options="{'resizable': true}"
                                   style="min-height: 400px;"/>
                        </page>
                        <page string="簽約人角色 (Phase 8)">
                            <div class="alert alert-light mb-2" role="alert">
                                <i class="fa fa-info-circle me-1"/>
                                簽約人是「範本欄位」的填寫對象。在文件編輯器拖入欄位前，請先在此定義角色（例：房東 / 業務 / 見證人）。
                            </div>
                            <field name="signer_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="color" widget="color_picker"/>
                                    <field name="field_count" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="範本欄位 (Phase 8)">
                            <div class="alert alert-light mb-2" role="alert">
                                <i class="fa fa-info-circle me-1"/>
                                範本欄位通常在文件編輯器（後台 client action）以拖曳方式新增；此處列出僅供檢視 / 微調。
                            </div>
                            <field name="field_ids">
                                <list>
                                    <field name="signer_id"/>
                                    <field name="field_type"/>
                                    <field name="placeholder_text" optional="show"/>
                                    <field name="required"/>
                                    <field name="page_no"/>
                                    <field name="font_size" optional="hide"/>
                                    <field name="odoo_field_name" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="欄位別名對映（退場中）" name="aliases">
                            <div class="alert alert-warning mb-2" role="alert">
                                <i class="fa fa-exclamation-triangle me-1"/>
                                <strong>此機制已由「模型變數藥丸」取代。</strong>
                                升級時 <code>migrations/18.0.2.4.0</code> 會把這些對映
                                一次性轉成文件中的藥丸元素；下方資料僅供對照，請勿再新增。
                            </div>
                            <div class="alert alert-info mb-2" role="alert">
                                <strong>L2-v2 alias map（範本級）</strong>
                                <ul class="mb-0 mt-1 small">
                                    <li>所有使用此範本的 doc.document 預覽渲染時自動繼承這組對映。</li>
                                    <li>支援兩種 key：中文 <code>《工程名稱》</code> 與變數名 <code>{{ project_name }}</code>。</li>
                                    <li>下方為唯讀分組預覽；要直接編輯展開「JSON 編輯」摺疊區。</li>
                                </ul>
                            </div>
                            <group>
                                <field name="alias_count" readonly="1"/>
                            </group>
                            <field name="field_aliases_display" nolabel="1" readonly="1"/>
                            <separator string="進階：JSON 直接編輯"/>
                            <field name="field_aliases" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Selection 欄位速查" name="selection_lookup">
                            <div class="alert alert-light mb-2" role="alert">
                                <i class="fa fa-info-circle me-1"/>
                                列出「適用模型」中所有 Selection 欄位的可能值。alias expression 用
                                <code>selection_label('欄位名')</code> 可取得對應中文 label。
                            </div>
                            <field name="selection_fields_display" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ─── 搜尋 View ─── -->
    <record id="view_doc_template_search" model="ir.ui.view">
        <field name="name">doc.template.search</field>
        <field name="model">doc.template</field>
        <field name="arch" type="xml">
            <search string="搜尋範本">
                <field name="name"/>
                <field name="model_id"/>
                <filter name="active" string="啟用" domain="[('active', '=', True)]"/>
                <group expand="0" string="分組依據">
                    <filter name="group_by_category"
                            string="分類"
                            context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
