<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- 使用者只能讀/寫自己建立的或被加為協作者的文件 -->
        <record id="rule_doc_document_owner_or_collab" model="ir.rule">
            <field name="name">doc.document：擁有者或協作者</field>
            <field name="model_id" ref="model_doc_document"/>
            <field name="domain_force">[
                '|',
                ('create_uid', '=', user.id),
                ('collaborator_ids', 'in', [user.id])
            ]</field>
            <field name="groups" eval="[(4, ref('dobtor_doc_editor.group_doc_editor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 管理者可存取所有文件 -->
        <record id="rule_doc_document_manager_all" model="ir.rule">
            <field name="name">doc.document：管理者完整存取</field>
            <field name="model_id" ref="model_doc_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dobtor_doc_editor.group_doc_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 多公司隔離 -->
        <record id="rule_doc_document_company" model="ir.rule">
            <field name="name">doc.document：公司隔離</field>
            <field name="model_id" ref="model_doc_document"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('dobtor_doc_editor.group_doc_editor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            Portal user：只能看自己被加為協作者的文件（W2-3 P0-1）
            - 不能 unlink（已在 ACL 鎖死）
            - 不能 create（已在 ACL 鎖死）
            - 只看 collaborator_ids 包含自己的紀錄；不受 group_doc_editor 規則影響

            Sprint 117 — Sprint 78 Finding B 收口（cross-company 設計決策）：
            本 rule 刻意「不加」 company_id in company_ids 過濾，與
            rule_doc_document_company（only 給 group_doc_editor）形成不對稱。
            理由：group_doc_portal 設計目的（見 doc_groups.xml）= 讓 ChienYi
            承包商 / 業主代表跨公司編輯被授權的文件。承包商通常屬於自家公司、
            被監造公司（不同公司）邀請為 collaborator 才看得到該文件。
            若加 company 過濾、會 break 此跨公司協作流程。
            collaborator_ids 本身就是 explicit access grant、足以承擔授權邊界。
            測試見 tests/test_security.py 的 cross_company_invited 系列、
            審計紀錄見 docs/sprint117_portal_company_rule_closure.md。
        -->
        <record id="rule_doc_document_portal" model="ir.rule">
            <field name="name">doc.document：Portal 協作者僅限受邀文件</field>
            <field name="model_id" ref="model_doc_document"/>
            <field name="domain_force">[('collaborator_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('dobtor_doc_editor.group_doc_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!--
            Phase 1（藥丸改版）：doc.template 多公司隔離

            與 rule_doc_document_company 的差別是多了一條 company_id = False：
            範本刻意允許「不指定公司＝所有公司共用」（見 doc_template.company_id 的
            help）。既有範本升級後 company_id 為 NULL，靠這條才不會突然全部消失。

            群組沿用 doc.document 的既有語意：只掛 group_doc_editor。
            group_doc_manager implies group_doc_editor，但 manager 另有全存取規則，
            跨群組 ir.rule 是 OR，因此管理者不受公司限制——與 doc.document 一致。
        -->
        <record id="rule_doc_template_company" model="ir.rule">
            <field name="name">doc.template：公司隔離（未指定公司＝共用）</field>
            <field name="model_id" ref="model_doc_template"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[
                (4, ref('dobtor_doc_editor.group_doc_editor')),
                (4, ref('dobtor_doc_editor.group_doc_portal')),
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            報表引擎：doc.output 的存取邊界

            設計取捨——為什麼不做「能讀來源單據就能看它的列印紀錄」：
            那需要跨模型的動態判斷（res_model + res_id 逐筆 check_access），
            ir.rule 的 domain 表達不出來。硬做只有兩條路：覆寫 _search（容易
            造成 AccessError 且難測）或放寬成「同公司全看」（content_json 內含
            單據完整內容，等於洩漏）。兩者都比下面這條差。

            所以採「列印者本人 + 管理者」：
              * 一般編輯者只看得到自己列印過的紀錄（可解釋、無洩漏）
              * 管理者看得到全部（稽核用途，統一選單也只開給管理者）
            日後若客戶要求「能讀單據就能看全部列印紀錄」，那是刻意放寬，
            要連同 content_json 的敏感度一起評估，不應預設如此。
        -->
        <record id="rule_doc_output_own" model="ir.rule">
            <field name="name">doc.output：只看自己列印的</field>
            <field name="model_id" ref="model_doc_output"/>
            <field name="domain_force">[('rendered_by', '=', user.id)]</field>
            <field name="groups" eval="[
                (4, ref('dobtor_doc_editor.group_doc_editor')),
                (4, ref('dobtor_doc_editor.group_doc_portal')),
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_doc_output_manager_all" model="ir.rule">
            <field name="name">doc.output：管理者看全部（限本公司）</field>
            <field name="model_id" ref="model_doc_output"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('dobtor_doc_editor.group_doc_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- doc.report 是設定資料：編輯者唯讀、管理者可改（ACL 已控），
             這裡只加多公司隔離（留空＝共用，與 doc.template 同一套語意）。 -->
        <record id="rule_doc_report_company" model="ir.rule">
            <field name="name">doc.report：公司隔離（未指定公司＝共用）</field>
            <field name="model_id" ref="model_doc_report"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[
                (4, ref('dobtor_doc_editor.group_doc_editor')),
                (4, ref('dobtor_doc_editor.group_doc_portal')),
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            Sprint 79：error_log / perf_metric user-isolation
            - Sprint 78 audit Finding A：write-only telemetry sink 沒 record rule
              → portal user 可寫 create_uid != self 的 log（偽造 audit trail）
            - 修：每個 user 只能寫 create_uid = self.id 的紀錄
            - manager group 不受此 rule 限（manager 全存取）
            - perm_read=False 對應 ACL CSV 也是 0R（write-only），rule 主要 enforce on write/create
        -->
        <record id="rule_doc_editor_error_log_self_create" model="ir.rule">
            <field name="name">error_log: 只能寫 create_uid = self（防偽造）</field>
            <field name="model_id" ref="model_doc_editor_error_log"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[
                (4, ref('base.group_user')),
                (4, ref('dobtor_doc_editor.group_doc_portal')),
            ]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_doc_editor_perf_metric_self_create" model="ir.rule">
            <field name="name">perf_metric: 只能寫 create_uid = self（防偽造）</field>
            <field name="model_id" ref="model_doc_editor_perf_metric"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[
                (4, ref('base.group_user')),
                (4, ref('dobtor_doc_editor.group_doc_portal')),
            ]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
