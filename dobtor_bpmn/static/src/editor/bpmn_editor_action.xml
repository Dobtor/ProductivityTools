<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dobtor_bpmn.BpmnEditorAction">
        <div class="o_bpmn_action d-flex flex-column" t-att-class="{ 'o_bpmn_readonly': readonly }">
            <div t-if="!readonly" class="o_bpmn_action_toolbar d-flex align-items-center p-2 gap-2">
                <!-- 資料所屬資訊（仿 form view 麵包屑）：模型 + 齒輪 → 開啟資料表單。 -->
                <div class="o_bpmn_breadcrumb d-flex align-items-center gap-1 me-1"
                     role="button" t-on-click="onOpenForm"
                     title="開啟資料表單（客戶／專案／狀態／版本／分類…）">
                    <span class="o_bpmn_bc_model text-muted small">流程設計圖</span>
                    <i class="fa fa-cog text-muted"/>
                </div>
                <!-- 儲存（icon，仿 xmind），置於 inline 標題左邊。 -->
                <button class="btn btn-sm btn-outline-success o_bpmn_btn_save" title="儲存"
                        t-on-click="onSave" t-att-disabled="state.saving or state.libMissing">
                    <i t-att-class="state.saving ? 'fa fa-spinner fa-spin' : 'fa fa-save'"/>
                </button>
                <!-- inline 標題（可直接改名）。 -->
                <input type="text" class="o_bpmn_title_input fw-bold"
                       t-att-value="state.name" t-on-change="onNameChange"
                       placeholder="設計圖名稱" title="點擊可直接修改名稱"/>
                <!-- 標題後的多標籤欄位：已選標籤以彩色膠囊呈現（可移除），末端可搜尋新增/即時建立。 -->
                <div class="o_bpmn_tags d-flex align-items-center flex-wrap gap-1">
                    <i class="fa fa-tags text-muted"/>
                    <span t-foreach="state.tags" t-as="tag" t-key="tag.id"
                          t-attf-class="o_tag o_tag_color_{{tag.color}} d-inline-flex align-items-center rounded-pill">
                        <span class="o_tag_badge_text" t-esc="tag.name"/>
                        <a class="o_delete fa fa-times ms-1" role="button"
                           title="移除標籤" t-on-click="() => this.removeTag(tag.id)"/>
                    </span>
                    <AutoComplete
                        value="''"
                        sources="tagSources"
                        onSelect.bind="onSelectTag"
                        resetOnSelect="true"
                        placeholder="'新增標籤…'"
                        class="'o_bpmn_tag_ac'"/>
                </div>
                <span t-if="state.dirty" class="badge text-bg-warning">未儲存</span>
            </div>

            <!-- 專案列：可直接編輯專案 / 客戶，並顯示以 "/" 嵌入本圖的關聯物件名稱。 -->
            <div t-if="!readonly and !state.error and !state.libMissing"
                 class="o_bpmn_project_bar d-flex align-items-center flex-wrap gap-3 px-2 py-1">
                <div class="d-flex align-items-center gap-1">
                    <i class="fa fa-building text-muted"/>
                    <span class="small text-muted">客戶：</span>
                    <!-- 有專案 → 客戶由專案帶入，唯讀顯示；無專案 → 可搜尋選填。 -->
                    <t t-if="state.projectId">
                        <span class="small fw-bold" t-esc="state.partnerName or '—'"/>
                        <span class="small text-muted">（由專案帶入）</span>
                    </t>
                    <t t-else="">
                        <AutoComplete
                            value="state.partnerName"
                            sources="partnerSources"
                            onSelect.bind="onSelectPartner"
                            placeholder="'搜尋客戶…'"
                            class="'o_bpmn_pb_ac'"/>
                        <button t-if="state.partnerId" class="btn btn-sm btn-link p-0 text-muted"
                                title="清除客戶" t-on-click="() => this.clearPartner()">
                            <i class="fa fa-times"/>
                        </button>
                    </t>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <i class="fa fa-folder-open text-muted"/>
                    <span class="small text-muted">專案：</span>
                    <AutoComplete
                        value="state.projectName"
                        sources="projectSources"
                        onSelect.bind="onSelectProject"
                        placeholder="'搜尋專案…'"
                        class="'o_bpmn_pb_ac'"/>
                    <button t-if="state.projectId" class="btn btn-sm btn-link p-0 text-muted"
                            title="清除專案" t-on-click="() => this.clearProject()">
                        <i class="fa fa-times"/>
                    </button>
                </div>
                <span t-if="state.embedsLabel" class="o_bpmn_embeds small text-muted">
                    關聯物件：<span t-esc="state.embedsLabel"/>
                </span>
            </div>

            <div t-if="state.error" class="alert alert-danger m-2" role="alert">
                <span t-esc="state.error"/>
            </div>

            <div t-if="state.libMissing" class="alert alert-warning m-2" role="alert">
                <h5>視覺編輯器函式庫未載入</h5>
                <p>
                    bpmn-js / dmn-js 已隨 <code>dobtor_approval</code> 打包（bundled），
                    <code>window.BpmnJS</code> / <code>window.DmnJS</code> 應已存在。
                    若仍出現此訊息，請升級模組並清除瀏覽器快取後重試。
                </p>
            </div>

            <div t-if="!state.libMissing and !state.error" class="o_bpmn_action_body d-flex flex-grow-1">
                <div class="o_bpmn_action_canvas flex-grow-1" t-ref="canvas"/>
                <div t-if="!readonly" class="o_bpmn_action_panel" t-ref="panel"/>
            </div>
        </div>
    </t>
</templates>
