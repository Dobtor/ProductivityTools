<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="dobtor_bpmn.PickerDialog">
        <Dialog title="title" size="'md'">
            <div class="mb-2">
                <input type="text" class="form-control"
                       placeholder="搜尋設計圖名稱…"
                       t-att-value="state.search"
                       t-on-input="onSearchInput"/>
            </div>
            <div t-if="state.loading" class="text-center text-muted p-3">
                <i class="fa fa-spinner fa-spin"/>
            </div>
            <div t-elif="!state.diagrams.length" class="text-muted p-3">
                找不到流程設計圖。
            </div>
            <div t-else="" class="list-group o_bpmn_picker">
                <button t-foreach="state.diagrams" t-as="d" t-key="d.id"
                        type="button"
                        class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                        t-on-click="() => this.onSelect(d)">
                    <i class="fa fa-fw text-primary" t-att-class="icon(d)"/>
                    <span class="flex-grow-1 text-truncate" t-esc="d.name"/>
                    <span t-if="subtitle(d)" class="text-muted small text-truncate"
                          t-esc="subtitle(d)"/>
                </button>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                    取消
                </button>
            </t>
        </Dialog>
    </t>

</templates>
