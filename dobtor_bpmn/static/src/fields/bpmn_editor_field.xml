<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dobtor_bpmn.BpmnEditorField">
        <div class="o_bpmn_editor d-flex flex-column">
            <div t-if="state.libMissing" class="alert alert-warning m-2" role="alert">
                <h5>無法載入 bpmn.io 視覺編輯器函式庫</h5>
                <p>
                    已嘗試本地（<code>static/lib/bpmn-io/</code>）與 CDN（unpkg）皆失敗，
                    常見原因：① 伺服器/瀏覽器無法連外 ② CSP 內容安全政策擋下外部腳本 ③ 本地未放置 dist 檔。
                </p>
                <p>
                    解法：連外環境通常自動透過 CDN 載入即可；離線/受限環境請依
                    <code>dobtor_bpmn/static/lib/bpmn-io/README.md</code> 放置本地 dist 檔。
                    在此之前，可於下方「XML 原始碼」分頁直接編輯。
                </p>
            </div>
            <div t-if="state.error" class="alert alert-danger m-2" role="alert">
                <span t-esc="state.error"/>
            </div>
            <div t-if="!state.libMissing" class="o_bpmn_editor_body d-flex">
                <div class="o_bpmn_canvas flex-grow-1" t-ref="canvas"/>
                <div class="o_bpmn_panel" t-ref="panel"/>
            </div>
            <div t-if="!state.libMissing and !readonly" class="o_bpmn_editor_toolbar p-2">
                <button type="button" class="btn btn-primary btn-sm" t-on-click="save">
                    套用流程圖
                </button>
                <small class="text-muted ms-2">套用後請記得存檔紀錄。</small>
            </div>
        </div>
    </t>
</templates>
