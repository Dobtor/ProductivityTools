<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bpmn_diagram_category_list" model="ir.ui.view">
        <field name="name">bpmn.diagram.category.list</field>
        <field name="model">bpmn.diagram.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="view_bpmn_diagram_category_form" model="ir.ui.view">
        <field name="name">bpmn.diagram.category.form</field>
        <field name="model">bpmn.diagram.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bpmn_diagram_category" model="ir.actions.act_window">
        <field name="name">設計圖分類</field>
        <field name="res_model">bpmn.diagram.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_bpmn_diagram_tag_list" model="ir.ui.view">
        <field name="name">bpmn.diagram.tag.list</field>
        <field name="model">bpmn.diagram.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_bpmn_diagram_tag" model="ir.actions.act_window">
        <field name="name">設計圖標籤</field>
        <field name="res_model">bpmn.diagram.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
