<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bpmn_diagram_list" model="ir.ui.view">
        <field name="name">bpmn.diagram.list</field>
        <field name="model">bpmn.diagram</field>
        <field name="arch" type="xml">
            <list js_class="bpmn_diagram_list_open_editor">
                <field name="name"/>
                <field name="diagram_type"/>
                <field name="purpose"/>
                <field name="category_id"/>
                <field name="partner_id" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="project_ref" optional="hide"/>
                <field name="odoo_module"/>
                <field name="version"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'reviewed'"
                       decoration-success="state == 'frozen'"/>
            </list>
        </field>
    </record>

    <record id="view_bpmn_diagram_form" model="ir.ui.view">
        <field name="name">bpmn.diagram.form</field>
        <field name="model">bpmn.diagram</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_editor" type="object" string="開啟視覺編輯器"
                            class="btn-primary" invisible="not id"/>
                    <button name="action_create_executable_process" type="object"
                            string="建立簽核流程" invisible="not id or diagram_type != 'bpmn'"
                            groups="dobtor_approval.group_bpmn_approval_designer"
                            help="複製本設計圖 XML，在 dobtor_approval 建立可執行簽核流程（forked）"/>
                    <button name="action_create_dmn_definition" type="object"
                            string="建立 DMN 決策集" invisible="not id or diagram_type != 'dmn'"
                            groups="dobtor_approval.group_bpmn_approval_designer"
                            help="複製本 DMN 設計圖 XML，在 dobtor_approval 建立可執行 DMN 決策集（forked）"/>
                    <button name="action_regenerate_thumbnail" type="object" string="重新產生預覽圖"
                            invisible="not id"
                            help="由目前 XML 的版面資訊重新產生 kanban 預覽縮圖"/>
                    <button name="action_freeze" type="object" string="定版"
                            invisible="state == 'frozen'"/>
                    <button name="action_set_draft" type="object" string="設為草稿"
                            invisible="state != 'frozen'"/>
                    <button name="action_bump_version" type="object" string="升版"
                            invisible="state == 'frozen'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reviewed,frozen"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="設計圖名稱"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="diagram_type"/>
                            <field name="purpose"/>
                            <field name="code"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="category_id"/>
                            <field name="partner_id" readonly="project_id"
                                   help="有專案時客戶由專案帶入且不可編輯；無專案時可自由選填"/>
                            <field name="project_id"/>
                            <field name="project_ref"
                                   invisible="purpose != 'blueprint'"/>
                            <field name="odoo_module"
                                   invisible="purpose != 'documentation'"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="not id">
                        <i class="fa fa-info-circle me-1"/>
                        流程圖請按上方「<b>開啟視覺編輯器</b>」於全螢幕繪製；此頁僅管理設計圖的資訊。
                    </div>
                    <div class="alert alert-secondary" role="alert" invisible="id">
                        <i class="fa fa-info-circle me-1"/>
                        先儲存本設計圖，即可開啟視覺編輯器繪製流程。
                    </div>
                    <notebook>
                        <page string="XML 原始碼" name="xml_source" groups="base.group_no_one">
                            <field name="xml" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bpmn_diagram_kanban" model="ir.ui.view">
        <field name="name">bpmn.diagram.kanban</field>
        <field name="model">bpmn.diagram</field>
        <field name="arch" type="xml">
            <kanban action="action_open_editor" type="object" on_create="dobtor_bpmn.action_new_bpmn_editor" class="o_kanban_mobile o_bpmn_kanban">
                <field name="diagram_type"/>
                <field name="purpose"/>
                <field name="state"/>
                <field name="thumbnail"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <templates>
                    <t t-name="menu">
                        <a role="menuitem" type="object" name="action_open_editor"
                           class="dropdown-item">開啟視覺編輯器</a>
                        <a role="menuitem" type="open" class="dropdown-item">編輯資訊</a>
                        <t t-if="widget.deletable">
                            <a role="menuitem" type="delete"
                               class="dropdown-item text-danger">刪除</a>
                        </t>
                    </t>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong class="fs-5 d-block"><field name="name"/></strong>
                            <div t-if="record.thumbnail.value" class="my-2">
                                <img class="w-100"
                                     style="max-height: 160px; object-fit: contain; background: #fff; border: 1px solid #eee; border-radius: 4px;"
                                     t-att-src="record.thumbnail.value" alt="預覽縮圖"/>
                            </div>
                            <div class="text-muted" t-if="record.partner_id.value">
                                <i class="fa fa-building me-1"/><field name="partner_id"/>
                            </div>
                            <div class="text-muted" t-if="record.project_id.value">
                                <i class="fa fa-folder-open me-1"/><field name="project_id"/>
                            </div>
                            <div class="text-muted">
                                <field name="purpose"/>
                            </div>
                            <div class="mt-1 text-muted">
                                <field name="category_id"/> ·
                                v<field name="version"/> ·
                                <field name="state" widget="badge"
                                       decoration-info="state == 'draft'"
                                       decoration-warning="state == 'reviewed'"
                                       decoration-success="state == 'frozen'"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-end mt-1">
                                <field name="tag_ids" widget="many2many_tags"
                                       options="{'color_field': 'color'}"/>
                                <span class="badge text-bg-secondary text-nowrap ms-2">
                                    <field name="diagram_type"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_bpmn_diagram_search" model="ir.ui.view">
        <field name="name">bpmn.diagram.search</field>
        <field name="model">bpmn.diagram</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="odoo_module"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="project_ref"/>
                <field name="category_id"/>
                <field name="tag_ids"/>
                <filter name="bpmn" string="BPMN" domain="[('diagram_type', '=', 'bpmn')]"/>
                <filter name="dmn" string="DMN" domain="[('diagram_type', '=', 'dmn')]"/>
                <separator/>
                <filter name="documentation" string="模組流程記錄" domain="[('purpose', '=', 'documentation')]"/>
                <filter name="blueprint" string="規格藍圖" domain="[('purpose', '=', 'blueprint')]"/>
                <filter name="template" string="樣板" domain="[('purpose', '=', 'template')]"/>
                <filter name="executable_src" string="執行來源" domain="[('purpose', '=', 'executable_src')]"/>
                <separator/>
                <filter name="frozen" string="已定版" domain="[('state', '=', 'frozen')]"/>
                <group expand="0" string="分組">
                    <filter name="group_partner" string="客戶" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_project" string="專案" context="{'group_by': 'project_id'}"/>
                    <filter name="group_type" string="圖類型" context="{'group_by': 'diagram_type'}"/>
                    <filter name="group_purpose" string="用途" context="{'group_by': 'purpose'}"/>
                    <filter name="group_category" string="分類" context="{'group_by': 'category_id'}"/>
                </group>
                <!-- 左側導覽面板：客戶 / 專案 / 標籤（仿 dobtor_xmind）。
                     partner_id、project_id 皆 stored 可供 read_group 計數。 -->
                <searchpanel>
                    <field name="partner_id" string="客戶" icon="fa-building"
                           select="one" enable_counters="1"/>
                    <field name="project_id" string="專案" icon="fa-folder-open"
                           select="multi" enable_counters="1"/>
                    <field name="tag_ids" string="標籤" icon="fa-tags"
                           select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_bpmn_diagram" model="ir.actions.act_window">
        <field name="name">流程設計圖</field>
        <field name="res_model">bpmn.diagram</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_bpmn_diagram_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">建立第一張流程設計圖</p>
            <p>用 BPMN/DMN 視覺編輯器繪製流程；可用於記錄既有 Odoo 模組流程、繪製客戶專案規格藍圖，或作為簽核流程的設計來源。</p>
        </field>
    </record>

    <!-- kanban「新增」→ 建空白設計圖後直接開編輯器（跳過 form），供 on_create 引用。 -->
    <record id="action_new_bpmn_editor" model="ir.actions.server">
        <field name="name">新增流程設計圖</field>
        <field name="model_id" ref="model_bpmn_diagram"/>
        <field name="state">code</field>
        <field name="code">action = model.action_new_and_open_editor()</field>
    </record>
</odoo>
