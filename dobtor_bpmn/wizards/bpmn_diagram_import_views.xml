<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bpmn_diagram_import_wizard_form" model="ir.ui.view">
        <field name="name">bpmn.diagram.import.wizard.form</field>
        <field name="model">bpmn.diagram.import.wizard</field>
        <field name="arch" type="xml">
            <form string="匯入流程設計圖">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle me-1"/>
                        可一次選取/拖放多個 <b>.bpmn / .dmn / .xml</b> 檔；圖類型可自動偵測。
                    </div>
                    <group>
                        <group>
                            <field name="diagram_type"/>
                            <field name="purpose"/>
                        </group>
                        <group>
                            <field name="category_id"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                    <field name="attachment_ids" widget="many2many_binary"
                           string="檔案（可多選）"/>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="匯入"
                            class="btn-primary"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bpmn_diagram_import" model="ir.actions.act_window">
        <field name="name">匯入流程圖</field>
        <field name="res_model">bpmn.diagram.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
