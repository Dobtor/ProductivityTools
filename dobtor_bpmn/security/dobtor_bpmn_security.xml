<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dobtor_bpmn" model="ir.module.category">
        <field name="name">流程設計 (BPMN)</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_bpmn_diagram_user" model="res.groups">
        <field name="name">設計圖：使用者（檢視）</field>
        <field name="category_id" ref="module_category_dobtor_bpmn"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_bpmn_diagram_manager" model="res.groups">
        <field name="name">設計圖：設計師（建立/編輯）</field>
        <field name="category_id" ref="module_category_dobtor_bpmn"/>
        <field name="implied_ids" eval="[(4, ref('group_bpmn_diagram_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- 一般使用者只能看；設計師可改自己建立的；manager 全權 -->
    <record id="rule_bpmn_diagram_manager_all" model="ir.rule">
        <field name="name">設計圖：設計師可存取全部</field>
        <field name="model_id" ref="model_bpmn_diagram"/>
        <field name="groups" eval="[(4, ref('group_bpmn_diagram_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
