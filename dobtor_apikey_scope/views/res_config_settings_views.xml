<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Global "API Key rules": two controls in Settings > Permissions, placed
         right AFTER the native "Default Access Rights" setting, i.e. immediately
         BEFORE the "API Keys / Manage API Keys" setting.

         Anchor note: we key on the stable xmlid-based id `access_rights`.
         We deliberately do NOT anchor the "Manage API Keys" button:
           * Odoo 18 forbids `string` as an inheritance selector, and
           * that button's `name` is resolved to a DB-specific action id
             (e.g. "73"), which is not portable across databases/tenants. -->
    <record id="res_config_settings_view_form_apikey_scope" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.apikey.scope</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='access_rights']" position="after">
                <setting id="apikey_scope_rules_setting" groups="base.group_system"
                         help="限縮一般使用者建立 API Key 時可授出的權限與有效期限。系統管理員不受此限。">
                    <div class="mt8">
                        <label for="apikey_max_group_ids"
                               string="API Key 最大權限範圍（預設全帶入）"/>
                        <field name="apikey_max_group_ids" widget="many2many_tags"
                               options="{'no_create': True, 'no_quick_create': True}"/>
                        <div class="text-muted">
                            一般使用者的 API Key 最多只能含這些存取群組（再與其本身擁有的群組取交集）。留空＝不限制。
                        </div>
                    </div>
                    <div class="mt16">
                        <label for="apikey_max_duration" string="API Key 允許最大時間"/>
                        <field name="apikey_max_duration"/>
                        <div class="text-muted">
                            決定一般使用者建立 Key 時可選的最長有效期限與到期日上限；預設「Persistent Key」＝開放全部選項（含永久／自訂日期）。
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
