<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kb_proposal_list" model="ir.ui.view">
        <field name="name">corpaas.knowledge.proposal.list</field>
        <field name="model">corpaas.knowledge.proposal</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="version_no"/>
                <field name="case_id" optional="show"/>
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <field name="tier" optional="show"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total" sum="合計"/>
                <field name="margin_rate" optional="show"/>
                <field name="cost_is_estimate" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'sent'"
                       decoration-success="state == 'won'" decoration-muted="state == 'lost'"/>
            </list>
        </field>
    </record>

    <record id="view_kb_proposal_form" model="ir.ui.view">
        <field name="name">corpaas.knowledge.proposal.form</field>
        <field name="model">corpaas.knowledge.proposal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_import" string="匯入痛點" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_ai_match" string="AI 比對能力" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_compute_estimate" string="計算估算" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_create_blueprints" string="產生客戶藍圖" type="object"/>
                    <button name="action_render_html" string="產生建議書" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_create_sale_order" string="建立報價單" type="object"
                            invisible="sale_order_id or state == 'lost'"/>
                    <button name="action_send" string="送出" type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="送出後建議書內容會凍結、不能再修改。確定送出？"/>
                    <button name="action_mark_won" string="成交" type="object" class="btn-primary"
                            invisible="state != 'sent'"/>
                    <button name="action_mark_lost" string="未成交" type="object"
                            invisible="state != 'sent'"/>
                    <button name="action_feedback_actuals" string="工時回寫" type="object"
                            invisible="state not in ('sent', 'won') or not sale_order_id"
                            groups="dobtor_corpaas_knowledge.group_knowledge_editor"/>
                    <button name="action_download_word" string="下載 Word" type="object"
                            invisible="state == 'draft' and not pain_ids"
                            help="輸出這個版本的 Word 檔（可編輯）。正式交給客戶請用 PDF。"/>
                    <button name="action_copy_new_version" string="複製新版" type="object"
                            invisible="state == 'draft'"/>
                    <button name="action_copy_major_version" string="重大改版" type="object"
                            invisible="state == 'draft'"
                            confirm="重大改版會開出下一個主版號（例如 v1.3 → v2.0），用於範圍或計價方式有改變。確定？"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,won"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_blueprints" type="object" class="oe_stat_button"
                                icon="fa-sitemap" invisible="not blueprint_count">
                            <field name="blueprint_count" widget="statinfo" string="客戶藍圖"/>
                        </button>
                        <button name="action_open_sale_order" type="object" class="oe_stat_button"
                                icon="fa-dollar" invisible="not sale_order_id">
                            <div class="o_stat_info"><span class="o_stat_text">報價單</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/> <field name="version_no" class="text-muted"/></h1>
                    </div>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group string="客戶與方案">
                            <field name="case_id" readonly="state != 'draft' or id"
                                   options="{'no_create': True}"/>
                            <field name="version_date" readonly="state != 'draft'"/>
                            <field name="doc_purpose" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="user_id" readonly="state != 'draft'"/>
                            <field name="pricing_model" readonly="state != 'draft'"/>
                            <field name="hourly_rate" readonly="state != 'draft'"
                                   invisible="pricing_model != 'time_budget'"/>
                            <field name="budget_cap" readonly="state != 'draft'"/>
                            <field name="budget_gap" invisible="not budget_cap"
                                   decoration-danger="budget_gap &lt; 0"/>
                            <field name="product_tmpl_id" readonly="state != 'draft'"
                                   invisible="pricing_model == 'time_budget'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="package_id" readonly="state != 'draft'"
                                   invisible="pricing_model == 'time_budget'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="scenario_id" readonly="state != 'draft'"
                                   domain="[('package_ids', 'in', package_id)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="訂閱規格" invisible="pricing_model == 'time_budget'">
                            <field name="tier" readonly="state != 'draft'"/>
                            <field name="ccu" readonly="state != 'draft'"/>
                            <field name="billing_cycle" readonly="state != 'draft'"/>
                            <field name="storage_gb" readonly="state != 'draft'"/>
                            <field name="committed_qty" readonly="state != 'draft'"/>
                            <field name="committed_usage" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="報價（首年）">
                            <field name="subscription_monthly"/>
                            <field name="subscription_amount"/>
                            <field name="addon_amount"/>
                            <field name="implementation_days"/>
                            <field name="implementation_amount"/>
                            <field name="custom_days"/>
                            <field name="custom_amount"/>
                            <field name="total" class="fw-bold"/>
                            <field name="pricing_note"/>
                        </group>
                        <group string="成本與毛利">
                            <field name="cost_is_estimate" widget="boolean_toggle" readonly="1"/>
                            <field name="internal_cost"/>
                            <field name="margin"/>
                            <field name="margin_rate"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="痛點" name="pains">
                            <field name="pain_ids" readonly="state != 'draft'">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="department"/>
                                    <field name="description"/>
                                    <field name="color_hint" optional="show"/>
                                    <field name="module_hint" optional="hide"/>
                                    <field name="quote_note" optional="hide"/>
                                    <field name="source" optional="hide"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="department"/>
                                            <field name="color_hint"/>
                                            <field name="module_hint"/>
                                            <field name="source"/>
                                        </group>
                                        <group>
                                            <field name="quote_note"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="description"/>
                                        <field name="current_state"/>
                                        <field name="proposed_solution"/>
                                    </group>
                                    <field name="mapping_ids">
                                        <list editable="bottom">
                                            <field options="{'no_open': True}" name="capability_id"/>
                                            <field name="color"/>
                                            <field name="addon_product_ids" widget="many2many_tags" optional="show"/>
                                            <field name="custom_days_low" optional="show"/>
                                            <field name="custom_days_high" optional="show"/>
                                            <field name="note"/>
                                            <field name="confirmed" widget="boolean_toggle"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                        <page string="能力對應" name="mappings">
                            <field name="mapping_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="0"
                                      decoration-muted="color == 'as_is'"
                                      decoration-danger="color == 'custom'">
                                    <field name="pain_id" readonly="1"/>
                                    <field options="{'no_open': True}" name="capability_id"/>
                                    <field name="color"/>
                                    <field name="addon_product_ids" widget="many2many_tags" optional="show"/>
                                    <field name="custom_days_low" optional="show"/>
                                    <field name="custom_days_high" optional="show"/>
                                    <field name="note"/>
                                    <field name="source" optional="hide"/>
                                    <field name="confirmed" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="驅動因子與資料移轉" name="drivers">
                            <group>
                                <group>
                                    <field name="company_count" readonly="state != 'draft'"/>
                                    <field name="user_count" readonly="state != 'draft'"/>
                                    <field name="role_count" readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="integration_count" readonly="state != 'draft'"/>
                                    <field name="training_sessions" readonly="state != 'draft'"/>
                                </group>
                            </group>
                            <div class="text-muted">資料移轉檢核表：「計算估算」會從情境示範資料與能力宣告的主資料模型補齊；請填預估筆數。</div>
                            <field name="master_data_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="model_label"/>
                                    <field name="model"/>
                                    <field name="record_count"/>
                                    <field name="provided"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="估算" name="estimate">
                            <field name="estimate_line_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="0"
                                      decoration-danger="is_custom">
                                    <field options="{'no_open': True}" name="capability_id" readonly="1"/>
                                    <field name="activity" readonly="1"/>
                                    <field name="template_id" optional="hide" readonly="1"/>
                                    <field name="driver_qty" readonly="1"/>
                                    <field name="days" sum="人天"/>
                                    <field name="day_rate" optional="show"/>
                                    <field name="internal_day_cost" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" sum="金額"/>
                                    <field name="internal_cost" optional="hide" sum="成本"/>
                                    <field name="is_custom" readonly="1"/>
                                    <field name="note" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="版本與基礎" name="versioning">
                            <group>
                                <group>
                                    <field name="supersedes_id"/>
                                </group>
                            </group>
                            <separator string="報價基礎（客戶何時提供了什麼）"/>
                            <button name="action_sync_sources" type="object"
                                    string="從商機帶入會議與附件" class="btn-secondary"
                                    invisible="state != 'draft' or not case_id"/>
                            <button name="action_sync_sources_prune" type="object"
                                    string="帶入並移除商機已不列入的來源" class="btn-secondary"
                                    invisible="state != 'draft' or not case_id"
                                    confirm="商機上已取消列入的會議／附件，其報價基礎列會被刪除（手動輸入的不動）。"/>
                            <button name="action_ai_extract_pains" type="object"
                                    string="AI 從會議筆記萃取痛點" class="btn-secondary"
                                    invisible="state != 'draft' or not case_id or not package_id"/>
                            <field name="basis_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="kind"/>
                                    <field name="date"/>
                                    <field name="title"/>
                                    <field name="is_new" optional="show"/>
                                    <field name="content_changed" optional="show"/>
                                    <field name="note" optional="show"/>
                                </list>
                            </field>
                            <separator string="需求核對與本版處理"/>
                            <button name="action_draft_changes" type="object"
                                    string="以前一版產生差異草稿" class="btn-secondary"
                                    invisible="state != 'draft' or not supersedes_id"/>
                            <field name="change_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="ref_no"/>
                                    <field name="demand"/>
                                    <field name="handling"/>
                                    <field name="chapter_ref"/>
                                    <field name="basis_id" optional="hide"/>
                                    <field name="origin" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="範圍與前提" name="scope">
                            <separator string="範圍界線"/>
                            <button name="action_draft_scope" type="object"
                                    string="由對應產生範圍草稿" class="btn-secondary"
                                    invisible="state != 'draft' or scope_ids"/>
                            <field name="scope_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="kind"/>
                                    <field name="name"/>
                                    <field name="detail"/>
                                </list>
                            </field>
                            <separator string="前提與客戶配合事項"/>
                            <field name="obligation_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="kind"/>
                                    <field name="text"/>
                                </list>
                            </field>
                        </page>
                        <page string="期程與付款" name="schedule">
                            <group>
                                <group>
                                    <field name="total_hours"/>
                                    <field name="weeks_total"/>
                                    <field name="fte_ratio"/>
                                </group>
                                <group>
                                    <field name="payment_total"/>
                                    <field name="payment_gap" invisible="not payment_ids"
                                           decoration-danger="payment_gap != 0"/>
                                </group>
                            </group>
                            <div class="mb-2" invisible="state != 'draft'">
                                <button name="action_suggest_phases" type="object"
                                        string="產生階段" class="btn-secondary"
                                        confirm="會取代現有的階段。確定？"/>
                                <button name="action_suggest_units" type="object"
                                        string="產生驗收單元" class="btn-secondary"/>
                                <button name="action_assign_units" type="object"
                                        string="重新歸屬估算明細" class="btn-secondary"/>
                                <button name="action_suggest_payments" type="object"
                                        string="產生付款款別" class="btn-secondary"/>
                            </div>
                            <separator string="導入階段"/>
                            <field name="phase_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="activity" optional="show"/>
                                    <field name="content"/>
                                    <field name="milestone"/>
                                    <field name="week_from"/>
                                    <field name="week_to"/>
                                    <field name="hours" sum="工時"/>
                                    <field name="density" optional="show"/>
                                </list>
                            </field>
                            <separator string="驗收單元（預算大類）"/>
                            <field name="unit_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="capability_ids" widget="many2many_tags"/>
                                    <field name="is_custom_bucket"/>
                                    <field name="criteria"/>
                                    <field name="hours" sum="工時"/>
                                    <field name="ratio"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" sum="金額"/>
                                </list>
                            </field>
                            <separator string="付款款別"/>
                            <field name="payment_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="trigger"/>
                                    <field name="unit_id"/>
                                    <field name="ratio"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" sum="金額"/>
                                </list>
                            </field>
                        </page>
                        <page string="條款與效益" name="clauses">
                            <div class="mb-2" invisible="state != 'draft'">
                                <button name="action_load_clauses" type="object"
                                        string="載入條款庫" class="btn-secondary"
                                        confirm="會取代現有條款（包括人工改過的）。確定？"/>
                            </div>
                            <separator string="備註與免責"/>
                            <field name="clause_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="included"/>
                                    <field name="category"/>
                                    <field name="text"/>
                                </list>
                            </field>
                            <separator string="效益評估"/>
                            <field name="benefit_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="current_manual"/>
                                    <field name="after"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="annual_saving" sum="年化節省"/>
                                    <field name="assumption" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="建議書" name="html">
                            <field name="html" readonly="1"/>
                        </page>
                        <page string="成本頁" name="cost">
                            <group>
                                <group>
                                    <field name="labor_cost"/>
                                    <field name="infra_monthly_cost"/>
                                    <field name="third_party_monthly"/>
                                    <field name="ai_monthly_cost"/>
                                </group>
                                <group>
                                    <field name="cost_note" invisible="not cost_note"/>
                                </group>
                            </group>
                            <field name="cost_html" readonly="1"/>
                        </page>
                        <page string="快照" name="snapshot" invisible="not snapshot_json">
                            <field name="snapshot_json"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_kb_proposal_search" model="ir.ui.view">
        <field name="name">corpaas.knowledge.proposal.search</field>
        <field name="model">corpaas.knowledge.proposal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="case_id"/>
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <field name="user_id"/>
                <filter name="mine" string="我的" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="草稿" domain="[('state', '=', 'draft')]"/>
                <filter name="sent" string="已送出" domain="[('state', '=', 'sent')]"/>
                <filter name="won" string="成交" domain="[('state', '=', 'won')]"/>
                <separator/>
                <filter name="estimate" string="成本為估算值" domain="[('cost_is_estimate', '=', True)]"/>
                <group expand="0" string="分組">
                    <filter name="group_state" string="狀態" context="{'group_by': 'state'}"/>
                    <filter name="group_product" string="方案" context="{'group_by': 'product_tmpl_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kb_proposal" model="ir.actions.act_window">
        <field name="name">服務建議書</field>
        <field name="res_model">corpaas.knowledge.proposal</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_mine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">建立第一份服務建議書</p>
            <p>輸入或匯入客戶痛點，AI 會把痛點對應到方案能力，再依工時範本算出導入人天、報價與成本。</p>
        </field>
    </record>
</odoo>
