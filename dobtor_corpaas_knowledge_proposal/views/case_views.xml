<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kb_case_list" model="ir.ui.view">
        <field name="name">corpaas.knowledge.case.list</field>
        <field name="model">corpaas.knowledge.case</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="opportunity_id" optional="show"/>
                <field name="current_version_id" optional="show"/>
                <field name="version_count" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="quoted_total" sum="合計"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-success="state == 'won'"
                       decoration-muted="state == 'lost'" decoration-info="state == 'open'"/>
            </list>
        </field>
    </record>

    <record id="view_kb_case_form" model="ir.ui.view">
        <field name="name">corpaas.knowledge.case.form</field>
        <field name="model">corpaas.knowledge.case</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_new_version" string="新增版本" type="object"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,won"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_versions" type="object" class="oe_stat_button"
                                icon="fa-files-o">
                            <field name="version_count" widget="statinfo" string="版本"/>
                        </button>
                        <button name="action_open_opportunity" type="object"
                                class="oe_stat_button" icon="fa-star"
                                invisible="not opportunity_id">
                            <div class="o_stat_info"><span class="o_stat_text">商機</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h2><field name="title" placeholder="案件名稱，例如：營運治理導入"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="opportunity_id"
                                   options="{'no_create': True}"/>
                            <field name="parent_case_id" domain="[('id', '!=', id)]"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="current_version_id"/>
                            <field name="quoted_version_id"/>
                            <field name="quoted_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="版本" name="versions">
                            <field name="version_ids" readonly="1">
                                <list>
                                    <field name="version_no"/>
                                    <field name="name"/>
                                    <field name="version_date"/>
                                    <field name="doc_purpose"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="追加案件" name="children" invisible="not child_case_ids">
                            <field name="child_case_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_kb_case_search" model="ir.ui.view">
        <field name="name">corpaas.knowledge.case.search</field>
        <field name="model">corpaas.knowledge.case</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="opportunity_id"/>
                <field name="user_id"/>
                <filter name="mine" string="我的" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="open" string="進行中" domain="[('state', '=', 'open')]"/>
                <filter name="won" string="成交" domain="[('state', '=', 'won')]"/>
                <group expand="0" string="分組">
                    <filter name="group_state" string="狀態" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="客戶" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kb_case" model="ir.actions.act_window">
        <field name="name">報價案件</field>
        <field name="res_model">corpaas.knowledge.case</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_mine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">建立第一個報價案件</p>
            <p>一個案件底下有很多版本（v1.0、v1.1、v2.0…）；一個商機可以有多個案件。</p>
        </field>
    </record>

    <!-- 商機表單：報價案件的智慧按鈕與建立入口 -->
    <record id="crm_lead_view_form_knowledge_case" model="ir.ui.view">
        <field name="name">crm.lead.form.knowledge.case</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_knowledge_cases" type="object"
                        class="oe_stat_button" icon="fa-files-o"
                        invisible="not knowledge_case_count">
                    <field name="knowledge_case_count" widget="statinfo" string="報價案件"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_knowledge_case" type="object" string="開報價案件"
                        invisible="type != 'opportunity' or not partner_id"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>
</odoo>
