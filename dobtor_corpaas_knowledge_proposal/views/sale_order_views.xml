<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_knowledge_proposal" model="ir.ui.view">
        <field name="name">sale.order.form.knowledge.proposal</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_knowledge_confirm_provision" string="確認開通" type="object"
                        class="btn-primary"
                        invisible="not knowledge_proposal_id or knowledge_provision_state != 'hold' or state == 'cancel'"
                        groups="dobtor_corpaas_sale.group_corpaas_user"/>
            </xpath>
            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="knowledge_proposal_id" readonly="1" invisible="not knowledge_proposal_id"/>
                <field name="knowledge_provision_state" readonly="1" invisible="not knowledge_proposal_id"/>
            </xpath>
        </field>
    </record>
</odoo>
