<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 建議書來源（新架構規格第 13 節）：開發項目、整合開發建議、建立說明書製作計畫 -->
    <record id="view_kb_dev_item_list" model="ir.ui.view">
        <field name="name">corpaas.knowledge.dev_item.list</field>
        <field name="model">corpaas.knowledge.dev_item</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-success="state == 'done'" decoration-muted="state in ('no', 'next')">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="pain_id" optional="show"/>
                <field name="days_low" optional="show"/>
                <field name="days_high" optional="show"/>
                <field name="module_name"/>
                <field name="release_tag"/>
                <field name="tests_green"/>
                <field name="state"/>
                <field name="reason" optional="show"/>
                <button name="action_mark_done" type="object" string="標記完成" icon="fa-check"
                        invisible="state in ('done', 'no', 'next')" title="開發完成"/>
            </list>
        </field>
    </record>
    <record id="view_kb_dev_item_form" model="ir.ui.view">
        <field name="name">corpaas.knowledge.dev_item.form</field>
        <field name="model">corpaas.knowledge.dev_item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_done" type="object" string="標記完成" class="btn-primary"
                            invisible="state in ('done', 'no', 'next')"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="proposal_id"/>
                            <field name="pain_id"/>
                            <field name="days_low"/>
                            <field name="days_high"/>
                            <field name="estimate_line_id"/>
                        </group>
                        <group>
                            <field name="module_name"/>
                            <field name="repo"/>
                            <field name="branch"/>
                            <field name="release_tag"/>
                            <field name="tests_green"/>
                            <field name="reason"/>
                        </group>
                    </group>
                    <group string="建議的擴充點"><field name="suggestion" nolabel="1" colspan="2"/></group>
                    <group string="涉及模型與繼承鏈"><field name="models_text" nolabel="1" colspan="2"/></group>
                    <group string="風險"><field name="risk" nolabel="1" colspan="2"/></group>
                    <group string="測試日誌"><field name="test_log" nolabel="1" colspan="2"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_kb_proposal_form_plan" model="ir.ui.view">
        <field name="name">corpaas.knowledge.proposal.form.plan</field>
        <field name="model">corpaas.knowledge.proposal</field>
        <field name="inherit_id" ref="dobtor_corpaas_knowledge_proposal.view_kb_proposal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ai_dev_suggest" string="AI 整合開發建議" type="object"/>
                <button name="action_create_manual_plan" string="建立說明書計畫" type="object"
                        invisible="state not in ('sent', 'won')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="開發項目" name="dev_items">
                    <field name="dev_item_ids"/>
                </page>
                <page string="說明書製作計畫" name="manual_plans" invisible="not knowledge_plan_ids">
                    <field name="knowledge_plan_ids" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_kb_plan_form_proposal" model="ir.ui.view">
        <field name="name">corpaas.knowledge.plan.form.proposal</field>
        <field name="model">corpaas.knowledge.plan</field>
        <field name="inherit_id" ref="dobtor_corpaas_knowledge.view_kb_plan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_type']" position="after">
                <field name="proposal_id" readonly="1" invisible="source_type != 'proposal'"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_approve" type="object" string="核准（案件負責人）" class="btn-primary"
                        invisible="state != 'review' or source_type != 'proposal'"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>
</odoo>
