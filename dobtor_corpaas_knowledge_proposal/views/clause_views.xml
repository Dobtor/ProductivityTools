<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kb_clause_template_list" model="ir.ui.view">
        <field name="name">corpaas.knowledge.clause.template.list</field>
        <field name="model">corpaas.knowledge.clause_template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="category"/>
                <field name="condition"/>
                <field name="text"/>
                <field name="note" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_kb_clause_template_form" model="ir.ui.view">
        <field name="name">corpaas.knowledge.clause.template.form</field>
        <field name="model">corpaas.knowledge.clause_template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="condition"/>
                            <field name="capability_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="text" placeholder="條款內容；可用 {validity_days}、{customer} 等變數"/>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kb_clause_template_search" model="ir.ui.view">
        <field name="name">corpaas.knowledge.clause.template.search</field>
        <field name="model">corpaas.knowledge.clause_template</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="text"/>
                <filter name="condition_always" string="一律適用"
                        domain="[('condition', '=', 'always')]"/>
                <group expand="0" string="分組">
                    <filter name="group_category" string="分類" context="{'group_by': 'category'}"/>
                    <filter name="group_condition" string="適用條件"
                            context="{'group_by': 'condition'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kb_clause_template" model="ir.actions.act_window">
        <field name="name">條款庫</field>
        <field name="res_model">corpaas.knowledge.clause_template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
    </record>

    <menuitem id="menu_kb_clause_template" name="條款庫" sequence="25"
              parent="menu_kb_proposal_root" action="action_kb_clause_template"/>
</odoo>
