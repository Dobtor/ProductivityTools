<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_kb_proposal" model="ir.actions.report">
        <field name="name">服務建議書</field>
        <field name="model">corpaas.knowledge.proposal</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dobtor_corpaas_knowledge_proposal.report_kb_proposal</field>
        <field name="report_file">dobtor_corpaas_knowledge_proposal.report_kb_proposal</field>
        <field name="print_report_name">'服務建議書 - %s' % object.name</field>
        <field name="binding_model_id" ref="model_corpaas_knowledge_proposal"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_kb_proposal_cost" model="ir.actions.report">
        <field name="name">內部成本頁</field>
        <field name="model">corpaas.knowledge.proposal</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dobtor_corpaas_knowledge_proposal.report_kb_proposal_cost</field>
        <field name="report_file">dobtor_corpaas_knowledge_proposal.report_kb_proposal_cost</field>
        <field name="print_report_name">'內部成本頁 - %s' % object.name</field>
        <field name="binding_model_id" ref="model_corpaas_knowledge_proposal"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <!-- ★ 內容一律取 html 欄位：送出後它就是凍結的那一份，列印不會與送出的內容不同 -->
    <template id="report_kb_proposal">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-if="o.html"><t t-out="o.html"/></t>
                        <t t-else=""><t t-out="o._render_html()"/></t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_kb_proposal_cost">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2><span t-field="o.name"/> ／ <span t-field="o.partner_id"/></h2>
                        <t t-out="o.cost_html"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
