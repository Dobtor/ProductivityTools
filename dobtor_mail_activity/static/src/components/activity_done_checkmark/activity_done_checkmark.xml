<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="dobtor_mail_activity.ActivityDoneCheckmark">
        <t t-if="!env.isSmall">
            <a t-att-title="stateDone.isDone ? '標記為待辦' : '標記為完成'"
               t-on-click.stop="onDoneToggled"
               t-on-mouseleave="actualizeDoneState"
               t-on-mouseover="freezeDoneState"
               t-attf-class="o_activity_done_button fa fa-lg fa-check-circle{{!stateDone.isDone ? '-o' : ' done_button_enabled'}}"/>
        </t>
        <t t-else="">
            <a t-att-title="stateDone.isDone ? '標記為待辦' : '標記為完成'"
               t-on-click.stop="onDoneToggled"
               t-attf-class="o_activity_done_button_mobile fa fa-lg fa-check-circle{{!stateDone.isDone ? '-o' : ' done_button_enabled'}}"/>
        </t>
    </t>

</templates>
