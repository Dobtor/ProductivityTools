<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dobtor_mail_activity.WeekSelector">
        <div class="o_week_selector">
            <!-- 載入中 -->
            <div t-if="state.isLoading" class="d-flex align-items-center text-muted p-2">
                <i class="fa fa-spinner fa-spin me-2"/>
                <span>載入週次資訊...</span>
            </div>

            <!-- 週次選擇器 -->
            <div t-else="" class="d-flex gap-2 flex-wrap">
                <t t-foreach="state.weeks" t-as="week" t-key="week.key">
                    <div t-att-class="getWeekClass(week)"
                         t-on-click="() => this.selectWeek(week.number)"
                         t-att-title="week.start_date + ' ~ ' + week.end_date"
                         style="min-width: 90px;">
                        <!-- 週次名稱 -->
                        <div class="small fw-bold mb-1">
                            <t t-esc="week.name"/>
                            <span t-if="week.number === 0" class="ms-1">
                                <i class="fa fa-star text-warning" title="本週"/>
                            </span>
                        </div>

                        <!-- 統計資訊 -->
                        <div t-if="props.showStats" class="d-flex justify-content-center gap-2 small">
                            <span t-att-class="'badge ' + getBadgeClass(week)"
                                  t-att-title="'待辦數: ' + week.count">
                                <i class="fa fa-tasks me-1"/>
                                <t t-esc="week.count"/>
                            </span>
                            <span class="badge bg-info"
                                  t-att-title="'預估工時: ' + week.total_hours + '小時'">
                                <i class="fa fa-clock-o me-1"/>
                                <t t-esc="week.total_hours"/>h
                            </span>
                        </div>

                        <!-- 日期範圍（小字） -->
                        <div class="small text-muted mt-1" style="font-size: 0.7rem;">
                            <t t-esc="week.start_date.substring(5)"/>
                        </div>
                    </div>
                </t>
            </div>

            <!-- 重新載入按鈕 -->
            <div class="mt-2 text-end">
                <button class="btn btn-sm btn-link text-muted p-0"
                        t-on-click="loadWeekInfo"
                        title="重新載入">
                    <i class="fa fa-refresh"/>
                </button>
            </div>
        </div>
    </t>
</templates>
