<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dobtor_mail_activity.ActivityBox">
        <div t-att-class="priorityClass + ' p-2 rounded border mb-2 cursor-pointer'"
             t-on-mouseenter="onMouseEnter"
             t-on-mouseleave="onMouseLeave"
             t-on-click="openActivity">
            <!-- 緊湊模式 -->
            <t t-if="props.compact">
                <div class="d-flex align-items-center gap-2">
                    <!-- 狀態圖標 -->
                    <i t-att-class="'fa ' + stateInfo.icon + ' ' + (stateInfo.class === 'bg-success' ? 'text-success' : stateInfo.class === 'bg-danger' ? 'text-danger' : 'text-primary')"/>

                    <!-- 摘要 -->
                    <span class="flex-grow-1 text-truncate small"
                          t-att-class="{'text-decoration-line-through text-muted': props.activity.activity_status === 'done'}">
                        <t t-esc="props.activity.summary || props.activity.activity_type_id[1] || '(No Summary)'"/>
                    </span>

                    <!-- 緊急標記 -->
                    <i t-if="urgencyLabel" t-att-class="'fa ' + urgencyLabel.icon + ' ' + urgencyLabel.class"
                       t-att-title="urgencyLabel.label"/>

                    <!-- 截止日期 -->
                    <span class="badge bg-secondary small" t-if="props.activity.date_deadline">
                        <t t-esc="props.activity.date_deadline"/>
                    </span>
                </div>
            </t>

            <!-- 完整模式 -->
            <t t-else="">
                <!-- 標題列 -->
                <div class="d-flex align-items-start gap-2">
                    <!-- 類型圖標 -->
                    <div class="o_activity_icon">
                        <i class="fa fa-tasks fa-lg text-muted"/>
                    </div>

                    <!-- 內容區 -->
                    <div class="flex-grow-1">
                        <!-- 摘要 -->
                        <div class="fw-bold"
                             t-att-class="{'text-decoration-line-through text-muted': props.activity.activity_status === 'done'}">
                            <t t-esc="props.activity.summary || '(No Summary)'"/>
                        </div>

                        <!-- 類型與關聯文件 -->
                        <div class="small text-muted">
                            <span t-if="props.activity.activity_type_id">
                                <i class="fa fa-tag me-1"/>
                                <t t-esc="props.activity.activity_type_id[1]"/>
                            </span>
                            <span t-if="props.activity.res_name" class="ms-2">
                                <i class="fa fa-link me-1"/>
                                <a href="#" class="text-decoration-none"
                                   t-on-click.stop.prevent="openDocument">
                                    <t t-esc="props.activity.res_name"/>
                                </a>
                            </span>
                        </div>

                        <!-- 標籤列 -->
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            <!-- 狀態徽章 -->
                            <span t-att-class="'badge ' + stateInfo.class">
                                <i t-att-class="'fa ' + stateInfo.icon + ' me-1'"/>
                                <t t-esc="stateInfo.label"/>
                            </span>

                            <!-- 緊急徽章 -->
                            <span t-if="urgencyLabel" t-att-class="'badge bg-light ' + urgencyLabel.class">
                                <i t-att-class="'fa ' + urgencyLabel.icon + ' me-1'"/>
                                <t t-esc="urgencyLabel.label"/>
                            </span>

                            <!-- 重要標記 -->
                            <span t-if="props.activity.importance === 'important'" class="badge bg-warning text-dark">
                                <i class="fa fa-star me-1"/>Important
                            </span>

                            <!-- 截止日期 -->
                            <span t-if="props.activity.date_deadline" class="badge bg-light text-dark">
                                <i class="fa fa-calendar me-1"/>
                                <t t-esc="props.activity.date_deadline"/>
                            </span>

                            <!-- 預估工時 -->
                            <span t-if="props.activity.estimated_hours" class="badge bg-light text-dark">
                                <i class="fa fa-clock-o me-1"/>
                                <t t-esc="props.activity.estimated_hours"/>h
                            </span>

                            <!-- 指派人 -->
                            <span t-if="props.activity.user_id" class="badge bg-light text-dark">
                                <i class="fa fa-user me-1"/>
                                <t t-esc="props.activity.user_id[1]"/>
                            </span>
                        </div>
                    </div>

                    <!-- 動作按鈕（懸停顯示） -->
                    <div t-if="props.showActions and state.isHovered and props.activity.activity_status === 'active'"
                         class="o_activity_actions d-flex gap-1">
                        <button class="btn btn-sm btn-success" t-on-click.stop="markDone" title="Complete">
                            <i class="fa fa-check"/>
                        </button>
                        <button class="btn btn-sm btn-warning" t-on-click.stop="postpone" title="Postpone">
                            <i class="fa fa-clock-o"/>
                        </button>
                        <button class="btn btn-sm btn-secondary" t-on-click.stop="transfer" title="Transfer">
                            <i class="fa fa-exchange"/>
                        </button>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
