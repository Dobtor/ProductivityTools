<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="dobtor_mail_activity.ActivityRelationDiagram">
        <div class="o_activity_relation_diagram">
            <div class="o_ard_toolbar">
                <span class="o_ard_hint text-muted" t-esc="linkHint"/>
                <div class="o_ard_toolbar_btns d-flex align-items-center">
                    <!-- 縮放 -->
                    <div class="o_ard_buttons btn-group btn-group-sm me-2" role="group">
                        <button type="button" class="btn btn-secondary"
                                title="Zoom out"
                                t-on-click="onZoomOut">
                            <i class="fa fa-search-minus"/>
                        </button>
                        <button type="button" class="btn btn-secondary"
                                title="Fit to window"
                                t-on-click="onZoomFit">
                            <i class="fa fa-expand"/>
                        </button>
                        <button type="button" class="btn btn-secondary"
                                title="Zoom in"
                                t-on-click="onZoomIn">
                            <i class="fa fa-search-plus"/>
                        </button>
                    </div>
                    <!-- 逐層展開/收合 -->
                    <div class="o_ard_buttons btn-group btn-group-sm me-2" role="group">
                        <button type="button" class="btn btn-secondary"
                                title="Collapse one level"
                                t-on-click="onCollapseLevel">
                            <i class="fa fa-minus"/>
                        </button>
                        <button type="button" class="btn btn-secondary"
                                title="Expand one level"
                                t-on-click="onExpandLevel">
                            <i class="fa fa-plus"/>
                        </button>
                    </div>
                    <!-- 眼睛（總開關）：一次展開/收合所有節點的待辦清單 -->
                    <div class="o_ard_buttons btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-secondary"
                                t-att-class="{ active: state.showActivities }"
                                t-att-title="eyeTitle"
                                t-on-click="onToggleActivities">
                            <i t-att-class="state.showActivities ? 'fa fa-eye' : 'fa fa-eye-slash'"/>
                        </button>
                    </div>
                </div>
            </div>

            <div t-if="state.loading" class="o_ard_status text-muted">
                <i class="fa fa-spin fa-circle-o-notch me-1"/> Loading…
            </div>
            <div t-if="!state.loading and state.empty" class="o_ard_status text-muted"
                 t-esc="emptyHint"/>

            <div class="o_ard_canvas" t-ref="diagram"
                 t-att-class="{ 'd-none': state.empty or state.loading }"/>
        </div>
    </t>

</templates>
