<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="dobtor_mail_activity.ActivityPickerDialog">
        <Dialog title="title" size="'md'">
            <div t-if="state.loading" class="text-center text-muted p-3">
                <i class="fa fa-spinner fa-spin"/>
            </div>
            <div t-elif="!state.activities.length" class="text-muted p-3">
                <t>No to-do found for this document.</t>
            </div>
            <div t-else="" class="list-group o_dobtor_activity_picker">
                <button t-foreach="state.activities" t-as="act" t-key="act.id"
                        type="button"
                        class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                        t-on-click="() => this.onSelect(act)">
                    <i t-if="act.active" class="fa fa-clock-o fa-fw"
                       t-att-class="stateClass(act)"/>
                    <i t-else="" class="fa fa-check fa-fw text-muted"/>
                    <span class="flex-grow-1 text-truncate"
                          t-att-class="{ 'text-muted text-decoration-line-through': !act.active }"
                          t-esc="act.summary or act.activity_type_name"/>
                    <span t-if="act.user_name" class="text-muted small text-truncate"
                          t-esc="act.user_name"/>
                    <span t-if="act.date_deadline" class="text-muted small"
                          t-esc="act.date_deadline"/>
                </button>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

</templates>
