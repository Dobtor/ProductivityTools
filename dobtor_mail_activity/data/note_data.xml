<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- =====================================================
             Note Default Stages (note.stage)
             Default stages for admin user
             ===================================================== -->

        <!-- Notes - General notes -->
        <record id="note_stage_notes" model="note.stage">
            <field name="name">Notes</field>
            <field name="sequence">1</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="fold">False</field>
        </record>

        <!-- Meeting Minutes - Meeting records -->
        <record id="note_stage_meeting" model="note.stage">
            <field name="name">Meeting Minutes</field>
            <field name="sequence">5</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="fold">False</field>
        </record>

        <!-- Manuals - Documentation and guides -->
        <record id="note_stage_manuals" model="note.stage">
            <field name="name">Manuals</field>
            <field name="sequence">10</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="fold">False</field>
        </record>

        <!-- References - Reference materials -->
        <record id="note_stage_references" model="note.stage">
            <field name="name">References</field>
            <field name="sequence">50</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="fold">True</field>
        </record>

    </data>
</odoo>
