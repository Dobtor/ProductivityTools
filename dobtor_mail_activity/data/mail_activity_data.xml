<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 週報排程待辦類型 -->
        <record id="mail_activity_type_weekly_report_schedule" model="mail.activity.type">
            <field name="name">Weekly Schedule</field>
            <field name="summary">Plan this week's work</field>
            <field name="category">default</field>
            <field name="delay_count">7</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">current_date</field>
            <field name="icon">fa-calendar-check-o</field>
            <field name="decoration_type">warning</field>
            <field name="default_description"><![CDATA[
<p>Please complete the following:</p>
<ol>
    <li>Review last week's completion</li>
    <li>Confirm this week's priorities</li>
    <li>Schedule daily activities for this week</li>
    <li>Pre-schedule important work for next week</li>
</ol>
]]></field>
        </record>

    </data>
</odoo>
