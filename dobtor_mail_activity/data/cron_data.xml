<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 週轉換定時任務 -->
        <record id="ir_cron_weekly_transition" model="ir.cron">
            <field name="name">Activity Week Transition</field>
            <field name="model_id" ref="mail.model_mail_activity"/>
            <field name="state">code</field>
            <field name="code">model._cron_weekly_transition()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
        </record>

        <!-- 效率指標計算定時任務 -->
        <record id="ir_cron_compute_efficiency_metrics" model="ir.cron">
            <field name="name">Calculate Efficiency Metrics</field>
            <field name="model_id" ref="dobtor_mail_activity.model_activity_efficiency_metrics"/>
            <field name="state">code</field>
            <field name="code">model._cron_compute_metrics()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- 週報排程自動建立定時任務 -->
        <record id="ir_cron_create_weekly_schedule" model="ir.cron">
            <field name="name">Create Weekly Schedule Activities</field>
            <field name="model_id" ref="dobtor_mail_activity.model_weekly_schedule_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_weekly_activities()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- 清理超時的 processing 狀態錄音/摘要 -->
        <record id="ir_cron_cleanup_stale_processing" model="ir.cron">
            <field name="name">Cleanup Stale Processing Recordings</field>
            <field name="model_id" ref="dobtor_mail_activity.model_note_recording"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_stale_processing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
