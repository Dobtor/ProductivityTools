<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 週轉換定時任務 -->
        <record id="ir_cron_weekly_transition" model="ir.cron">
            <field name="name">待辦週轉換</field>
            <field name="model_id" ref="mail.model_mail_activity"/>
            <field name="state">code</field>
            <field name="code">model._cron_weekly_transition()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
        </record>

        <!-- 效率指標計算定時任務 -->
        <record id="ir_cron_compute_efficiency_metrics" model="ir.cron">
            <field name="name">計算效率指標</field>
            <field name="model_id" ref="dobtor_mail_activity.model_activity_efficiency_metrics"/>
            <field name="state">code</field>
            <field name="code">model._cron_compute_metrics()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- 週報排程自動建立定時任務 -->
        <record id="ir_cron_create_weekly_schedule" model="ir.cron">
            <field name="name">建立週報排程待辦</field>
            <field name="model_id" ref="dobtor_mail_activity.model_weekly_schedule_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_weekly_activities()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
