#. module: dobtor_mail_activity
#: model:mail.template,body_html:dobtor_mail_activity.mail_template_meeting_minutes
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Dear {{ ctx.get('signer_name', 'Participant') }},\n"
"        <br/><br/>\n"
"        The meeting minutes for <strong>{{ object.name }}</strong> is ready for your review and signature.\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 16px 0px; padding: 0px; font-size: 13px;\">\n"
"        <strong>Meeting Details:</strong>\n"
"    </p>\n"
"\n"
"    {% set first_event = object.calendar_event_ids[:1] %}\n"
"    <table style=\"border-collapse: collapse; font-size: 13px;\">\n"
"        {% if first_event %}\n"
"        <tr>\n"
"            <td style=\"padding: 4px 16px 4px 0; vertical-align: top;\"><strong>Date:</strong></td>\n"
"            <td style=\"padding: 4px 0;\">{{ first_event.start.strftime('%Y-%m-%d %H:%M') if first_event.start else '-' }}</td>\n"
"        </tr>\n"
"        {% endif %}\n"
"        {% if first_event and first_event.location %}\n"
"        <tr>\n"
"            <td style=\"padding: 4px 16px 4px 0; vertical-align: top;\"><strong>Location:</strong></td>\n"
"            <td style=\"padding: 4px 0;\">{{ first_event.location }}</td>\n"
"        </tr>\n"
"        {% endif %}\n"
"        {% if object.available_signer_ids %}\n"
"        <tr>\n"
"            <td style=\"padding: 4px 16px 4px 0; vertical-align: top;\"><strong>Participants:</strong></td>\n"
"            <td style=\"padding: 4px 0;\">{{ ', '.join(object.available_signer_ids.mapped('name')) }}</td>\n"
"        </tr>\n"
"        {% endif %}\n"
"        <tr>\n"
"            <td style=\"padding: 4px 16px 4px 0; vertical-align: top;\"><strong>Prepared by:</strong></td>\n"
"            <td style=\"padding: 4px 0;\">{{ object.user_id.name }}</td>\n"
"        </tr>\n"
"    </table>\n"
"\n"
"    <p style=\"margin: 16px 0px; padding: 0px; font-size: 13px;\">\n"
"        Please click the button below to review the meeting minutes and provide your signature:\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 16px 0px; padding: 0px;\">\n"
"        <a href=\"%7B%7B%20ctx.get('signer_portal_url',%20object.get_portal_url())%20%7D%7D\" style=\"display: inline-block; padding: 10px 20px; background-color: #875A7B; color: white; text-decoration: none; border-radius: 4px; font-size: 13px;\">\n"
"            View &amp; Sign Meeting Minutes\n"
"        </a>\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 16px 0px; padding: 0px; font-size: 13px;\">\n"
"        <strong>Note:</strong> If the button above doesn't work, you can copy and paste the following link into your browser:\n"
"        <br/>\n"
"        <a href=\"%7B%7B%20ctx.get('signer_portal_url',%20object.get_portal_url())%20%7D%7D\">{{ ctx.get('signer_portal_url', object.get_portal_url()) }}</a>\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 16px 0px 0px 0px; padding: 0px; font-size: 13px;\">\n"
"        Thank you for your cooperation.\n"
"        <br/><br/>\n"
"        Best regards,<br/>\n"
"        {{ object.user_id.name }}\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        親愛的 {{ ctx.get('signer_name', 'Participant') }}：\n"
"        <br/><br/>\n"
"        <strong>{{ object.name }}</strong> 的會議記錄已準備好，敬請您審閱並簽署。\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 16px 0px; padding: 0px; font-size: 13px;\">\n"
"        <strong>會議詳情：</strong>\n"
"    </p>\n"
"\n"
"    {% set first_event = object.calendar_event_ids[:1] %}\n"
"    <table style=\"border-collapse: collapse; font-size: 13px;\">\n"
"        {% if first_event %}\n"
"        <tr>\n"
"            <td style=\"padding: 4px 16px 4px 0; vertical-align: top;\"><strong>日期：</strong></td>\n"
"            <td style=\"padding: 4px 0;\">{{ first_event.start.strftime('%Y-%m-%d %H:%M') if first_event.start else '-' }}</td>\n"
"        </tr>\n"
"        {% endif %}\n"
"        {% if first_event and first_event.location %}\n"
"        <tr>\n"
"            <td style=\"padding: 4px 16px 4px 0; vertical-align: top;\"><strong>地點：</strong></td>\n"
"            <td style=\"padding: 4px 0;\">{{ first_event.location }}</td>\n"
"        </tr>\n"
"        {% endif %}\n"
"        {% if object.available_signer_ids %}\n"
"        <tr>\n"
"            <td style=\"padding: 4px 16px 4px 0; vertical-align: top;\"><strong>與會者：</strong></td>\n"
"            <td style=\"padding: 4px 0;\">{{ ', '.join(object.available_signer_ids.mapped('name')) }}</td>\n"
"        </tr>\n"
"        {% endif %}\n"
"        <tr>\n"
"            <td style=\"padding: 4px 16px 4px 0; vertical-align: top;\"><strong>製作人：</strong></td>\n"
"            <td style=\"padding: 4px 0;\">{{ object.user_id.name }}</td>\n"
"        </tr>\n"
"    </table>\n"
"\n"
"    <p style=\"margin: 16px 0px; padding: 0px; font-size: 13px;\">\n"
"        請點擊下方按鈕審閱會議記錄並完成簽署：\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 16px 0px; padding: 0px;\">\n"
"        <a href=\"%7B%7B%20ctx.get('signer_portal_url',%20object.get_portal_url())%20%7D%7D\" style=\"display: inline-block; padding: 10px 20px; background-color: #875A7B; color: white; text-decoration: none; border-radius: 4px; font-size: 13px;\">\n"
"            審閱並簽署會議記錄\n"
"        </a>\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 16px 0px; padding: 0px; font-size: 13px;\">\n"
"        <strong>備註：</strong>若上方按鈕無法使用，您可複製以下連結並貼到瀏覽器：\n"
"        <br/>\n"
"        <a href=\"%7B%7B%20ctx.get('signer_portal_url',%20object.get_portal_url())%20%7D%7D\">{{ ctx.get('signer_portal_url', object.get_portal_url()) }}</a>\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 16px 0px 0px 0px; padding: 0px; font-size: 13px;\">\n"
"        感謝您的配合。\n"
"        <br/><br/>\n"
"        敬祝順安，<br/>\n"
"        {{ object.user_id.name }}\n"
"    </p>\n"
"</div>\n"
"            "

#. module: dobtor_mail_activity
#: model:mail.template,body_html:dobtor_mail_activity.mail_template_meeting_signed
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Dear {{ object.user_id.name }},\n"
"        <br/><br/>\n"
"        All required signers have signed the meeting minutes for <strong>{{ object.name }}</strong>.\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 16px 0px; padding: 0px; font-size: 13px;\">\n"
"        <strong>Signature Summary:</strong>\n"
"    </p>\n"
"\n"
"    <table style=\"border-collapse: collapse; font-size: 13px; width: 100%; max-width: 500px;\">\n"
"        <thead>\n"
"            <tr style=\"background-color: #f5f5f5;\">\n"
"                <th style=\"padding: 8px; text-align: left; border: 1px solid #ddd;\">Signer</th>\n"
"                <th style=\"padding: 8px; text-align: left; border: 1px solid #ddd;\">Signed On</th>\n"
"            </tr>\n"
"        </thead>\n"
"        <tbody>\n"
"            {% for sig in object.signature_ids.filtered('is_signed') %}\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ sig.partner_id.name }}</td>\n"
"                <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ sig.signed_on.strftime('%Y-%m-%d %H:%M') if sig.signed_on else '-' }}</td>\n"
"            </tr>\n"
"            {% endfor %}\n"
"        </tbody>\n"
"    </table>\n"
"\n"
"    <p style=\"margin: 16px 0px; padding: 0px; font-size: 13px;\">\n"
"        You can view the complete signed meeting minutes by clicking the button below:\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 16px 0px; padding: 0px;\">\n"
"        <a href=\"%7B%7B%20object.get_portal_url()%20%7D%7D\" style=\"display: inline-block; padding: 10px 20px; background-color: #28a745; color: white; text-decoration: none; border-radius: 4px; font-size: 13px;\">\n"
"            View Signed Meeting Minutes\n"
"        </a>\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 16px 0px 0px 0px; padding: 0px; font-size: 13px;\">\n"
"        Best regards,<br/>\n"
"        {{ object.company_id.name or 'The System' }}\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        親愛的 {{ object.user_id.name }}：\n"
"        <br/><br/>\n"
"        所有必要簽署人皆已完成 <strong>{{ object.name }}</strong> 的會議記錄簽署。\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 16px 0px; padding: 0px; font-size: 13px;\">\n"
"        <strong>簽署摘要：</strong>\n"
"    </p>\n"
"\n"
"    <table style=\"border-collapse: collapse; font-size: 13px; width: 100%; max-width: 500px;\">\n"
"        <thead>\n"
"            <tr style=\"background-color: #f5f5f5;\">\n"
"                <th style=\"padding: 8px; text-align: left; border: 1px solid #ddd;\">簽署人</th>\n"
"                <th style=\"padding: 8px; text-align: left; border: 1px solid #ddd;\">簽署時間</th>\n"
"            </tr>\n"
"        </thead>\n"
"        <tbody>\n"
"            {% for sig in object.signature_ids.filtered('is_signed') %}\n"
"            <tr>\n"
"                <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ sig.partner_id.name }}</td>\n"
"                <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ sig.signed_on.strftime('%Y-%m-%d %H:%M') if sig.signed_on else '-' }}</td>\n"
"            </tr>\n"
"            {% endfor %}\n"
"        </tbody>\n"
"    </table>\n"
"\n"
"    <p style=\"margin: 16px 0px; padding: 0px; font-size: 13px;\">\n"
"        您可點擊下方按鈕檢視完整的已簽署會議記錄：\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 16px 0px; padding: 0px;\">\n"
"        <a href=\"%7B%7B%20object.get_portal_url()%20%7D%7D\" style=\"display: inline-block; padding: 10px 20px; background-color: #28a745; color: white; text-decoration: none; border-radius: 4px; font-size: 13px;\">\n"
"            檢視已簽署的會議記錄\n"
"        </a>\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 16px 0px 0px 0px; padding: 0px; font-size: 13px;\">\n"
"        敬祝順安，<br/>\n"
"        {{ object.company_id.name or 'The System' }}\n"
"    </p>\n"
"</div>\n"
"            "

