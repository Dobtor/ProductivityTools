<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================
         用戶群組定義 (User Groups)
         noupdate="0" - 可更新
         ============================================ -->
    <data noupdate="0">

        <!-- 模組分類 -->
        <record id="module_category_productivity" model="ir.module.category">
            <field name="name">Productivity Tools</field>
            <field name="description">Activity management, notes, weekly reports and efficiency analysis</field>
            <field name="sequence">50</field>
        </record>

        <!-- 待辦用戶群組（隱含 base.group_user） -->
        <record id="group_activity_user" model="res.groups">
            <field name="name">Activity User</field>
            <field name="category_id" ref="module_category_productivity"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can create and manage own activities, notes and weekly reports</field>
        </record>

        <!-- 待辦管理者群組（隱含 group_activity_user） -->
        <record id="group_activity_manager" model="res.groups">
            <field name="name">Activity Manager</field>
            <field name="category_id" ref="module_category_productivity"/>
            <field name="implied_ids" eval="[(4, ref('group_activity_user'))]"/>
            <field name="comment">Can view all activities, weekly reports and efficiency analysis</field>
        </record>

    </data>

    <!-- ============================================
         記錄規則 (Record Rules)
         noupdate="1" - 安裝後不更新
         ============================================ -->
    <data noupdate="1">

        <!-- ==========================================
             mail.activity 記錄規則
             ========================================== -->

        <!-- 用戶可存取被指派的待辦 -->
        <record id="mail_activity_rule_user_assigned" model="ir.rule">
            <field name="name">Activity: User Access Assigned Activities</field>
            <field name="model_id" ref="mail.model_mail_activity"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 用戶可存取自己建立的待辦 -->
        <record id="mail_activity_rule_user_created" model="ir.rule">
            <field name="name">Activity: User Access Own Created Activities</field>
            <field name="model_id" ref="mail.model_mail_activity"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 用戶可存取未指派的待辦（唯讀） -->
        <record id="mail_activity_rule_user_unassigned" model="ir.rule">
            <field name="name">Activity: User Access Unassigned Activities</field>
            <field name="model_id" ref="mail.model_mail_activity"/>
            <field name="domain_force">[('user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 管理者可存取所有待辦 -->
        <record id="mail_activity_rule_manager_all" model="ir.rule">
            <field name="name">Activity: Manager Access All Activities</field>
            <field name="model_id" ref="mail.model_mail_activity"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_activity_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ==========================================
             note.note 記錄規則
             ========================================== -->

        <!-- 用戶只能存取自己的筆記 -->
        <record id="note_note_rule_user" model="ir.rule">
            <field name="name">Note: User Access Own Notes Only</field>
            <field name="model_id" ref="model_note_note"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 管理者可存取所有筆記 -->
        <record id="note_note_rule_manager" model="ir.rule">
            <field name="name">Note: Manager Access All Notes</field>
            <field name="model_id" ref="model_note_note"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_activity_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Portal 用戶可存取其參與或需簽名的會議記錄 -->
        <record id="note_note_rule_portal" model="ir.rule">
            <field name="name">Note: Portal Access Meeting Minutes</field>
            <field name="model_id" ref="model_note_note"/>
            <field name="domain_force">[
                ('note_type', '=', 'meeting'),
                '|',
                ('participant_ids', 'in', [user.partner_id.id]),
                ('signer_ids', 'in', [user.partner_id.id])
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ==========================================
             note.signature 記錄規則
             ========================================== -->

        <!-- 用戶可存取自己建立筆記的簽名記錄 -->
        <record id="note_signature_rule_user" model="ir.rule">
            <field name="name">Note Signature: User Access Own Note Signatures</field>
            <field name="model_id" ref="model_note_signature"/>
            <field name="domain_force">[('note_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Portal 用戶可存取與自己相關的簽名記錄 -->
        <record id="note_signature_rule_portal" model="ir.rule">
            <field name="name">Note Signature: Portal Access Own Signatures</field>
            <field name="model_id" ref="model_note_signature"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 管理者可存取所有簽名記錄 -->
        <record id="note_signature_rule_manager" model="ir.rule">
            <field name="name">Note Signature: Manager Access All Signatures</field>
            <field name="model_id" ref="model_note_signature"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_activity_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ==========================================
             note.stage 記錄規則
             ========================================== -->

        <!-- 用戶只能存取自己的階段 -->
        <record id="note_stage_rule_user" model="ir.rule">
            <field name="name">Note Stage: User Access Own Stages Only</field>
            <field name="model_id" ref="model_note_stage"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 管理者可存取所有階段 -->
        <record id="note_stage_rule_manager" model="ir.rule">
            <field name="name">Note Stage: Manager Access All Stages</field>
            <field name="model_id" ref="model_note_stage"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_activity_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ==========================================
             weekly.report 記錄規則
             ========================================== -->

        <!-- 用戶只能存取自己的週報 -->
        <record id="weekly_report_rule_user" model="ir.rule">
            <field name="name">Weekly Report: User Access Own Reports Only</field>
            <field name="model_id" ref="model_weekly_report"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 管理者可存取所有週報 -->
        <record id="weekly_report_rule_manager" model="ir.rule">
            <field name="name">Weekly Report: Manager Access All Reports</field>
            <field name="model_id" ref="model_weekly_report"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_activity_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ==========================================
             weekly.schedule.config 記錄規則
             ========================================== -->

        <!-- 用戶只能存取自己的配置 -->
        <record id="weekly_schedule_config_rule_user" model="ir.rule">
            <field name="name">Weekly Schedule Config: User Access Own Config Only</field>
            <field name="model_id" ref="model_weekly_schedule_config"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 系統管理員可存取所有配置 -->
        <record id="weekly_schedule_config_rule_admin" model="ir.rule">
            <field name="name">Weekly Schedule Config: Admin Access All Configs</field>
            <field name="model_id" ref="model_weekly_schedule_config"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ==========================================
             activity.efficiency.metrics 記錄規則
             ========================================== -->

        <!-- 用戶只能查看自己的效率指標 -->
        <record id="efficiency_metrics_rule_user" model="ir.rule">
            <field name="name">Efficiency Metrics: User View Own Metrics Only</field>
            <field name="model_id" ref="model_activity_efficiency_metrics"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 工時管理員可查看所有效率指標 -->
        <record id="efficiency_metrics_rule_timesheet_manager" model="ir.rule">
            <field name="name">Efficiency Metrics: Timesheet Manager Access All Metrics</field>
            <field name="model_id" ref="model_activity_efficiency_metrics"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_timesheet.group_timesheet_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 待辦管理者可查看所有效率指標 -->
        <record id="efficiency_metrics_rule_activity_manager" model="ir.rule">
            <field name="name">Efficiency Metrics: Activity Manager Access All Metrics</field>
            <field name="model_id" ref="model_activity_efficiency_metrics"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_activity_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ==========================================
             mail.activity.assignment.history 記錄規則
             ========================================== -->

        <!-- 用戶可查看與自己相關的指派歷史 -->
        <record id="assignment_history_rule_user" model="ir.rule">
            <field name="name">Assignment History: User View Related Records</field>
            <field name="model_id" ref="model_mail_activity_assignment_history"/>
            <field name="domain_force">['|', ('previous_user_id', '=', user.id), ('new_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 管理者可存取所有指派歷史 -->
        <record id="assignment_history_rule_manager" model="ir.rule">
            <field name="name">Assignment History: Manager Access All Records</field>
            <field name="model_id" ref="model_mail_activity_assignment_history"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_activity_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ==========================================
             mail.activity.postpone.history 記錄規則
             ========================================== -->

        <!-- 用戶可查看自己延期的歷史或自己待辦的延期歷史 -->
        <record id="postpone_history_rule_user" model="ir.rule">
            <field name="name">Postpone History: User View Related Records</field>
            <field name="model_id" ref="model_mail_activity_postpone_history"/>
            <field name="domain_force">['|', ('postpone_by', '=', user.id), ('activity_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 管理者可存取所有延期歷史 -->
        <record id="postpone_history_rule_manager" model="ir.rule">
            <field name="name">Postpone History: Manager Access All Records</field>
            <field name="model_id" ref="model_mail_activity_postpone_history"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_activity_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
