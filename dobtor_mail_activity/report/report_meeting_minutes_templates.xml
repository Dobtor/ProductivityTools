<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Meeting Minutes Report Template                               -->
    <!-- 會議記錄報告模板                                               -->
    <!-- ============================================================ -->
    <template id="report_meeting_minutes">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- 標題 -->
                        <div class="text-center mb-4">
                            <h2>Meeting Minutes</h2>
                            <h3 t-field="doc.name"/>
                        </div>

                        <!-- 會議資訊（從行事曆事件取得） -->
                        <t t-set="first_event" t-value="doc.calendar_event_ids[:1]"/>
                        <div class="row mb-4">
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tbody>
                                        <tr t-if="first_event">
                                            <th class="text-start" style="width: 35%;">Meeting Date:</th>
                                            <td><span t-field="first_event.start" t-options='{"format": "yyyy-MM-dd HH:mm"}'/></td>
                                        </tr>
                                        <tr t-if="first_event and first_event.location">
                                            <th class="text-start">Location:</th>
                                            <td><t t-esc="first_event.location"/></td>
                                        </tr>
                                        <tr>
                                            <th class="text-start">Prepared By:</th>
                                            <td><t t-esc="doc.user_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <th class="text-start">Status:</th>
                                            <td>
                                                <span t-if="doc.state == 'draft'" class="badge text-bg-secondary">Draft</span>
                                                <span t-if="doc.state == 'sent'" class="badge text-bg-info">Sent</span>
                                                <span t-if="doc.state == 'partial'" class="badge text-bg-warning">Partially Signed</span>
                                                <span t-if="doc.state == 'signed'" class="badge text-bg-success">Fully Signed</span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- 參與者（從行事曆事件取得） -->
                        <div t-if="doc.available_signer_ids" class="mb-4">
                            <h5>Participants</h5>
                            <ul class="list-unstyled">
                                <t t-foreach="doc.available_signer_ids" t-as="participant">
                                    <li>
                                        <i class="fa fa-user fa-fw" title="Participant"/>
                                        <span t-esc="participant.name"/>
                                        <span t-if="participant.email" class="text-muted">
                                            (<t t-esc="participant.email"/>)
                                        </span>
                                    </li>
                                </t>
                            </ul>
                        </div>

                        <!-- 會議內容 -->
                        <div class="mb-4">
                            <h5>Meeting Content</h5>
                            <hr class="mt-1 mb-2"/>
                            <div t-field="doc.memo" class="o_report_memo"/>
                        </div>

                        <!-- 關聯日曆事件 -->
                        <div t-if="doc.calendar_event_ids" class="mb-4">
                            <h5>Related Calendar Events</h5>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Event</th>
                                        <th>Start</th>
                                        <th>End</th>
                                        <th>Location</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.calendar_event_ids" t-as="event">
                                        <tr>
                                            <td><t t-esc="event.name"/></td>
                                            <td><span t-field="event.start" t-options='{"format": "yyyy-MM-dd HH:mm"}'/></td>
                                            <td><span t-field="event.stop" t-options='{"format": "yyyy-MM-dd HH:mm"}'/></td>
                                            <td><t t-esc="event.location"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- 關聯待辦事項 -->
                        <t t-set="active_activities" t-value="doc.note_activity_ids.filtered(lambda a: a.active)"/>
                        <div t-if="active_activities" class="mb-4">
                            <h5>Action Items</h5>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Task</th>
                                        <th>Assignee</th>
                                        <th>Due Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="active_activities" t-as="activity">
                                        <tr>
                                            <td><t t-esc="activity.summary"/></td>
                                            <td><t t-esc="activity.user_id.name"/></td>
                                            <td><span t-field="activity.date_deadline" t-options='{"format": "yyyy-MM-dd"}'/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- 簽名區塊 -->
                        <div t-if="doc.signer_ids" class="mt-5" style="page-break-inside: avoid;">
                            <h5>Signatures</h5>
                            <hr class="mt-1 mb-3"/>
                            <div class="row">
                                <t t-foreach="doc.signature_ids" t-as="sig">
                                    <div class="col-4 mb-4 text-center">
                                        <div t-if="sig.is_signed" class="border p-2">
                                            <img t-att-src="image_data_uri(sig.signature)"
                                                 style="max-height: 80px; max-width: 100%;"/>
                                            <hr class="my-2"/>
                                            <div class="small">
                                                <strong t-field="sig.signed_by"/>
                                                <br/>
                                                <span t-field="sig.partner_id.name"/>
                                                <br/>
                                                <span class="text-muted">
                                                    <span t-field="sig.signed_on" t-options='{"format": "yyyy-MM-dd HH:mm"}'/>
                                                </span>
                                            </div>
                                        </div>
                                        <div t-else="" class="border p-2" style="min-height: 140px;">
                                            <div style="height: 80px; display: flex; align-items: center; justify-content: center;">
                                                <span class="text-muted">Pending Signature</span>
                                            </div>
                                            <hr class="my-2"/>
                                            <div class="small">
                                                <strong t-field="sig.partner_id.name"/>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Meeting Minutes Report Content for Portal                     -->
    <!-- Portal 會議記錄報告內容（用於 HTML 顯示）                        -->
    <!-- ============================================================ -->
    <template id="report_meeting_minutes_content">
        <!-- 會議資訊（從行事曆事件取得） -->
        <t t-set="first_event" t-value="note.calendar_event_ids[:1]"/>
        <div class="row mb-4">
            <div class="col-12 col-md-6">
                <h5 class="mb-1">Meeting Information</h5>
                <hr class="mt-1 mb-2"/>
                <table class="table table-borderless table-sm">
                    <tbody style="white-space:nowrap">
                        <tr t-if="first_event">
                            <th class="ps-0 pb-0">Meeting Date:</th>
                            <td class="w-100 pb-0 text-wrap">
                                <span t-field="first_event.start" t-options='{"format": "yyyy-MM-dd HH:mm"}'/>
                            </td>
                        </tr>
                        <tr t-if="first_event and first_event.location">
                            <th class="ps-0 pb-0">Location:</th>
                            <td class="w-100 pb-0 text-wrap"><t t-esc="first_event.location"/></td>
                        </tr>
                        <tr>
                            <th class="ps-0 pb-0">Prepared By:</th>
                            <td class="w-100 pb-0 text-wrap"><t t-esc="note.user_id.name"/></td>
                        </tr>
                        <tr>
                            <th class="ps-0 pb-0">Created On:</th>
                            <td class="w-100 pb-0 text-wrap">
                                <span t-field="note.create_date" t-options='{"format": "yyyy-MM-dd"}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div t-if="note.available_signer_ids" class="col-12 col-md-6">
                <h5 class="mb-1">Participants</h5>
                <hr class="mt-1 mb-2"/>
                <div class="d-flex flex-wrap gap-2">
                    <t t-foreach="note.available_signer_ids" t-as="participant">
                        <span class="badge rounded-pill text-bg-light border">
                            <i class="fa fa-user me-1" title="Participant"/>
                            <t t-esc="participant.name"/>
                        </span>
                    </t>
                </div>
            </div>
        </div>

        <!-- 會議內容 -->
        <section id="meeting_content" class="mb-4">
            <h5 class="mb-1">Meeting Content</h5>
            <hr class="mt-1 mb-2"/>
            <div t-field="note.memo" class="o_portal_meeting_memo"/>
        </section>

        <!-- 關聯日曆事件 -->
        <section t-if="note.calendar_event_ids" id="meeting_events" class="mb-4">
            <h5 class="mb-1">Related Calendar Events</h5>
            <hr class="mt-1 mb-2"/>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Location</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="note.calendar_event_ids" t-as="event">
                            <tr>
                                <td><t t-esc="event.name"/></td>
                                <td><span t-field="event.start" t-options='{"format": "yyyy-MM-dd HH:mm"}'/></td>
                                <td><span t-field="event.stop" t-options='{"format": "yyyy-MM-dd HH:mm"}'/></td>
                                <td><t t-esc="event.location"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </section>
    </template>

</odoo>
