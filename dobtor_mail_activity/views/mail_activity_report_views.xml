<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 需求六：待辦報告 —— 客戶→專案→相關文件→負責人→狀態 分層清單      -->
    <!-- ============================================================ -->

    <!-- 報告清單（欄位：摘要、緊急、重要、排程日期、截止日期）-->
    <record id="mail_activity_view_list_report" model="ir.ui.view">
        <field name="name">mail.activity.list.report</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="summary"/>
                <field name="urgency"/>
                <field name="importance"/>
                <field name="planned_date"/>
                <field name="date_deadline"/>
                <!-- 分組用欄位（清單隱藏，供 group_by） -->
                <field name="partner_id" column_invisible="1"/>
                <field name="project_id" column_invisible="1"/>
                <field name="res_name" column_invisible="1"/>
                <field name="user_id" column_invisible="1"/>
                <field name="activity_status" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- 報告搜尋（分層 group_by）-->
    <record id="mail_activity_view_search_report" model="ir.ui.view">
        <field name="name">mail.activity.search.report</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <search string="Activity Report">
                <field name="summary"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <field name="res_name"/>
                <filter name="active_activities" string="Active Only"
                        domain="[('active', '=', True)]"/>
                <separator/>
                <group expand="1" string="Group By">
                    <!-- 單一多層過濾器：客戶→專案→相關文件→負責人→狀態（層級穩定）-->
                    <filter name="group_report_hierarchy"
                            string="Customer / Project / Document / Assignee / Status"
                            context="{'group_by': ['partner_id', 'project_id', 'res_name', 'user_id', 'activity_status']}"/>
                    <separator/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_document" string="Related Document" context="{'group_by': 'res_name'}"/>
                    <filter name="group_user" string="Assignee" context="{'group_by': 'user_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'activity_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 報告樞紐分析（列＝客戶/專案，值＝估工/實工）-->
    <record id="mail_activity_view_pivot_report" model="ir.ui.view">
        <field name="name">mail.activity.pivot.report</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <pivot string="Activity Report">
                <field name="partner_id" type="row"/>
                <field name="project_id" type="row"/>
                <field name="estimated_hours" type="measure"/>
                <field name="actual_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- 報告動作 -->
    <record id="action_mail_activity_report" model="ir.actions.act_window">
        <field name="name">Activity Report</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="mail_activity_view_search_report"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('mail_activity_view_list_report')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('mail_activity_view_pivot_report')})]"/>
        <field name="context">{'search_default_group_report_hierarchy': 1, 'search_default_active_activities': 1, 'active_test': False}</field>
    </record>

</odoo>
