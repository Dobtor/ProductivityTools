<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================
         動作型待辦 Wizard 共用「待辦資訊」區塊
         四個 wizard（完成/延期/轉移/改派）皆顯示同一套唯讀待辦資訊，
         欄位由 mail.activity.action.wizard.mixin 提供，確保資訊完整對齊。
         以下每個 form 都重複同一段 group 區塊。
         ===================================================== -->

    <!-- =====================================================
         完成待辦 Wizard (mail.activity.done.wizard)
         ===================================================== -->

    <record id="mail_activity_done_wizard_view_form" model="ir.ui.view">
        <field name="name">mail.activity.done.wizard.form</field>
        <field name="model">mail.activity.done.wizard</field>
        <field name="arch" type="xml">
            <form string="Complete Activity">
                <header>
                    <!-- 刪除：建立者或最高管理者限定，置於左上角 -->
                    <field name="can_delete" invisible="1"/>
                    <button name="action_delete_activity" type="object"
                            string="Delete" class="btn-danger"
                            invisible="not can_delete"
                            confirm="Delete this to-do permanently? This cannot be undone."/>
                </header>
                <field name="activity_id" invisible="1"/>
                <field name="schedule_next" invisible="1"/>

                <!-- 摘要 -->
                <div class="oe_title">
                    <h1>
                        <field name="summary" readonly="1" placeholder="Activity summary"/>
                    </h1>
                </div>

                <!-- 待辦資訊（統一區塊）-->
                <group>
                    <group string="Activity Information">
                        <field name="activity_type_name"/>
                        <field name="date_deadline"/>
                        <field name="planned_date"/>
                        <field name="estimated_hours" widget="float_time"/>
                    </group>
                    <group string="Priority &amp; Assignment">
                        <field name="urgency"/>
                        <field name="importance"/>
                        <field name="assignee_id" widget="many2one_avatar_user"/>
                    </group>
                </group>
                <group string="Related Information">
                    <field name="res_display"/>
                    <field name="note_id"/>
                </group>

                <!-- 完成專屬：工時 -->
                <group string="Time Information">
                    <field name="accumulated_hours" widget="float_time" readonly="1"/>
                    <field name="actual_hours" widget="float_time"/>
                </group>

                <notebook>
                    <page string="Feedback" name="feedback">
                        <field name="feedback" nolabel="1" placeholder="Enter completion feedback or description..."/>
                    </page>
                    <page string="Attachments" name="attachments">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </page>
                    <page string="Schedule Next Activity" name="schedule_next" invisible="not schedule_next">
                        <group>
                            <field name="next_activity_type_id" invisible="not schedule_next"/>
                            <field name="next_date_deadline" invisible="not schedule_next"/>
                            <field name="next_summary" invisible="not schedule_next"/>
                            <field name="next_user_id" widget="many2one_avatar_user" invisible="not schedule_next"/>
                        </group>
                    </page>
                </notebook>
                <footer>
                    <button string="Complete" name="action_done" type="object" class="btn-primary"/>
                    <button string="Log and Continue" name="action_log_and_continue" type="object"
                            class="btn-secondary" title="Log time only, do not complete activity"/>
                    <button string="Complete and Schedule Next" name="action_done_and_schedule_next" type="object"
                            class="btn-secondary"
                            context="{'default_schedule_next': True}"/>
                    <button string="Postpone to Next Week" name="action_postpone" type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mail_activity_done_wizard" model="ir.actions.act_window">
        <field name="name">Complete Activity</field>
        <field name="res_model">mail.activity.done.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- =====================================================
         延期待辦 Wizard (mail.activity.postpone.wizard)
         ===================================================== -->

    <record id="mail_activity_postpone_wizard_view_form" model="ir.ui.view">
        <field name="name">mail.activity.postpone.wizard.form</field>
        <field name="model">mail.activity.postpone.wizard</field>
        <field name="arch" type="xml">
            <form string="Postpone to Next Week">
                <field name="activity_id" invisible="1"/>
                <field name="activity_ids" invisible="1"/>
                <field name="activity_count" invisible="1"/>
                <field name="is_batch" invisible="1"/>

                <!-- 摘要（單筆）-->
                <div class="oe_title" invisible="is_batch">
                    <h1>
                        <field name="summary" readonly="1" placeholder="Activity summary"/>
                    </h1>
                </div>

                <!-- 批次橫幅 -->
                <div class="alert alert-warning" role="alert" invisible="not is_batch">
                    <i class="fa fa-clock-o me-1"/>
                    <span>The selected activities will be postponed to next week. Only scheduled and active activities will be affected.</span>
                </div>

                <!-- 待辦資訊（統一區塊，單筆顯示）-->
                <group invisible="is_batch">
                    <group string="Activity Information">
                        <field name="activity_type_name"/>
                        <field name="date_deadline"/>
                        <field name="planned_date"/>
                        <field name="estimated_hours" widget="float_time"/>
                    </group>
                    <group string="Priority &amp; Assignment">
                        <field name="urgency"/>
                        <field name="importance"/>
                        <field name="assignee_id" widget="many2one_avatar_user"/>
                    </group>
                </group>
                <group string="Related Information" invisible="is_batch">
                    <field name="res_display"/>
                    <field name="note_id"/>
                </group>

                <!-- 延期專屬（單筆）-->
                <group string="Postpone" invisible="is_batch">
                    <field name="postpone_count" readonly="1"/>
                </group>

                <div class="alert alert-info" role="alert" invisible="is_batch or postpone_count == 0">
                    <i class="fa fa-info-circle"/>
                    This activity has been postponed <field name="postpone_count" readonly="1" nolabel="1" class="d-inline"/> times.
                </div>

                <notebook>
                    <page string="Postpone Reason" name="reason">
                        <field name="reason" nolabel="1" placeholder="Please explain the reason for postponement..." required="1"/>
                    </page>
                </notebook>
                <footer>
                    <button string="Confirm Postpone" name="action_postpone" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mail_activity_postpone_wizard" model="ir.actions.act_window">
        <field name="name">Postpone to Next Week</field>
        <field name="res_model">mail.activity.postpone.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- =====================================================
         轉移待辦 Wizard (mail.activity.transfer.wizard)
         ===================================================== -->

    <record id="mail_activity_transfer_wizard_view_form" model="ir.ui.view">
        <field name="name">mail.activity.transfer.wizard.form</field>
        <field name="model">mail.activity.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Activity">
                <field name="activity_id" invisible="1"/>
                <field name="source_model" invisible="1"/>
                <field name="source_id" invisible="1"/>

                <!-- 摘要 -->
                <div class="oe_title">
                    <h1>
                        <field name="summary" readonly="1" placeholder="Activity summary"/>
                    </h1>
                </div>

                <!-- 待辦資訊（統一區塊）-->
                <group>
                    <group string="Activity Information">
                        <field name="activity_type_name"/>
                        <field name="date_deadline"/>
                        <field name="planned_date"/>
                        <field name="estimated_hours" widget="float_time"/>
                    </group>
                    <group string="Priority &amp; Assignment">
                        <field name="urgency"/>
                        <field name="importance"/>
                        <field name="assignee_id" widget="many2one_avatar_user"/>
                    </group>
                </group>
                <group string="Related Information">
                    <field name="res_display" string="Source Document"/>
                    <field name="note_id"/>
                </group>

                <!-- 轉移專屬：目標 -->
                <group string="Transfer Target">
                    <field name="target_ref" string="Target Record" options="{'no_create': True}" required="1"/>
                </group>

                <div class="alert alert-info" role="alert">
                    <i class="fa fa-info-circle"/>
                    After transfer, the activity will be linked to the selected target record. The original source will be recorded for tracking.
                </div>
                <footer>
                    <button string="Transfer" name="action_transfer" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mail_activity_transfer_wizard" model="ir.actions.act_window">
        <field name="name">Transfer Activity</field>
        <field name="res_model">mail.activity.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- =====================================================
         變更指派 Wizard (mail.activity.reassign.wizard)
         ===================================================== -->

    <record id="mail_activity_reassign_wizard_view_form" model="ir.ui.view">
        <field name="name">mail.activity.reassign.wizard.form</field>
        <field name="model">mail.activity.reassign.wizard</field>
        <field name="arch" type="xml">
            <form string="Reassign Activity">
                <field name="activity_id" invisible="1"/>

                <!-- 摘要 -->
                <div class="oe_title">
                    <h1>
                        <field name="summary" readonly="1" placeholder="Activity summary"/>
                    </h1>
                </div>

                <!-- 待辦資訊（統一區塊）-->
                <group>
                    <group string="Activity Information">
                        <field name="activity_type_name"/>
                        <field name="date_deadline"/>
                        <field name="planned_date"/>
                        <field name="estimated_hours" widget="float_time"/>
                    </group>
                    <group string="Priority &amp; Assignment">
                        <field name="urgency"/>
                        <field name="importance"/>
                        <field name="assignee_id" widget="many2one_avatar_user" string="Current Assignee"/>
                    </group>
                </group>
                <group string="Related Information">
                    <field name="res_display"/>
                    <field name="note_id"/>
                </group>

                <!-- 改派專屬：新指派 -->
                <group string="New Assignment">
                    <field name="new_user_id"
                           widget="many2one_avatar_user"
                           options="{'no_create': True}"
                           required="1"/>
                    <field name="reason" placeholder="Explain reason for change (optional)..."/>
                </group>

                <div class="alert alert-warning" role="alert">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    After confirmation, the original activity will be cancelled and a new activity will be created for the selected assignee.
                    All related history will be preserved.
                </div>
                <footer>
                    <button name="action_confirm" string="Confirm Change"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mail_activity_reassign_wizard" model="ir.actions.act_window">
        <field name="name">Reassign Activity</field>
        <field name="res_model">mail.activity.reassign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
