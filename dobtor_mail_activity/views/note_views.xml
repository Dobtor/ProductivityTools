<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- note.note Kanban View                                         -->
    <!-- 筆記本看板視圖，依階段分組                                      -->
    <!-- ============================================================ -->
    <record id="view_note_note_kanban" model="ir.ui.view">
        <field name="name">note.note.kanban</field>
        <field name="model">note.note</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id"
                    class="o_kanban_small_column"
                    on_create="quick_create"
                    quick_create_view="dobtor_mail_activity.view_note_note_quick_create"
                    archivable="true"
                    sample="1">
                <field name="color"/>
                <field name="stage_id"/>
                <field name="user_id"/>
                <field name="tag_ids"/>
                <field name="note_active_activity_count"/>
                <field name="active"/>
                <field name="open"/>

                <templates>
                    <t t-name="menu">
                        <a role="menuitem" type="archive" class="dropdown-item">Archive</a>
                        <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card" class="flex-row">
                        <aside>
                            <field name="color" widget="color_picker"/>
                        </aside>
                        <main class="ms-2 w-100">
                            <div class="o_kanban_record_title mb-1">
                                <field name="name" placeholder="(No Title)"/>
                            </div>
                            <div class="o_kanban_record_body text-muted small">
                                <field name="memo" class="text-truncate"/>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="tag_ids" widget="many2many_tags"
                                           options="{'color_field': 'color'}"/>
                                </div>
                                <div class="oe_kanban_bottom_right d-flex align-items-center">
                                    <span t-if="record.note_active_activity_count.raw_value > 0"
                                          class="badge text-bg-primary me-2"
                                          title="Active Activities">
                                        <i class="fa fa-tasks" title="Activities"/>
                                        <field name="note_active_activity_count"/>
                                    </span>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- note.note Quick Create Form                                   -->
    <!-- 筆記本快速建立表單                                             -->
    <!-- ============================================================ -->
    <record id="view_note_note_quick_create" model="ir.ui.view">
        <field name="name">note.note.quick.create</field>
        <field name="model">note.note</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="memo" string="Note Content" placeholder="Enter note content..." widget="text"/>
                </group>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- note.note List View                                           -->
    <!-- 筆記本清單視圖                                                 -->
    <!-- ============================================================ -->
    <record id="view_note_note_list" model="ir.ui.view">
        <field name="name">note.note.list</field>
        <field name="model">note.note</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <list string="Notes" expand="1">
                <field name="name" string="Title"/>
                <field name="stage_id" string="Stage"
                       column_invisible="context.get('hide_stage')"
                       optional="show"/>
                <field name="state" string="Status" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('sent', 'partial')"
                       decoration-success="state == 'signed'"
                       column_invisible="context.get('hide_state')"
                       optional="show"/>
                <field name="tag_ids" string="Tags" widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
                <field name="user_id" string="Owner" widget="many2one_avatar_user"/>
                <field name="activity_ids" string="Next Activity" widget="list_activity"/>
                <field name="signed_count" string="Signed" optional="hide"/>
                <field name="signature_count" string="Total Signers" optional="hide"/>
                <field name="note_active_activity_count" string="Active Activities" optional="hide"/>
                <field name="create_date" string="Created" widget="date" optional="show"/>
                <field name="write_date" string="Updated" widget="date" optional="show"/>
                <field name="open" string="Open" optional="hide"/>
                <field name="date_done" string="Completed Date" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- note.note Form View                                           -->
    <!-- 筆記本表單視圖                                                 -->
    <!-- ============================================================ -->
    <record id="view_note_note_form" model="ir.ui.view">
        <field name="name">note.note.form</field>
        <field name="model">note.note</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="Note">
                <header>
                    <!-- 會議記錄按鈕（只有在有關聯日曆事件時才顯示） -->
                    <button name="action_send_for_signature" type="object"
                            string="Send for Signature" class="btn-primary"
                            icon="fa-paper-plane"
                            invisible="note_type != 'meeting' or state != 'draft' or calendar_event_count == 0"/>
                    <button name="action_preview_portal" type="object"
                            string="Preview in Portal" class="btn-secondary"
                            icon="fa-eye"
                            invisible="note_type != 'meeting' or calendar_event_count == 0"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft" class="btn-secondary"
                            invisible="note_type != 'meeting' or state == 'draft'"
                            confirm="This will reset the meeting minutes to draft and clear all signatures. Continue?"/>

                    <!-- 筆記按鈕（僅會議記錄顯示排程會議） -->
                    <button name="action_add_calendar_event" type="object"
                            string="Schedule Meeting" class="btn-secondary"
                            icon="fa-calendar-plus-o"
                            invisible="note_type != 'meeting'"/>

                    <!-- 狀態列 -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,partial,signed"
                           invisible="note_type != 'meeting' or calendar_event_count == 0"/>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': '1', 'fold_field': 'fold'}"
                           domain="[('user_id', '=', uid)]"
                           invisible="note_type == 'meeting'"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <field name="open" invisible="1"/>
                    <field name="note_type" invisible="1"/>
                    <field name="is_locked" invisible="1"/>
                    <field name="note_activity_count" invisible="1"/>
                    <field name="calendar_event_count" invisible="1"/>
                    <field name="signature_count" invisible="1"/>
                    <field name="available_signer_ids" invisible="1"/>

                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <widget name="web_ribbon" title="Fully Signed" bg_color="text-bg-success"
                            invisible="state != 'signed' or calendar_event_count == 0"/>
                    <widget name="web_ribbon" title="Locked" bg_color="text-bg-warning"
                            invisible="not is_locked or state == 'signed' or calendar_event_count == 0"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_signatures" type="object"
                                class="oe_stat_button" icon="fa-pencil"
                                invisible="note_type != 'meeting' or signature_count == 0 or calendar_event_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="signed_count" nolabel="1"/>/<field name="signature_count" nolabel="1"/>
                                </span>
                                <span class="o_stat_text">Signatures</span>
                            </div>
                        </button>
                        <button name="action_view_calendar_events" type="object"
                                class="oe_stat_button" icon="fa-calendar"
                                invisible="calendar_event_count == 0">
                            <field name="calendar_event_count" widget="statinfo" string="Events"/>
                        </button>
                        <button name="action_view_activities" type="object"
                                class="oe_stat_button" icon="fa-tasks"
                                invisible="note_activity_count == 0">
                            <field name="note_active_activity_count" widget="statinfo" string="In Progress"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Title"/>
                        <h1>
                            <field name="name" placeholder="Note title..."/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="note_type" string="Type" widget="radio"
                                   options="{'horizontal': true}"
                                   readonly="is_locked"/>
                            <field name="user_id" string="Owner" widget="many2one_avatar_user"/>
                            <field name="tag_ids" string="Tags" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </group>
                        <group>
                            <field name="date_done" string="Completed Date" invisible="open or note_type == 'meeting'"/>
                            <field name="color" widget="color_picker" string="Color"/>
                        </group>
                    </group>

                    <!-- 鎖定提示 -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not is_locked or calendar_event_count == 0">
                        <i class="fa fa-lock me-2" title="Locked"/>
                        <strong>This meeting minutes is locked.</strong>
                        Content cannot be modified after sending for signature.
                        To make changes, please click "Reset to Draft" (this will clear all existing signatures).
                    </div>

                    <!-- 簽名者設定（只有在有關聯日曆事件時才顯示，從行事曆參與者中選擇） -->
                    <group string="Signature Settings"
                           invisible="note_type != 'meeting' or calendar_event_count == 0">
                        <group colspan="2">
                            <field name="signer_ids" string="Required Signers"
                                   widget="many2many_tags"
                                   options="{'color_field': 'color'}"
                                   domain="[('id', 'in', available_signer_ids)]"
                                   readonly="is_locked"
                                   help="Select signers from calendar event attendees"/>
                        </group>
                    </group>

                    <!-- 提示：需要先關聯日曆事件 -->
                    <div class="alert alert-info" role="alert"
                         invisible="note_type != 'meeting' or calendar_event_count > 0">
                        <i class="fa fa-info-circle me-2" title="Information"/>
                        <strong>Link a calendar event to enable meeting minutes features.</strong>
                        Use the "Calendar Events" tab below to link an existing event or schedule a new meeting.
                        The meeting attendees will become available as signers.
                    </div>

                    <notebook>
                        <page string="Content" name="content">
                            <field name="memo" placeholder="Enter note content here..."
                                   options="{'codeview': true,'collaborative': true}"
                                   readonly="is_locked and note_type == 'meeting'"/>
                        </page>
                        <page string="Signatures" name="signatures"
                              invisible="note_type != 'meeting' or signature_count == 0 or calendar_event_count == 0">
                            <field name="signature_ids">
                                <list create="false" delete="false" editable="bottom">
                                    <field name="partner_id" string="Signer"/>
                                    <field name="is_signed" string="Signed" widget="boolean_toggle" readonly="1"/>
                                    <field name="signed_by" string="Signed By"/>
                                    <field name="signed_on" string="Signed On"/>
                                    <field name="signature" string="Signature" widget="image" options="{'size': [100, 50]}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Related Activities" name="activities" invisible="note_activity_count == 0">
                            <field name="note_activity_ids" context="{'active_test': False}">
                                <list>
                                    <field name="summary" string="Summary"/>
                                    <field name="activity_type_id" string="Type"/>
                                    <field name="user_id" string="Assignee" widget="many2one_avatar_user"/>
                                    <field name="date_deadline" string="Due Date" widget="remaining_days"/>
                                    <field name="activity_status" string="Status" widget="badge"
                                           decoration-success="activity_status == 'done'"
                                           decoration-danger="activity_status == 'cancelled'"
                                           decoration-info="activity_status == 'active'"/>
                                    <button name="action_transfer_activity" type="object"
                                            string="Transfer" icon="fa-exchange"
                                            invisible="activity_status != 'active'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Calendar Events" name="calendar_events"
                              invisible="note_type != 'meeting'">
                            <group>
                                <group>
                                    <button name="action_add_calendar_event" type="object"
                                            string="Schedule Meeting" class="btn-secondary"
                                            icon="fa-calendar-plus-o" colspan="2"/>
                                </group>
                            </group>
                            <field name="calendar_event_ids">
                                <list>
                                    <field name="name" string="Meeting"/>
                                    <field name="start" string="Start"/>
                                    <field name="stop" string="End"/>
                                    <field name="location" string="Location" optional="show"/>
                                    <field name="user_id" string="Organizer" widget="many2one_avatar_user"/>
                                    <field name="partner_ids" string="Attendees" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- note.note Search View                                         -->
    <!-- 筆記本搜尋視圖                                                 -->
    <!-- ============================================================ -->
    <record id="view_note_note_search" model="ir.ui.view">
        <field name="name">note.note.search</field>
        <field name="model">note.note</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <search string="Search Notes">
                <field name="name" string="Title"/>
                <field name="memo" string="Content"/>
                <field name="user_id" string="Owner"/>
                <field name="tag_ids" string="Tags"/>
                <field name="stage_id" string="Stage"/>

                <separator/>
                <filter string="My Notes" name="my_notes"
                        domain="[('user_id', '=', uid)]"/>
                <filter string="Open" name="open_true"
                        domain="[('open', '=', True)]"/>
                <filter string="Completed" name="open_false"
                        domain="[('open', '=', False)]"/>

                <separator/>
                <filter string="Notes" name="type_note"
                        domain="[('note_type', '=', 'note')]"/>
                <filter string="Meeting Minutes" name="type_meeting"
                        domain="[('note_type', '=', 'meeting')]"/>

                <separator/>
                <filter string="Draft" name="state_draft"
                        domain="[('state', '=', 'draft'), ('note_type', '=', 'meeting')]"/>
                <filter string="Sent" name="state_sent"
                        domain="[('state', '=', 'sent'), ('note_type', '=', 'meeting')]"/>
                <filter string="Partially Signed" name="state_partial"
                        domain="[('state', '=', 'partial'), ('note_type', '=', 'meeting')]"/>
                <filter string="Fully Signed" name="state_signed"
                        domain="[('state', '=', 'signed'), ('note_type', '=', 'meeting')]"/>

                <separator/>
                <filter string="Archived" name="archived"
                        domain="[('active', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'note_type'}"/>
                    <filter string="Stage" name="group_stage"
                            context="{'group_by': 'stage_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Owner" name="group_user"
                            context="{'group_by': 'user_id'}"/>
                    <filter string="Tag" name="group_tag"
                            context="{'group_by': 'main_tag_id'}"/>
                </group>

                <searchpanel>
                    <field name="main_tag_id"
                           select="one"
                           icon="fa-tag"
                           string="Tags"
                           enable_counters="1"
                           expand="0"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Actions                                                       -->
    <!-- ============================================================ -->

    <!-- Action - 所有筆記（僅一般筆記） -->
    <record id="action_note_note" model="ir.actions.act_window">
        <field name="name">All Notes</field>
        <field name="res_model">note.note</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('note_type', '=', 'note')]</field>
        <field name="context">{'search_default_open_true': 1, 'search_default_group_stage': 1, 'default_note_type': 'note', 'hide_state': True}</field>
        <field name="search_view_id" ref="view_note_note_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first note</p>
            <p>Use the notebook to record ideas, activities, and important information.</p>
        </field>
    </record>

    <record model="ir.actions.act_window.view" id="action_note_note_list">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_note_note_list"/>
        <field name="act_window_id" ref="action_note_note"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_note_note_kanban">
        <field name="sequence">2</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_note_note_kanban"/>
        <field name="act_window_id" ref="action_note_note"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_note_note_form">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_note_note_form"/>
        <field name="act_window_id" ref="action_note_note"/>
    </record>

    <!-- Action - 個人筆記（當前使用者的一般筆記） -->
    <record id="action_note_only" model="ir.actions.act_window">
        <field name="name">My Notes</field>
        <field name="res_model">note.note</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('note_type', '=', 'note'), ('user_id', '=', uid)]</field>
        <field name="context">{'search_default_open_true': 1, 'search_default_group_stage': 1, 'default_note_type': 'note', 'hide_state': True}</field>
        <field name="search_view_id" ref="view_note_note_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first note</p>
            <p>Use the notebook to record ideas, activities, and important information.</p>
        </field>
    </record>

    <record model="ir.actions.act_window.view" id="action_note_only_list">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_note_note_list"/>
        <field name="act_window_id" ref="action_note_only"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_note_only_kanban">
        <field name="sequence">2</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_note_note_kanban"/>
        <field name="act_window_id" ref="action_note_only"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_note_only_form">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_note_note_form"/>
        <field name="act_window_id" ref="action_note_only"/>
    </record>

    <!-- Action - 會議記錄 -->
    <record id="action_meeting_minutes" model="ir.actions.act_window">
        <field name="name">Meeting Minutes</field>
        <field name="res_model">note.note</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('note_type', '=', 'meeting')]</field>
        <field name="context">{'search_default_open_true': 1, 'default_note_type': 'meeting', 'hide_stage': True}</field>
        <field name="search_view_id" ref="view_note_note_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first meeting minutes</p>
            <p>Record meeting discussions, decisions, and action items.</p>
        </field>
    </record>

    <record model="ir.actions.act_window.view" id="action_meeting_minutes_list">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_note_note_list"/>
        <field name="act_window_id" ref="action_meeting_minutes"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_meeting_minutes_kanban">
        <field name="sequence">2</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_note_note_kanban"/>
        <field name="act_window_id" ref="action_meeting_minutes"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_meeting_minutes_form">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_note_note_form"/>
        <field name="act_window_id" ref="action_meeting_minutes"/>
    </record>

</odoo>
