<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--               公司表單擴展 - 加入工時設定                        -->
    <!-- ============================================================ -->
    <record id="res_company_view_form_inherit_productivity" model="ir.ui.view">
        <field name="name">res.company.view.form.inherit.productivity</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="生產力設定" name="productivity">
                    <group>
                        <group string="工時表設定">
                            <field name="default_timesheet_project_id"
                                   domain="[('allow_timesheets', '=', True), '|', ('company_id', '=', False), ('company_id', '=', id)]"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle me-1"/>
                        當待辦完成時，若無關聯專案，系統將使用此預設專案建立工時表記錄。
                        請確保選擇的專案已啟用工時表功能。
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
