<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--               公司表單擴展 - 加入工時設定                        -->
    <!-- ============================================================ -->
    <record id="res_company_view_form_inherit_productivity" model="ir.ui.view">
        <field name="name">res.company.view.form.inherit.productivity</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Productivity Settings" name="productivity">
                    <group>
                        <group string="Timesheet Settings">
                            <field name="default_timesheet_project_id"
                                   domain="[('allow_timesheets', '=', True), '|', ('company_id', '=', False), ('company_id', '=', id)]"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle me-1"/>
                        When an activity is completed without a linked project, the system will use this default project to create timesheet entries.
                        Please ensure the selected project has timesheet feature enabled.
                    </div>

                    <group>
                        <group string="Transcription Settings">
                            <field name="transcription_provider"/>
                            <field name="transcription_service_url"
                                   invisible="transcription_provider != 'remote'"/>
                            <field name="transcription_model_size"
                                   invisible="transcription_provider != 'remote'"/>
                            <field name="transcription_language"/>
                        </group>
                        <group string="Summary Settings">
                            <field name="summary_provider"/>
                            <field name="summary_api_url"
                                   invisible="summary_provider != 'ollama'"/>
                            <field name="summary_model_name"
                                   invisible="summary_provider != 'ollama'"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        <i class="fa fa-key me-1"/>
                        API keys are managed securely in <b>Settings &gt; Productivity Tools</b>.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
