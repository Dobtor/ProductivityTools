<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                      週報告 Form View                         -->
    <!-- ============================================================ -->
    <record id="weekly_report_view_form" model="ir.ui.view">
        <field name="name">weekly.report.view.form</field>
        <field name="model">weekly.report</field>
        <field name="arch" type="xml">
            <form string="Weekly Report">
                <header>
                    <button name="action_generate_report" type="object" string="Generate Report"
                            class="btn-primary"
                            invisible="state == 'confirmed'"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary"
                            invisible="state == 'confirmed'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="week_start"/>
                            <field name="week_end" readonly="1"/>
                            <field name="week_number" readonly="1"/>
                            <field name="previous_report_id" readonly="1"/>
                        </group>
                        <group string="Statistics">
                            <field name="total_planned_hours" widget="float_time" string="This Week Planned Hours" readonly="1"/>
                            <field name="total_review_planned_hours" widget="float_time" string="Last Week Planned Hours" readonly="1"/>
                            <field name="total_review_actual_hours" widget="float_time" string="Last Week Actual Hours" readonly="1"/>
                            <field name="completion_rate" widget="progressbar" readonly="1"/>
                            <field name="planned_completion_rate" widget="progressbar" readonly="1"/>
                            <field name="inserted_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Last Week Review" name="review">
                            <field name="previous_week_review_ids" readonly="1">
                                <list decoration-muted="status == 'cancelled'"
                                      decoration-danger="status == 'pending'"
                                      decoration-warning="status == 'postponed'">
                                    <field name="summary"/>
                                    <field name="source" widget="badge"
                                           decoration-info="source == 'planned'"
                                           decoration-warning="source == 'inserted'"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'completed'"
                                           decoration-warning="status == 'postponed'"
                                           decoration-danger="status == 'pending'"
                                           decoration-muted="status == 'cancelled'"/>
                                    <field name="planned_hours" widget="float_time"/>
                                    <field name="actual_hours" widget="float_time"/>
                                    <field name="hours_diff" widget="float_time"
                                           decoration-danger="hours_diff > 0"
                                           decoration-success="hours_diff &lt; 0"/>
                                    <field name="planned_date"/>
                                    <field name="done_date" widget="date"/>
                                </list>
                            </field>
                        </page>
                        <page string="This Week Plan" name="this_week">
                            <group>
                                <group>
                                    <field name="total_planned_hours" widget="float_time" readonly="1"/>
                                </group>
                            </group>
                            <field name="this_week_activity_ids" readonly="1">
                                <list>
                                    <field name="summary"/>
                                    <field name="estimated_hours" widget="float_time"/>
                                    <field name="planned_date"/>
                                    <field name="date_deadline"/>
                                    <field name="schedule_origin" widget="badge"
                                           decoration-info="schedule_origin == 'planned'"
                                           decoration-warning="schedule_origin == 'inserted'"
                                           decoration-muted="schedule_origin == 'postponed'"
                                           decoration-success="schedule_origin == 'transferred'"/>
                                    <field name="urgency" widget="badge"
                                           decoration-danger="urgency == 'urgent'"
                                           decoration-success="urgency == 'flexible'"/>
                                    <field name="importance"/>
                                </list>
                            </field>
                        </page>
                        <page string="This Week Plan Snapshot" name="snapshot" groups="base.group_no_one">
                            <p class="text-muted">This snapshot will be used for next week report comparison. Cannot be modified after confirmation.</p>
                            <field name="this_week_snapshot_ids" readonly="1">
                                <list>
                                    <field name="summary"/>
                                    <field name="estimated_hours" widget="float_time"/>
                                    <field name="planned_date"/>
                                    <field name="date_deadline"/>
                                    <field name="urgency" widget="badge"/>
                                    <field name="importance"/>
                                </list>
                            </field>
                        </page>
                        <page string="Future Schedule" name="future">
                            <field name="future_activity_ids" readonly="1">
                                <list>
                                    <field name="summary"/>
                                    <field name="estimated_hours" widget="float_time"/>
                                    <field name="planned_date"/>
                                    <field name="scheduled_date"/>
                                    <field name="date_deadline"/>
                                    <field name="schedule_week"/>
                                    <field name="urgency" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Unscheduled" name="unscheduled">
                            <field name="unscheduled_activity_ids" readonly="1">
                                <list>
                                    <field name="summary"/>
                                    <field name="estimated_hours" widget="float_time"/>
                                    <field name="date_deadline"/>
                                    <field name="schedule_warning"/>
                                    <field name="urgency" widget="badge"
                                           decoration-danger="urgency == 'urgent'"
                                           decoration-success="urgency == 'flexible'"/>
                                    <field name="importance"/>
                                </list>
                            </field>
                        </page>
                        <page string="Self Evaluation" name="evaluation">
                            <field name="self_evaluation" widget="html" placeholder="Self evaluation and suggestions for next week improvement..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                      週報告 List View                         -->
    <!-- ============================================================ -->
    <record id="weekly_report_view_list" model="ir.ui.view">
        <field name="name">weekly.report.view.list</field>
        <field name="model">weekly.report</field>
        <field name="arch" type="xml">
            <list string="Weekly Reports">
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="week_start"/>
                <field name="week_end"/>
                <field name="total_planned_hours" widget="float_time" string="This Week Plan"/>
                <field name="total_review_actual_hours" widget="float_time" string="Last Week Actual"/>
                <field name="completion_rate" widget="progressbar"/>
                <field name="inserted_count" string="Inserted Activities"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                     週報告 Search View                        -->
    <!-- ============================================================ -->
    <record id="weekly_report_view_search" model="ir.ui.view">
        <field name="name">weekly.report.view.search</field>
        <field name="model">weekly.report</field>
        <field name="arch" type="xml">
            <search string="Weekly Report">
                <field name="name"/>
                <field name="user_id"/>
                <field name="week_number"/>
                <separator/>
                <filter string="My Reports" name="my_reports"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="By User" name="group_by_user" context="{'group_by': 'user_id'}"/>
                    <filter string="By Month" name="group_by_month" context="{'group_by': 'week_start:month'}"/>
                    <filter string="By Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--              週報告計畫快照 List View (Inline)                 -->
    <!-- ============================================================ -->
    <record id="weekly_report_snapshot_line_view_list" model="ir.ui.view">
        <field name="name">weekly.report.snapshot.line.view.list</field>
        <field name="model">weekly.report.snapshot.line</field>
        <field name="arch" type="xml">
            <list string="Plan Snapshot" editable="bottom">
                <field name="report_id" column_invisible="1"/>
                <field name="activity_id" readonly="1"/>
                <field name="summary"/>
                <field name="estimated_hours" widget="float_time"/>
                <field name="planned_date"/>
                <field name="date_deadline"/>
                <field name="urgency" widget="badge"/>
                <field name="importance"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--              週報告執行回顧 List View (Inline)                 -->
    <!-- ============================================================ -->
    <record id="weekly_report_review_line_view_list" model="ir.ui.view">
        <field name="name">weekly.report.review.line.view.list</field>
        <field name="model">weekly.report.review.line</field>
        <field name="arch" type="xml">
            <list string="Execution Review"
                  decoration-muted="status == 'cancelled'"
                  decoration-danger="status == 'pending'"
                  decoration-warning="status == 'postponed'">
                <field name="report_id" column_invisible="1"/>
                <field name="summary"/>
                <field name="source" widget="badge"
                       decoration-info="source == 'planned'"
                       decoration-warning="source == 'inserted'"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'completed'"
                       decoration-warning="status == 'postponed'"
                       decoration-danger="status == 'pending'"
                       decoration-muted="status == 'cancelled'"/>
                <field name="planned_hours" widget="float_time" sum="Total"/>
                <field name="actual_hours" widget="float_time" sum="Total"/>
                <field name="hours_diff" widget="float_time" sum="Total"
                       decoration-danger="hours_diff > 0"
                       decoration-success="hours_diff &lt; 0"/>
                <field name="planned_date"/>
                <field name="done_date" widget="date"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                      週報告 Action                            -->
    <!-- ============================================================ -->
    <record id="action_weekly_report" model="ir.actions.act_window">
        <field name="name">My Reports</field>
        <field name="res_model">weekly.report</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_reports': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first weekly report</p>
            <p>Weekly reports help you track weekly work execution, including last week review and this week plan.</p>
        </field>
    </record>

    <!-- 所有週報告（管理員用）-->
    <record id="action_weekly_report_all" model="ir.actions.act_window">
        <field name="name">All Weekly Reports</field>
        <field name="res_model">weekly.report</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">View all users' weekly reports</p>
        </field>
    </record>

</odoo>
