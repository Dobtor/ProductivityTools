    <!-- ============================================================ -->
    <!--              我建立的待辦 Form View (禁止排程操作)               -->
    <!-- ============================================================ -->
    <record id="mail_activity_view_form_created" model="ir.ui.view">
        <field name="name">mail.activity.view.form.created</field>
        <field name="model">mail.activity</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <!-- string 與 action/選單同名，讓既有 zh_TW 條目的四個 #: 參照
                 （action name / menu name / 本表單 / 清單）一次涵蓋 -->
            <form string="All To-dos">
                <header>
                    <!-- 操作按鈕置於 header 最左（Odoo 標準位置；此表單無排程 statusbar）
                         本表單現由「待辦總覽」使用，會開到別人建立的待辦 →
                         改派／取消只對建立者（或系統管理員）開放，條件與
                         mail_activity_view_form_schedule 一致 -->
                    <button name="action_transfer_activity" type="object"
                            string="Transfer"
                            invisible="not active"/>
                    <button name="action_reassign_activity" type="object"
                            string="Reassign"
                            invisible="not active or not can_edit_as_creator"/>
                    <button name="action_open_document" type="object"
                            string="Document"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-secondary"
                            invisible="not active or not (can_edit_as_creator or can_edit_as_assignee)"/>
                    <button name="action_restore" type="object"
                            string="Restore"
                            invisible="active or not can_edit_as_creator"/>
                </header>
                <sheet>
                    <!-- 隱藏欄位 -->
                    <field name="active" invisible="1"/>
                    <field name="create_uid" invisible="1"/>
                    <field name="feedback" invisible="1"/>
                    <field name="is_transferred" invisible="1"/>
                    <field name="assignment_history_ids" invisible="1"/>
                    <field name="source_message_id" invisible="1"/>
                    <field name="user_id" invisible="1"/>
                    <!-- 欄位層級編輯權限（建立者 / 被指派者）-->
                    <field name="can_edit_as_creator" invisible="1"/>
                    <field name="can_edit_as_assignee" invisible="1"/>

                    <!-- 提示訊息：僅對自己建立的待辦顯示。「待辦總覽」會開到別人
                         建立的記錄，此時這句話是錯的 -->
                    <div class="alert alert-info" role="alert"
                         invisible="create_uid != uid">
                        <i class="fa fa-info-circle"/>
                        <span class="ms-1">You are the creator of this activity. Schedule operations (planned date, schedule status) can only be set by the assignee.</span>
                    </div>

                    <!-- 摘要 -->
                    <div class="oe_title">
                        <h1>
                            <field name="summary" placeholder="Enter activity summary..."/>
                        </h1>
                    </div>

                    <group>
                        <!-- 左側 -->
                        <group>
                            <field name="activity_type_id" string="Activity Type" options="{'no_create': True}"
                                   readonly="not can_edit_as_creator"/>
                            <field name="date_deadline" string="Due Date"
                                   readonly="not can_edit_as_creator"/>
                            <field name="estimated_hours" string="Estimated Hours" widget="float_time"
                                   readonly="not can_edit_as_assignee"/>
                            <field name="state" string="Status" widget="badge"
                                   decoration-info="state == 'planned'"
                                   decoration-warning="state == 'today'"
                                   decoration-danger="state == 'overdue'"/>
                        </group>

                        <!-- 右側 -->
                        <group>
                            <field name="urgency" string="Urgency" widget="radio" options="{'horizontal': true}"
                                   readonly="not can_edit_as_creator"/>
                            <field name="importance" string="Importance" widget="radio" options="{'horizontal': true}"
                                   readonly="not can_edit_as_creator"/>
                            <field name="user_id" string="Assign To" options="{'no_create': True}"
                                   readonly="id"/>
                            <field name="create_date" string="Created Date" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <!-- 左側：關聯資訊 -->
                        <group string="Related Information">
                            <field name="id" invisible="1"/>
                            <field name="res_model_id" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                            <!-- 未關聯 → 目標文件選取器；已關聯 → 相關文件唯讀標籤。互斥 -->
                            <field name="target_ref" string="Target Document"
                                   invisible="res_model_id and res_id"
                                   readonly="not (can_edit_as_creator or can_edit_as_assignee)"
                                   options="{'no_create': True}"/>
                            <field name="res_document_display" string="Related Document" readonly="1"
                                   invisible="not (res_model_id and res_id)"/>
                            <field name="partner_id" readonly="1"
                                   invisible="not partner_id"/>
                            <field name="note_id"
                                   readonly="not (can_edit_as_creator or can_edit_as_assignee)"
                                   options="{'no_create': True}"/>
                        </group>

                        <!-- 右側：排程資訊（被指派者可挑空值日期） -->
                        <group string="Schedule Info (Assignee Only)">
                            <field name="planned_date"
                                   readonly="planned_date or not can_edit_as_assignee"/>
                            <field name="schedule_status" readonly="1"/>
                            <field name="schedule_week" readonly="1"/>
                            <field name="schedule_origin" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Todo Note" name="note">
                            <field name="note" placeholder="Add note..."/>
                        </page>
                        <page string="Feedback" name="feedback" invisible="not feedback">
                            <field name="feedback" readonly="1"/>
                        </page>
                        <page string="Transfer Info" name="transfer" invisible="not is_transferred">
                            <group>
                                <field name="transferred_from_name" readonly="1"/>
                            </group>
                        </page>
                        <page string="Assignment History" name="assignment_history" invisible="not assignment_history_ids">
                            <field name="assignment_history_ids" readonly="1">
                                <list>
                                    <field name="changed_date"/>
                                    <field name="previous_user_id"/>
                                    <field name="new_user_id"/>
                                    <field name="changed_by"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Message Source" name="source_message" invisible="not source_message_id">
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <strong>This activity was created from a message</strong>
                                    <button name="action_open_source_message" type="object"
                                            class="btn btn-sm btn-primary ms-3">
                                        <i class="fa fa-external-link"/> View Original Message
                                    </button>
                                </div>
                            </group>
                            <group>
                                <field name="source_message_preview" readonly="1" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--              我建立的待辦 List View (無排程按鈕)                -->
    <!-- ============================================================ -->
    <record id="mail_activity_view_list_created" model="ir.ui.view">
        <field name="name">mail.activity.view.list.created</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <list
                  js_class="activity_list"
                  decoration-danger="active and date_deadline &lt; current_date"
                  decoration-warning="active and date_deadline == current_date"
                  decoration-muted="not active">
                <field name="active" column_invisible="1"/>
                <!-- 「待辦總覽」會列出別人建立的待辦 → 用來遮蔽改派／取消 -->
                <field name="can_edit_as_creator" column_invisible="1"/>
                <field name="can_edit_as_assignee" column_invisible="1"/>
                <field name="create_uid" string="Created By" widget="many2one_avatar_user" optional="show"/>
                <field name="summary"/>
                <field name="activity_type_id"/>
                <field name="user_id" string="Assign To" widget="many2one_avatar_user"
                       readonly="id"/>
                <field name="urgency" widget="badge"
                       decoration-danger="urgency == 'urgent'"
                       decoration-warning="urgency == 'standard'"
                       decoration-success="urgency == 'flexible'"/>
                <field name="importance"/>
                <field name="estimated_hours" widget="float_time"/>
                <field name="date_deadline"
                       readonly="id and create_uid != uid"/>
                <field name="planned_date" string="Planned Date (Set by Assignee)"
                       readonly="1"/>
                <field name="schedule_status" string="Schedule Status" widget="schedule_day"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'planned'"
                       decoration-warning="state == 'today'"
                       decoration-danger="state == 'overdue'"/>
                <field name="activity_status" string="Activity Status" widget="badge"
                       decoration-success="activity_status == 'done'"
                       decoration-danger="activity_status == 'cancelled'"/>
                <button name="action_reassign_activity" type="object"
                        string="Reassign" icon="fa-user-plus"
                        invisible="not active or not can_edit_as_creator"/>
                <button name="action_transfer_activity" type="object"
                        string="Transfer" icon="fa-exchange"
                        invisible="not active"/>
                <button name="action_cancel" type="object"
                        string="Cancel" icon="fa-times"
                        invisible="not active or not (can_edit_as_creator or can_edit_as_assignee)"/>
                <button name="action_restore" type="object"
                        string="Restore" icon="fa-undo" class="btn-secondary"
                        invisible="active or not can_edit_as_creator"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--              我建立的待辦 Kanban View (無排程操作)              -->
    <!-- ============================================================ -->
    <record id="mail_activity_view_kanban_created" model="ir.ui.view">
        <field name="name">mail.activity.view.kanban.created</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <kanban default_group_by="user_id" class="o_kanban_mobile">
                <field name="id"/>
                <field name="activity_type_id"/>
                <field name="res_document_display"/>
                <field name="summary"/>
                <field name="date_deadline"/>
                <field name="planned_date"/>
                <field name="schedule_status"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="urgency"/>
                <field name="importance"/>
                <field name="estimated_hours"/>
                <field name="active"/>
                <field name="activity_status"/>
                <!-- 「待辦總覽」會列出別人建立的待辦 → 用來遮蔽取消 -->
                <field name="can_edit_as_creator"/>
                <field name="can_edit_as_assignee"/>

                <templates>
                    <t t-name="card" class="flex-column">
                        <div t-attf-class="p-2
                            #{record.state.raw_value == 'overdue' ? 'bg-danger-subtle border-danger' :
                              record.urgency.raw_value == 'urgent' ? 'bg-warning-subtle border-warning' :
                              record.importance.raw_value == 'important' ? 'bg-info-subtle border-info' : ''}
                            #{!record.active.raw_value ? 'opacity-50' : ''}">

                            <!-- 第一列：摘要 -->
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings" style="flex: 1;">
                                    <strong style="white-space: normal; word-break: break-word;">
                                        <field name="summary" placeholder="No Summary"/>
                                    </strong>
                                </div>
                            </div>

                            <!-- 第二列：截止日期 + 標籤 -->
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span t-attf-class="badge #{record.state.raw_value == 'overdue' ? 'text-bg-danger' : record.state.raw_value == 'today' ? 'text-bg-warning' : 'text-bg-secondary'}"
                                      title="Due Date">
                                    <i class="fa fa-calendar-o"/> <field name="date_deadline"/>
                                </span>
                                <div class="d-flex align-items-center" style="gap: 4px;">
                                    <span t-if="record.urgency.raw_value == 'urgent'" class="badge text-bg-danger">
                                        <i class="fa fa-exclamation-circle"/> Urgent
                                    </span>
                                    <span class="badge rounded-pill text-bg-light">
                                        <field name="activity_type_id"/>
                                    </span>
                                </div>
                            </div>

                            <!-- 第三列：關聯文件 -->
                            <div class="text-muted small mb-1">
                                <a type="object" name="action_open_document" title="Open Document">
                                    <i class="fa fa-external-link"/> <field name="res_document_display"/>
                                </a>
                            </div>

                            <!-- 第四列：排程狀態（唯讀顯示） -->
                            <div class="small mb-1">
                                <span class="text-muted">Schedule:</span>
                                <span t-if="record.planned_date.raw_value" class="badge text-bg-info" title="Planned Date">
                                    <i class="fa fa-calendar-check-o"/> <field name="planned_date"/>
                                </span>
                                <span t-else="" class="badge text-bg-secondary" title="Pending Schedule">
                                    <i class="fa fa-clock-o"/> Pending Assignee Schedule
                                </span>
                            </div>

                            <!-- 第五列：工時 + 待辦狀態 + 被指派人 -->
                            <div class="o_kanban_record_bottom mt-1 pt-1 border-top">
                                <div class="oe_kanban_bottom_left d-flex align-items-center" style="gap: 4px;">
                                    <span t-if="record.estimated_hours.raw_value" class="text-muted small" title="Estimated Hours">
                                        <i class="fa fa-hourglass-half"/> <field name="estimated_hours" widget="float_time"/>
                                    </span>
                                    <!-- 待辦狀態 -->
                                    <span t-if="record.activity_status.raw_value == 'done'" class="badge text-bg-success">
                                        <i class="fa fa-check"/> Completed
                                    </span>
                                    <span t-if="record.activity_status.raw_value == 'cancelled'" class="badge text-bg-danger">
                                        <i class="fa fa-times"/> Cancelled
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right d-flex align-items-center">
                                    <t t-if="record.user_id.raw_value">
                                        <span class="text-muted small me-1">Assigned to:</span>
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </t>
                                    <t t-else="">
                                        <span class="badge text-bg-light text-muted">
                                            <i class="fa fa-user-o"/> Unassigned
                                        </span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>

                    <t t-name="menu">
                        <a role="menuitem" type="edit" class="dropdown-item">
                            <i class="fa fa-pencil fa-fw"/> Edit
                        </a>
                        <a role="menuitem" type="object" name="action_transfer_activity" class="dropdown-item">
                            <i class="fa fa-exchange fa-fw"/> Transfer
                        </a>
                        <div class="dropdown-divider"/>
                        <a t-if="record.active.raw_value and (record.can_edit_as_creator.raw_value or record.can_edit_as_assignee.raw_value)"
                           role="menuitem" type="object" name="action_cancel" class="dropdown-item text-danger">
                            <i class="fa fa-times fa-fw"/> Cancel
                        </a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                        Actions                               -->
    <!-- ============================================================ -->

    <!-- Action - 我的待辦事項（含歷史） -->
    <!--
        原本「進行中」與「歷史」分成兩個選單（action_mail_activity_my_history），
        使用者要查自己做過什麼得換地方。改成同一張清單用狀態篩選切換：

        active_test: False —— 解除 ORM 自動附加的 active=True。done/cancelled 的
        待辦 active=False，不解除的話 search view 的 Completed / Cancelled 篩選
        永遠回 0 筆（這正是當初必須另開歷史選單的原因）。

        search_default_active_activities —— 預設仍只看進行中，既有使用者行為不變；
        取消該 facet 或改勾 Completed / Cancelled 就看得到歷史。三者同組可 OR
        （見 mail_activity_view_search_inherit）。
    -->
    <record id="action_mail_activity_my_schedule" model="ir.actions.act_window">
        <field name="name">My Activities</field>
        <field name="res_model">mail.activity</field>
        <!-- 明確綁核心 search view（我們的 5 欄 search panel 即 inherit 它）;
             不綁的話會與報告獨立 search view 競爭「預設」→ list/kanban 抓到錯 panel -->
        <field name="search_view_id" ref="mail.mail_activity_view_search"/>
        <field name="view_mode">kanban,calendar,list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'force_search_count': 1,
                               'active_test': False,
                               'search_default_active_activities': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('mail_activity_view_kanban_schedule')}),
            (0, 0, {'view_mode': 'calendar', 'view_id': ref('mail_activity_view_calendar_schedule')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('mail_activity_view_list_schedule')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('mail_activity_view_form_schedule')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first activity</p>
            <p>Use Kanban view to plan your weekly work schedule.</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 尚未指派專用視圖                                              -->
    <!-- ============================================================ -->

    <!-- List View - 尚未指派 (只顯示領取按鈕) -->
    <record id="mail_activity_view_list_unassigned" model="ir.ui.view">
        <field name="name">mail.activity.list.unassigned</field>
        <field name="model">mail.activity</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list
                  js_class="activity_list"
                  default_order="date_deadline asc, urgency desc"
                  multi_edit="1"
                  expand="1"
                  decoration-danger="date_deadline &lt; current_date"
                  decoration-warning="date_deadline == current_date"
                  decoration-muted="not active">
                <!-- action 帶 active_test:False，取消 In Progress 篩選後會出現已取消的
                     未指派待辦 → 需要 active 供按鈕條件與整列淡化使用 -->
                <field name="active" column_invisible="1"/>
                <!-- 客戶已於左側 search panel 呈現，清單表頭預設不再顯示（可由欄位選單開啟）-->
                <field name="partner_id" optional="hide"/>
                <field name="res_document_display" string="Related Document" optional="show"/>
                <field name="summary" string="Summary"/>
                <field name="note_id" optional="show"/>
                <!-- 緊急/重要/排程 已於左側 search panel 篩選，清單表頭預設不再顯示（可由欄位選單開啟）-->
                <field name="urgency" string="Urgency" widget="badge" optional="hide"
                       decoration-danger="urgency == 'urgent'"
                       decoration-warning="urgency == 'standard'"
                       decoration-success="urgency == 'flexible'"/>
                <field name="importance" string="Importance" optional="hide"/>
                <field name="estimated_hours" string="Estimated Hours" widget="float_time" sum="Total"/>
                <field name="planned_date" string="Planned Date" optional="show"
                       readonly="1"/>
                <field name="date_deadline" string="Due Date" widget="remaining_days"
                       readonly="id and create_uid != uid"/>
                <field name="schedule_status" string="Schedule" widget="schedule_day" optional="hide"/>
                <field name="schedule_week" string="Week" optional="hide"/>
                <field name="state" string="Status" widget="badge"
                       decoration-info="state == 'planned'"
                       decoration-warning="state == 'today'"
                       decoration-danger="state == 'overdue'"/>
                <field name="activity_status" string="Activity Status" widget="badge" optional="hide"
                       decoration-success="activity_status == 'done'"
                       decoration-danger="activity_status == 'cancelled'"/>
                <field name="create_uid" string="Created By" widget="many2one_avatar_user"/>
                <!-- 已取消/已完成的待辦不可領取（表單版本已有相同條件；
                     action_claim_activity 後端只擋「已指派」，不擋已封存） -->
                <button name="action_claim_activity" type="object" string="Claim"
                        icon="fa-hand-paper-o" class="btn-primary"
                        invisible="not active"/>
            </list>
        </field>
    </record>

    <!-- Form View - 尚未指派 (不顯示完成按鈕) -->
    <record id="mail_activity_view_form_unassigned" model="ir.ui.view">
        <field name="name">mail.activity.view.form.unassigned</field>
        <field name="model">mail.activity</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Unassigned Activity">
                <header>
                    <!-- 操作按鈕置於 header 最左（與 statusbar 同排，Odoo 標準位置） -->
                    <button name="action_transfer_activity" type="object"
                            string="Transfer"/>
                    <button name="action_claim_activity" type="object"
                            string="Claim" class="btn-primary"
                            invisible="not active"/>
                    <button name="action_open_document" type="object"
                            string="Document"/>
                    <field name="schedule_status" widget="statusbar"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <!-- 隱藏欄位供條件判斷使用 -->
                    <field name="active" invisible="1"/>
                    <field name="planned_date" invisible="1"/>
                    <field name="feedback" invisible="1"/>
                    <field name="is_transferred" invisible="1"/>
                    <field name="assignment_history_ids" invisible="1"/>
                    <field name="postpone_history_ids" invisible="1"/>
                    <field name="schedule_warning" invisible="1"/>
                    <field name="user_id" invisible="1"/>
                    <field name="source_message_id" invisible="1"/>
                    <!-- 欄位層級編輯權限（建立者 / 被指派者）-->
                    <field name="can_edit_as_creator" invisible="1"/>
                    <field name="can_edit_as_assignee" invisible="1"/>

                    <!-- 摘要 - 置頂明顯 -->
                    <div class="oe_title">
                        <h1>
                            <field name="summary" placeholder="Enter activity summary..."/>
                        </h1>
                    </div>

                    <group>
                        <!-- 左側 -->
                        <group>
                            <field name="activity_type_id" string="Activity Type" options="{'no_create': True}"
                                   readonly="not can_edit_as_creator"/>
                            <field name="date_deadline" string="Due Date"
                                   readonly="not can_edit_as_creator"/>
                            <field name="estimated_hours" string="Estimated Hours" widget="float_time"
                                   readonly="not can_edit_as_assignee"/>
                            <field name="state" string="Status" widget="badge"
                                   decoration-info="state == 'planned'"
                                   decoration-warning="state == 'today'"
                                   decoration-danger="state == 'overdue'"/>
                        </group>

                        <!-- 右側 -->
                        <group>
                            <field name="urgency" string="Urgency" widget="radio" options="{'horizontal': true}"
                                   readonly="not can_edit_as_creator"/>
                            <field name="importance" string="Importance" widget="radio" options="{'horizontal': true}"
                                   readonly="not can_edit_as_creator"/>
                            <field name="create_uid" string="Created By" readonly="1"/>
                            <field name="create_date" string="Created Date" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <!-- 左側：關聯資訊 -->
                        <group string="Related Information">
                            <field name="id" invisible="1"/>
                            <field name="res_model_id" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                            <!-- 未關聯 → 目標文件選取器（新建必填）；已關聯 → 相關文件唯讀標籤。互斥 -->
                            <field name="target_ref" string="Target Document"
                                   invisible="res_model_id and res_id"
                                   readonly="not (can_edit_as_creator or can_edit_as_assignee)"
                                   required="not id and not (res_model_id and res_id)"
                                   options="{'no_create': True}"/>
                            <field name="res_document_display" string="Related Document" readonly="1"
                                   invisible="not (res_model_id and res_id)"/>
                            <field name="partner_id" readonly="1"
                                   invisible="not partner_id"/>
                            <field name="note_id"
                                   readonly="not (can_edit_as_creator or can_edit_as_assignee)"
                                   options="{'no_create': True}"/>
                        </group>

                        <!-- 右側：排程資訊 -->
                        <group string="Schedule Info">
                            <field name="planned_date" readonly="1"/>
                            <field name="schedule_week" readonly="1"/>
                            <field name="schedule_origin" readonly="1"/>
                            <field name="schedule_warning" invisible="not schedule_warning"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Todo Note" name="note">
                            <field name="note" placeholder="Add note..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action - 尚未指派 -->
    <!--
        「不分誰建立、不分是否過期，只要未指派就在這裡」：
        domain 只看 user_id，不看 create_uid，也不看任何日期。

        activity_default_week: 'all' —— 關鍵。控制面板的週次選擇器預設是「本週」
        （ActivityWeekSearchModel 會注入 `waiting OR week_number = 0`），而從其他文件
        Transfer 進來的未指派待辦可能已帶星期（schedule_status != 'waiting'）並落在
        上週，預設就會被藏起來，正好違反「過期的也要看得到」。改成預設「全部」，
        週次選擇器仍在，使用者要看單週隨時可切。

        active_test: False + search_default_active_activities —— 把「只看進行中」
        從 ORM 的隱式行為改成一個可取消的 facet：預設畫面與過去相同，但使用者可
        改勾 Completed / Cancelled 查已取消的未指派待辦（否則那兩個篩選永遠 0 筆）。
    -->
    <record id="action_mail_activity_unassigned" model="ir.actions.act_window">
        <field name="name">Unassigned</field>
        <field name="res_model">mail.activity</field>
        <field name="search_view_id" ref="mail.mail_activity_view_search"/>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('user_id', '=', False)]</field>
        <field name="context">{'force_search_count': 1,
                               'activity_default_week': 'all',
                               'active_test': False,
                               'search_default_active_activities': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('mail_activity_view_list_unassigned')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('mail_activity_view_kanban_schedule')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('mail_activity_view_form_unassigned')}),
        ]"/>
    </record>

    <!-- Action - 我的歷史代辦（我建立的 + 我被指派的） -->
    <!--
        已不再掛任何選單：歷史併入 action_mail_activity_my_schedule。
        record 保留是為了不讓既有的書籤／我的最愛連結變成「動作不存在」。
        要新增歷史入口請改用主選單 + Completed/Cancelled 篩選，不要再掛這個。
    -->
    <record id="action_mail_activity_my_history" model="ir.actions.act_window">
        <field name="name">My Activity History</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('create_uid', '=', uid), ('user_id', '=', uid), ('active', '=', False)]</field>
        <field name="context">{'force_search_count': 1, 'active_test': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('mail_activity_view_list_history')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('mail_activity_view_form_schedule')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No activity history</p>
            <p>Completed/cancelled activities you created or were assigned to will appear here.</p>
        </field>
    </record>

    <!-- Action - 所有歷史代辦（管理者專用） -->
    <record id="action_mail_activity_archived" model="ir.actions.act_window">
        <field name="name">All Activity History</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('active', '=', False)]</field>
        <field name="context">{'force_search_count': 1, 'active_test': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('mail_activity_view_list_history')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('mail_activity_view_form_schedule')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No activity history</p>
            <p>Completed or cancelled activities from all users will appear here.</p>
        </field>
    </record>

    <!-- Action - 所有代辦事項（管理者專用） -->
    <record id="action_mail_activity_all" model="ir.actions.act_window">
        <field name="name">All Activities</field>
        <field name="res_model">mail.activity</field>
        <field name="search_view_id" ref="mail.mail_activity_view_search"/>
        <field name="view_mode">kanban,calendar,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'force_search_count': 1, 'search_default_active_activities': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('mail_activity_view_kanban_schedule')}),
            (0, 0, {'view_mode': 'calendar', 'view_id': ref('mail_activity_view_calendar_schedule')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('mail_activity_view_list_schedule')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('mail_activity_view_form_schedule')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No activities currently</p>
            <p>This view shows all activities from all users, accessible by managers only.</p>
        </field>
    </record>

    <!-- Action - 待辦總覽（全部待辦，預設篩「我建立的」） -->
    <!--
        由「我建立的待辦」擴大為全部待辦：domain 放空，改用可取消的 facet
        search_default_created_by_me 呈現預設視角，使用者取消它即可看全公司待辦。

        可見範圍由 ir.rule 決定：security.xml 的 mail_activity_rule_user_read_all
        給全體內部使用者唯讀全部；沒有那條規則的話這裡的 domain=[] 只會落到
        「指派給我 ∪ 我建立 ∪ 未指派」。

        active_test:False —— 同「我的待辦」，讓 Completed / Cancelled 篩選有效。

        本 action 用的是「派工視角」三張視圖（Reassign / Cancel / 可改 Assign To），
        與 Management 下 action_mail_activity_all 的「執行視角」（Complete / Postpone
        / 行事曆）互補，兩者 domain 相同但操作面不同。
    -->
    <record id="action_mail_activity_created_by_me" model="ir.actions.act_window">
        <field name="name">All To-dos</field>
        <field name="res_model">mail.activity</field>
        <field name="search_view_id" ref="mail.mail_activity_view_search"/>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[]</field>
        <field name="context">{'force_search_count': 1,
                               'active_test': False,
                               'search_default_active_activities': 1,
                               'search_default_created_by_me': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('mail_activity_view_list_created')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('mail_activity_view_kanban_created')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('mail_activity_view_form_created')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No activities yet</p>
            <p>Shows every to-do. The default filter narrows it to the ones you created.</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--            改排週次（保持星期幾，整批搬到另一週）                 -->
    <!-- ============================================================ -->
    <!--
        接上 mail.activity.action_schedule_to_week_* 三個方法。

        用 ir.actions.server + binding 而非在清單/看板加按鈕：
          - 清單與看板的操作列已各有 5 顆與 3 顆按鈕，再加三顆會過度擁擠；
          - binding 讓它們出現在 ⚙️ 動作選單，且**多選時自動變成批次操作**
            （code 內的 records 就是選取集合，action_schedule_to_week 本身
             以 `for activity in self` 迴圈實作，本來就支援多筆）；
          - 純 XML，不需要再寫前端程式碼。

        與「延期」的語意差別（兩者並存、不重複）：
          延期  → 移到「待排程」，清空計畫日期，需填原因並留下延期歷史；
          改排週次 → 保持原星期幾直接搬到目標週，不留歷史、不需原因。
    -->
    <record id="action_schedule_activities_to_week_prev" model="ir.actions.server">
        <field name="name">Move to Previous Week</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="binding_model_id" ref="mail.model_mail_activity"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = records.action_schedule_to_week_prev()</field>
    </record>

    <record id="action_schedule_activities_to_week0" model="ir.actions.server">
        <field name="name">Move to This Week</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="binding_model_id" ref="mail.model_mail_activity"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = records.action_schedule_to_week0()</field>
    </record>

    <record id="action_schedule_activities_to_week1" model="ir.actions.server">
        <field name="name">Move to Next Week</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="binding_model_id" ref="mail.model_mail_activity"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = records.action_schedule_to_week1()</field>
    </record>

</odoo>
