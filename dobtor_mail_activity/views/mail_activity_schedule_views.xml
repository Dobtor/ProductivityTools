<odoo>
    <!-- ============================================================ -->
    <!-- NOTE: mail_activity_view_form_schedule is defined in         -->
    <!-- mail_activity_views.xml with the 4-column layout             -->
    <!-- ============================================================ -->

    <!-- ============================================================ -->
    <!-- NOTE: mail_activity_view_kanban_schedule is defined in       -->
    <!-- mail_activity_views.xml with updated layout                  -->
    <!-- ============================================================ -->

    <!-- ============================================================ -->
    <!-- NOTE: mail_activity_view_list_schedule is defined in         -->
    <!-- mail_activity_views.xml with updated layout                  -->
