    <!-- ============================================================ -->
    <!--              待辦事項 Search View 擴展                         -->
    <!-- ============================================================ -->
    <record id="mail_activity_view_search_inherit" model="ir.ui.view">
        <field name="name">mail.activity.view.search.inherit</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_search"/>
        <field name="arch" type="xml">
            <!--
                分組規則提醒：同一 <separator/> 區間內的 filter 之間是 OR，
                跨 separator 是 AND。以下所有插入點都是刻意挑的，改動前請先確認
                新位置落在哪個區間。

                另：核心 mail.mail_activity_view_search 是 mail.activity 唯一的
                search view，本繼承同時作用於系統列的 mail.mail_activity_action_my
                （它以 search_default_ 引用 filter_user_id_uid /
                filter_date_deadline_past / filter_date_deadline_today），
                因此那三個 core filter 一律保持原樣不得移除。
            -->

            <!-- 1. 指派：與 core 的「My Activities」同組（中間無 separator → OR），
                    使用者可一次看「指派給我 ＋ 我建立的」。
                    原 assigned_to_me 已移除：它與 core 的 filter_user_id_uid 重複，
                    且多了 ('create_uid','!=',uid) 會漏掉「自己建立給自己」的待辦。
                    原 all_activities（domain=[]）也移除：勾了等於沒勾，卻會讓同組
                    其他條件 OR 成恆真，使用者容易誤解。 -->
            <xpath expr="//filter[@name='filter_user_id_uid']" position="after">
                <filter string="Created by Me" name="created_by_me"
                        domain="[('create_uid', '=', uid)]"/>
            </xpath>

            <!-- 2. 時間：併進 core 的日期區（Overdue / Today / Future 同組 → OR）。
                    模組原本自帶的 overdue / due_today 與 core 完全重複，已移除。 -->
            <xpath expr="//filter[@name='filter_date_deadline_future']" position="after">
                <filter string="Next 7 Days" name="due_next_week"
                        domain="[('date_deadline', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('date_deadline', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
            </xpath>

            <!-- 3. 狀態三態取代 core 的「Done」(active=False)。
                    三者同組互斥值 → 可 OR，「進行中 ＋ 已完成」一起看才成立
                    （舊版 In Progress 與 Completed 被 separator 隔開＝AND＝空集合）。
                    name="active_activities" 必須保留：四個 action 以
                    search_default_active_activities 引用它。
                    這些 action 都帶 active_test:False（否則 done/cancelled 記錄的
                    active=False 會被 ORM 擋掉，Completed/Cancelled/Merged 三個
                    篩選會永遠回 0 筆）。 -->
            <xpath expr="//filter[@name='filter_archived']" position="replace">
                <filter string="In Progress" name="active_activities"
                        domain="[('activity_status', '=', 'active')]"/>
                <filter string="Completed" name="completed"
                        domain="[('activity_status', '=', 'done')]"/>
                <filter string="Cancelled" name="cancelled"
                        domain="[('activity_status', '=', 'cancelled')]"/>
                <filter string="Merged" name="merged"
                        domain="[('activity_status', '=', 'merged')]"/>
                <!-- 以下三區一併在這裡插入，而不是另外 xpath 到 Group By 群組之前：
                     Odoo 禁止用 @string 當繼承選擇器（string 可翻譯，
                     ir_ui_view._valid_inheritance / TRANSLATED_ATTRS），
                     而 core 的那個 <group> 沒有 name 可錨。被取代的
                     filter_archived 後方本來就有 core 的 <separator/> 接著
                     Group By 群組，所以直接接在這裡，版面完全相同。 -->
                <separator/>
                <filter string="Transferred" name="transferred"
                        domain="[('is_transferred', '=', True)]"/>
                <separator/>
                <!-- 優先級（同組 → 「緊急或重要」） -->
                <filter string="Urgent" name="urgent"
                        domain="[('urgency', '=', 'urgent')]"/>
                <filter string="Important" name="important"
                        domain="[('importance', '=', 'important')]"/>
                <separator/>
                <filter string="Waiting Schedule" name="waiting_schedule"
                        domain="[('schedule_status', '=', 'waiting')]"/>
            </xpath>

            <!-- 5. 分組：併進 core 的 Group By（原本另開一組，UI 會出現兩段）。
                    已移除與 core 重複的 By Assignee（core: group_by_user_id）
                    與 By Due Date（core: date_deadline，且 core 版帶日期區間子選單）。 -->
            <xpath expr="//filter[@name='activittype']" position="after">
                <filter string="By Week" name="group_by_schedule_week"
                        context="{'group_by': 'schedule_week'}"/>
                <filter string="By Activity Status" name="group_by_activity_status"
                        context="{'group_by': 'activity_status'}"/>
                <filter string="By Schedule Status" name="group_by_schedule_status"
                        context="{'group_by': 'schedule_status'}"/>
                <filter string="By Urgency" name="group_by_urgency"
                        context="{'group_by': 'urgency'}"/>
                <filter string="By Importance" name="group_by_importance"
                        context="{'group_by': 'importance'}"/>
                <filter string="By Customer" name="group_by_partner"
                        context="{'group_by': 'partner_id'}"/>
                <filter string="By Planned Date" name="group_by_planned_date"
                        context="{'group_by': 'planned_date:day'}"/>
            </xpath>

            <!-- 6. 左側 search panel：客戶 / 緊急程度 / 重要性 / 排程 / 負責人。
                    不設 view_types → 清單與看板皆顯示；fold="1" → 預設收闔。
                    五個欄位皆 stored 可供 read_group 計數。 -->
            <xpath expr="//search" position="inside">
                <searchpanel fold="1">
                    <field name="partner_id" string="Customer" select="one"
                           icon="fa-building" hierarchize="0" enable_counters="1"/>
                    <field name="urgency" string="Urgency" select="multi"
                           icon="fa-exclamation-circle" enable_counters="1"/>
                    <field name="importance" string="Importance" select="multi"
                           icon="fa-star" enable_counters="1"/>
                    <field name="schedule_week" string="Schedule" select="multi"
                           icon="fa-calendar-o" enable_counters="1"/>
                    <field name="user_id" string="Assignee" select="multi"
                           icon="fa-user" enable_counters="1"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

