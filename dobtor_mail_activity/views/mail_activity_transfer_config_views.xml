<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                轉移配置 List View                             -->
    <!-- ============================================================ -->
    <record id="mail_activity_transfer_config_view_list" model="ir.ui.view">
        <field name="name">mail.activity.transfer.config.list</field>
        <field name="model">mail.activity.transfer.config</field>
        <field name="arch" type="xml">
            <list string="Transfer Config" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="model_id" options="{'no_create': True}"/>
                <field name="partner_field" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                轉移配置 Form View                             -->
    <!-- ============================================================ -->
    <record id="mail_activity_transfer_config_view_form" model="ir.ui.view">
        <field name="name">mail.activity.transfer.config.form</field>
        <field name="model">mail.activity.transfer.config</field>
        <field name="arch" type="xml">
            <form string="Transfer Config">
                <sheet>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="partner_field"
                                   placeholder="partner_id (auto-detect if empty)"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                轉移配置 Action                                -->
    <!-- ============================================================ -->
    <record id="action_mail_activity_transfer_config" model="ir.actions.act_window">
        <field name="name">Activity Transfer Config</field>
        <field name="res_model">mail.activity.transfer.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add allowed transfer target models
            </p>
            <p>
                Configure which models can be used as activity transfer targets.
                If no models are configured, all models supporting mail thread will be allowed.
            </p>
        </field>
    </record>

</odoo>
