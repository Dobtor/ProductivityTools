<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                轉移配置 List View                             -->
    <!-- ============================================================ -->
    <record id="mail_activity_transfer_config_view_list" model="ir.ui.view">
        <field name="name">mail.activity.transfer.config.list</field>
        <field name="model">mail.activity.transfer.config</field>
        <field name="arch" type="xml">
            <list string="轉移配置" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="model_id" options="{'no_create': True}"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                轉移配置 Form View                             -->
    <!-- ============================================================ -->
    <record id="mail_activity_transfer_config_view_form" model="ir.ui.view">
        <field name="name">mail.activity.transfer.config.form</field>
        <field name="model">mail.activity.transfer.config</field>
        <field name="arch" type="xml">
            <form string="轉移配置">
                <sheet>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                轉移配置 Action                                -->
    <!-- ============================================================ -->
    <record id="action_mail_activity_transfer_config" model="ir.actions.act_window">
        <field name="name">待辦轉移配置</field>
        <field name="res_model">mail.activity.transfer.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                新增允許的轉移目標模型
            </p>
            <p>
                配置哪些模型可以作為待辦轉移的目標。
                如果沒有配置任何模型，將允許所有支援 mail thread 的模型。
            </p>
        </field>
    </record>

</odoo>
