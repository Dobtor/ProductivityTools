<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================
         統一「建立待辦」Wizard (mail.activity.create.wizard)
         繼承官方 mail.activity.schedule，所有建立待辦入口共用此畫面。
         分區群組・單頁版面，避免欄位擠在一起。
         ===================================================== -->

    <record id="mail_activity_create_wizard_view_form" model="ir.ui.view">
        <field name="name">mail.activity.create.wizard.form</field>
        <field name="model">mail.activity.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create To-do">
                <!-- 隱藏：情境/關聯判斷 -->
                <field name="res_known" invisible="1"/>
                <field name="res_model" invisible="1"/>
                <field name="res_ids" invisible="1"/>
                <field name="target_required" invisible="1"/>
                <field name="source_message_id" invisible="1"/>

                <!-- 摘要 -->
                <div class="oe_title">
                    <h1>
                        <field name="summary" placeholder="Enter activity summary..."/>
                    </h1>
                </div>

                <group>
                    <!-- 左側 -->
                    <group string="Activity Information">
                        <field name="activity_type_id" string="Activity Type"
                               options="{'no_create': True}" required="1"/>
                        <field name="date_deadline" string="Due Date" required="1"/>
                        <field name="estimated_hours" string="Estimated Hours"
                               widget="float_time"/>
                    </group>

                    <!-- 右側 -->
                    <group string="Priority &amp; Assignment">
                        <field name="urgency" string="Urgency" widget="radio"
                               options="{'horizontal': true}"/>
                        <field name="importance" string="Importance" widget="radio"
                               options="{'horizontal': true}"/>
                        <field name="activity_user_id" string="Assign To"
                               widget="many2one_avatar_user"
                               options="{'no_create': True}"/>
                    </group>
                </group>

                <!-- 隱藏：關聯圖所需 res 欄位（widget 回填 / target_ref 同步）-->
                <field name="res_model_id" invisible="1"/>
                <field name="res_id" invisible="1"/>

                <!-- 關聯資訊：攤平成 col=4，客戶+專案同一列（並排）；其餘欄位 colspan=3
                     佔整列。移除多餘 string 覆寫→用已翻譯欄位標籤（客戶/專案）。 -->
                <group string="Related Information" col="4">
                    <field name="partner_id" options="{'no_create': True}"/>
                    <field name="project_id" options="{'no_create': True}"/>
                    <!-- res 已知 → 唯讀顯示；未知 → 可輸入 target（互斥，各佔整列）-->
                    <field name="res_display" string="Target Document"
                           readonly="1" invisible="not res_known" colspan="3"/>
                    <field name="target_ref" string="Target Document"
                           options="{'no_create': True}" invisible="res_known"
                           required="target_required and not res_known" colspan="3"/>
                    <field name="note_id" string="Source Reference"
                           options="{'no_create': True}" colspan="3"/>
                </group>

                <!-- 關聯邏輯圖：以 客戶/專案 為根，點節點選 related document
                     （目標未固定時才顯示）-->
                <group string="Related Document — Relation Diagram"
                       invisible="res_known">
                    <field name="relation_diagram_anchor"
                           widget="activity_relation_diagram" nolabel="1" colspan="2"/>
                </group>

                <notebook>
                    <page string="Todo Note" name="note">
                        <field name="note" placeholder="Activity note (optional)..."/>
                    </page>
                </notebook>

                <footer>
                    <button string="Create To-do" name="action_create_todo"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mail_activity_create_wizard" model="ir.actions.act_window">
        <field name="name">Create To-do</field>
        <field name="res_model">mail.activity.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
