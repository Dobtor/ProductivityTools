<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--       專案表單擴展 - CRM 商機 Smart Button                     -->
    <!--       （原 dobtor_mail_activity_timesheet 併入）                -->
    <!-- ============================================================ -->
    <record id="project_project_view_form_inherit_productivity" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.productivity</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_leads" type="object"
                        class="oe_stat_button" icon="fa-handshake-o"
                        invisible="lead_count == 0">
                    <field name="lead_count" widget="statinfo" string="Leads"/>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
