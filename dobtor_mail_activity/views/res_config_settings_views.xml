<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--             系統設定擴展 - 生產力工具設定                        -->
    <!-- ============================================================ -->
    <record id="res_config_settings_view_form_inherit_productivity" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.productivity</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Productivity Tools" string="Productivity Tools" name="dobtor_mail_activity" groups="dobtor_mail_activity.group_activity_manager">
                    <block title="Timesheet Settings" name="timesheet_settings">
                        <setting id="default_timesheet_project_setting"
                                 string="Default Timesheet Project"
                                 help="When an activity is completed without a linked project, use this default project to create timesheet entries.">
                            <field name="timesheet_project_id"
                                   domain="[('allow_timesheets', '=', True), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                        </setting>
                    </block>

                    <block title="Transcription Settings" name="transcription_settings">
                        <setting id="transcription_provider_setting"
                                 string="Transcription Provider"
                                 help="Choose how to process speech-to-text with speaker diarization.">
                            <field name="transcription_provider"/>
                        </setting>
                        <setting id="transcription_api_key_setting"
                                 string="API Key"
                                 help="API key for AssemblyAI or OpenAI."
                                 invisible="transcription_provider not in ('assemblyai', 'api')">
                            <field name="transcription_api_key" password="True"/>
                            <div class="text-muted mt-1"
                                 invisible="transcription_provider != 'assemblyai'">
                                Get your API key at <a href="https://www.assemblyai.com/" target="_blank">assemblyai.com</a>
                            </div>
                        </setting>
                        <setting id="transcription_service_url_setting"
                                 string="Service URL"
                                 help="URL of the whisperX transcription service."
                                 invisible="transcription_provider != 'remote'">
                            <field name="transcription_service_url"
                                   placeholder="http://gpu-server:8765"/>
                        </setting>
                        <setting id="transcription_model_size_setting"
                                 string="Model Size"
                                 help="Whisper model size (only for Remote whisperX mode)."
                                 invisible="transcription_provider != 'remote'">
                            <field name="transcription_model_size"/>
                        </setting>
                        <setting id="transcription_language_setting"
                                 string="Language"
                                 help="Language code for speech recognition.">
                            <field name="transcription_language" placeholder="zh"/>
                        </setting>
                    </block>

                    <block title="Summary Settings" name="summary_settings">
                        <setting id="summary_provider_setting"
                                 string="Summary Provider"
                                 help="Choose which LLM to use for generating meeting summaries.">
                            <field name="summary_provider"/>
                        </setting>
                        <setting id="summary_api_key_setting"
                                 string="Summary API Key"
                                 help="API key for Claude or OpenAI."
                                 invisible="summary_provider not in ('claude', 'openai')">
                            <field name="summary_api_key" password="True"/>
                        </setting>
                        <setting id="summary_api_url_setting"
                                 string="Ollama URL"
                                 help="URL of the Ollama server."
                                 invisible="summary_provider != 'ollama'">
                            <field name="summary_api_url"
                                   placeholder="http://localhost:11434"/>
                        </setting>
                        <setting id="summary_model_name_setting"
                                 string="Ollama Model"
                                 help="Model name for Ollama."
                                 invisible="summary_provider != 'ollama'">
                            <field name="summary_model_name" placeholder="llama3"/>
                        </setting>
                        <setting id="summary_prompt_preset_setting"
                                 string="Prompt Preset"
                                 help="Select a predefined prompt template for meeting summaries.">
                            <field name="summary_prompt_preset"/>
                        </setting>
                        <setting id="summary_prompt_template_setting"
                                 string="Custom Prompt Override"
                                 help="Custom prompt (overrides preset). Use {transcript} as placeholder. Leave empty to use preset.">
                            <field name="summary_prompt_template"
                                   placeholder="Leave empty to use the preset above."/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
