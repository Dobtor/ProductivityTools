<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 「待辦事項」App（本模組自有；不相依 project_todo）               -->
    <!-- 主選單點擊直接開啟「我的待辦事項」(action_mail_activity_my_schedule) -->
    <!-- 裝了專案時，dobtor_mail_activity_project 會隱藏 project_todo 的    -->
    <!-- 同名 App，避免出現兩個「待辦事項」。                             -->
    <!-- ============================================================ -->
    <menuitem id="menu_todo_root"
              name="To-dos"
              web_icon="dobtor_mail_activity,static/description/todo_icon.png"
              action="action_mail_activity_my_schedule"
              sequence="24"/>

    <!-- ============================================================ -->
    <!-- 筆記本（第一層選單）                                            -->
    <!-- ============================================================ -->
    <menuitem id="menu_notebook_root"
              name="Personal Notes"
              web_icon="dobtor_mail_activity,static/description/icon.png"
              action="action_note_only"
              sequence="25"/>

    <menuitem id="menu_note_notes"
              name="All Notes"
              parent="menu_notebook_root"
              action="action_note_note"
              sequence="10"/>

    <!-- 筆記設定 -->
    <menuitem id="menu_notebook_configuration"
              name="Settings"
              parent="menu_notebook_root"
              sequence="90"
              groups="dobtor_mail_activity.group_activity_manager"/>

    <menuitem id="menu_note_stage"
              name="Note Stages"
              parent="menu_notebook_configuration"
              action="action_note_stage"
              sequence="10"/>

    <menuitem id="menu_note_tag"
              name="Note Tags"
              parent="menu_notebook_configuration"
              action="action_note_tag"
              sequence="20"/>

    <!-- ============================================================ -->
    <!-- 待認領的待辦 - 所有人可見                                       -->
    <!-- ============================================================ -->
    <menuitem id="menu_mail_activity_unassigned"
              name="Unassigned"
              parent="menu_todo_root"
              action="action_mail_activity_unassigned"
              sequence="15"/>

    <!-- ============================================================ -->
    <!-- 待辦總覽：全部待辦，預設篩「我建立的」                            -->
    <!-- ============================================================ -->
    <menuitem id="menu_mail_activity_created_by_me"
              name="All To-dos"
              parent="menu_todo_root"
              action="action_mail_activity_created_by_me"
              sequence="18"/>

    <!-- ============================================================ -->
    <!-- 「我完成的待辦」選單已移除：歷史併入主選單的「我的待辦事項」       -->
    <!-- （action_mail_activity_my_schedule 帶 active_test:False，        -->
    <!--  用 In Progress / Completed / Cancelled 篩選切換）               -->
    <!-- ============================================================ -->
    <!-- 我的週報                                                       -->
    <!-- ============================================================ -->
    <menuitem id="menu_weekly_report_my"
              name="My Reports"
              parent="menu_todo_root"
              action="action_weekly_report"
              sequence="12"
              groups="dobtor_mail_activity.group_weekly_report"/>

    <!-- ============================================================ -->
    <!-- 效率分析選單（僅保留一般用戶項目）                               -->
    <!-- ============================================================ -->
    <menuitem id="menu_efficiency_root"
              name="Efficiency Analysis"
              parent="menu_todo_root"
              sequence="40"/>

    <menuitem id="menu_efficiency_personal"
              name="Personal Dashboard"
              parent="menu_efficiency_root"
              action="action_efficiency_personal"
              sequence="10"/>

    <menuitem id="menu_efficiency_trend"
              name="Trend Report"
              parent="menu_efficiency_root"
              action="action_efficiency_trend"
              sequence="20"/>

    <!-- ============================================================ -->
    <!-- 管理（管理者專用）                                              -->
    <!-- ============================================================ -->
    <menuitem id="menu_management"
              name="Management"
              parent="menu_todo_root"
              sequence="90"
              groups="dobtor_mail_activity.group_activity_manager"/>

    <!-- 所有週報（父選單 menu_management 已限管理者；本項再受「啟用週報管理」開關控制） -->
    <menuitem id="menu_weekly_report_all"
              name="All Weekly Reports"
              parent="menu_management"
              action="action_weekly_report_all"
              sequence="5"
              groups="dobtor_mail_activity.group_weekly_report"/>

    <!-- 團隊分析 -->
    <menuitem id="menu_efficiency_team"
              name="Team Analysis"
              parent="menu_management"
              action="action_efficiency_team"
              sequence="10"
              groups="dobtor_mail_activity.group_activity_manager"/>

    <!-- 所有效率指標 -->
    <menuitem id="menu_efficiency_all"
              name="All Efficiency Metrics"
              parent="menu_management"
              action="action_efficiency_all"
              sequence="20"
              groups="dobtor_mail_activity.group_activity_manager"/>

    <!-- 所有進行中待辦 -->
    <menuitem id="menu_mail_activity_all"
              name="All Activities"
              parent="menu_management"
              action="action_mail_activity_all"
              sequence="30"
              groups="dobtor_mail_activity.group_activity_manager"/>

    <!-- 所有已完成待辦 -->
    <menuitem id="menu_mail_activity_archived"
              name="All Activity History"
              parent="menu_management"
              action="action_mail_activity_archived"
              sequence="40"
              groups="dobtor_mail_activity.group_activity_manager"/>

    <!-- ============================================================ -->
    <!-- 設定選單                                                       -->
    <!-- ============================================================ -->
    <menuitem id="menu_configuration"
              name="Settings"
              parent="menu_todo_root"
              sequence="100"
              groups="dobtor_mail_activity.group_activity_manager"/>

    <!-- 待辦轉移配置 -->
    <menuitem id="menu_mail_activity_transfer_config"
              name="Activity Transfer Config"
              parent="menu_configuration"
              action="action_mail_activity_transfer_config"
              sequence="30"/>

    <!-- 週報排程配置（受「啟用週報管理」開關控制） -->
    <menuitem id="menu_weekly_schedule_config"
              name="Weekly Schedule Config"
              parent="menu_configuration"
              action="action_weekly_schedule_config"
              sequence="40"
              groups="dobtor_mail_activity.group_weekly_report"/>

</odoo>
